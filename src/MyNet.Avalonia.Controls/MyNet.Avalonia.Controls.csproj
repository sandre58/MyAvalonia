<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Product>My .NET Avalonia - Controls</Product>
        <PackageIcon>MyAvaloniaControls.png</PackageIcon>
        <NeutralLanguage>fr</NeutralLanguage>
        <Description>Advanced controls and UI components for Avalonia applications: color pickers, data grids, custom cursors, and integration with MyNet libraries.</Description>
        <PackageTags>Avalonia;UI;Controls;ColorPicker;DataGrid;MyNet;Extensions;CrossPlatform;Desktop</PackageTags>
    </PropertyGroup>

    <PropertyGroup>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Cursors\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Controls.ColorPicker" />
        <PackageReference Include="Avalonia.Controls.DataGrid" />
        <PackageReference Include="Avalonia.Controls.ItemsRepeater" />
        <PackageReference Include="Avalonia.Xaml.Behaviors" />
        <PackageReference Include="Material.Icons" />
        <PackageReference Include="MyNet.Collections" />
        <PackageReference Include="MyNet.Globalization" />
        <PackageReference Include="MyNet.Primitives" />
    </ItemGroup>
    
    <ItemGroup>
        <ProjectReference Include="..\MyNet.Avalonia\MyNet.Avalonia.csproj" />
    </ItemGroup>
    
    <ItemGroup>
      <Compile Update="Localization\RatingResources.Designer.cs">
        <DependentUpon>RatingResources.resx</DependentUpon>
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
      </Compile>
      <Compile Update="Localization\TimeRangePickerExResources.Designer.cs">
        <DependentUpon>TimeRangePickerExResources.resx</DependentUpon>
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
      </Compile>
      <Compile Update="Localization\ColorPickerResources.Designer.cs">
        <DependentUpon>ColorPickerResources.resx</DependentUpon>
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
      </Compile>
      <Compile Update="Localization\ItemsSearchResources.Designer.cs">
        <DependentUpon>ItemsSearchResources.resx</DependentUpon>
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
      </Compile>
      <Compile Update="Localization\MessagesResources.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>MessagesResources.resx</DependentUpon>
      </Compile>
    </ItemGroup>
    
    <ItemGroup>
      <EmbeddedResource Update="Localization\RatingResources.resx">
        <LastGenOutput>RatingResources.Designer.cs</LastGenOutput>
        <Generator>PublicResXFileCodeGenerator</Generator>
      </EmbeddedResource>
      <EmbeddedResource Update="Localization\TimeRangePickerExResources.resx">
        <LastGenOutput>TimeRangePickerExResources.Designer.cs</LastGenOutput>
        <Generator>PublicResXFileCodeGenerator</Generator>
      </EmbeddedResource>
      <EmbeddedResource Update="Localization\ColorPickerResources.resx">
        <LastGenOutput>ColorPickerResources.Designer.cs</LastGenOutput>
        <Generator>ResXFileCodeGenerator</Generator>
      </EmbeddedResource>
      <EmbeddedResource Update="Localization\ItemsSearchResources.resx">
        <LastGenOutput>ItemsSearchResources.Designer.cs</LastGenOutput>
        <Generator>ResXFileCodeGenerator</Generator>
      </EmbeddedResource>
      <EmbeddedResource Update="Localization\MessagesResources.resx">
        <Generator>ResXFileCodeGenerator</Generator>
        <LastGenOutput>MessagesResources.Designer.cs</LastGenOutput>
      </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="MyNet.Avalonia.Controls.Tests" />
        <InternalsVisibleTo Include="MyNet.Avalonia.Controls.Headless.Tests" />
    </ItemGroup>

</Project>
