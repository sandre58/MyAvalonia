<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Product>My .NET Avalonia - Geography</Product>
        <PackageIcon>MyAvaloniaGeography.png</PackageIcon>
        <Description>Avalonia markup and helpers for MyNet.Geography (country lists, culture/country templates, CulturePicker).</Description>
        <PackageTags>Avalonia;UI;Geography;Countries;Culture;MyNet;Extensions;CrossPlatform;Desktop</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MyNet.Humanizer" />
        <PackageReference Include="MyNet.Geography" />
        <PackageReference Include="MyNet.Geography.Localization" />
        <PackageReference Include="MyNet.Geography.Resources" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseLocalMyNetProjects)' == 'true' and Exists('..\..\..\MyNet\src\MyNet.Humanizer\MyNet.Humanizer.csproj')">
        <ProjectReference Include="..\..\..\MyNet\src\MyNet.Humanizer\MyNet.Humanizer.csproj" />
        <PackageReference Remove="MyNet.Humanizer" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseLocalMyNetProjects)' == 'true' and Exists('..\..\..\MyNet\src\MyNet.Geography\MyNet.Geography.csproj')">
        <ProjectReference Include="..\..\..\MyNet\src\MyNet.Geography\MyNet.Geography.csproj" />
        <PackageReference Remove="MyNet.Geography" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseLocalMyNetProjects)' == 'true' and Exists('..\..\..\MyNet\src\MyNet.Geography.Localization\MyNet.Geography.Localization.csproj')">
        <ProjectReference Include="..\..\..\MyNet\src\MyNet.Geography.Localization\MyNet.Geography.Localization.csproj" />
        <PackageReference Remove="MyNet.Geography.Localization" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseLocalMyNetProjects)' == 'true' and Exists('..\..\..\MyNet\src\MyNet.Geography.Resources\MyNet.Geography.Resources.csproj')">
        <ProjectReference Include="..\..\..\MyNet\src\MyNet.Geography.Resources\MyNet.Geography.Resources.csproj" />
        <PackageReference Remove="MyNet.Geography.Resources" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MyNet.Avalonia.Controls\MyNet.Avalonia.Controls.csproj" />
        <ProjectReference Include="..\MyNet.Avalonia\MyNet.Avalonia.csproj" />
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="**/*.axaml" />
    </ItemGroup>

</Project>
