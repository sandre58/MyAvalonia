<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Product>My .NET Avalonia - Geography</Product>
        <PackageIcon>MyAvalonia.png</PackageIcon>
        <Description>Avalonia markup and helpers for MyNet.Geography (country lists, culture/country templates, CulturePicker).</Description>
        <PackageTags>Avalonia;UI;Geography;Countries;Culture;MyNet;Extensions;CrossPlatform;Desktop</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MyNet.Humanizer" />
        <PackageReference Include="MyNet.Geography" />
        <PackageReference Include="MyNet.Geography.Localization" />
        <PackageReference Include="MyNet.Geography.Resources" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MyNet.Avalonia.Controls\MyNet.Avalonia.Controls.csproj" />
        <ProjectReference Include="..\MyNet.Avalonia\MyNet.Avalonia.csproj" />
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="**/*.axaml" />
    </ItemGroup>

</Project>
