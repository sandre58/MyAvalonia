<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Controls -->
                <ResourceInclude Source="avares://MyNet.Avalonia.Geography/Themes/Controls/CulturePicker.axaml" />
                
                <!-- DataTemplates -->
                <ResourceInclude Source="avares://MyNet.Avalonia.Geography/Themes/DataTemplates/Country.axaml" />
                <ResourceInclude Source="avares://MyNet.Avalonia.Geography/Themes/DataTemplates/CultureInfo.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
