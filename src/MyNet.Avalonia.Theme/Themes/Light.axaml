<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">

    <!-- Application -->
    <Color x:Key="MyNet.Color.Application.Background">#EBEBEB</Color>
    <Color x:Key="MyNet.Color.Application.Foreground">#242424</Color>

    <!-- Surfaces -->
    <Color x:Key="MyNet.Color.Surface.Background">#F6F6F6</Color>
    <Color x:Key="MyNet.Color.Surface.Background.Dark">#CACACA</Color>
    <Color x:Key="MyNet.Color.Surface.Border">#DADADA</Color>

    <!-- Overlay -->
    <Color x:Key="MyNet.Color.Overlay.Background">#22000000</Color>

    <!-- Dialog -->
    <Color x:Key="MyNet.Color.Dialog.Background">#f6f6f6</Color>

    <!-- Popup -->
    <Color x:Key="MyNet.Color.Popup.Background">#FAFAFA</Color>
    <Color x:Key="MyNet.Color.Popup.Border">Transparent</Color>
    <Color x:Key="MyNet.Color.Popup.Foreground">#242424</Color>

    <!-- ToolTip -->
    <Color x:Key="MyNet.Color.ToolTip.Background">#41464C</Color>
    <Color x:Key="MyNet.Color.ToolTip.Border">Transparent</Color>

    <!-- Controls -->
    <Color x:Key="MyNet.Color.Control.Background">#E0E0E0</Color>
    <Color x:Key="MyNet.Color.Control.Background.Light">#E2E2E2</Color>
    <Color x:Key="MyNet.Color.Control.Border">#C5C5C5</Color>
    <Color x:Key="MyNet.Color.Control.Border.Hover">#999999</Color>
    <Color x:Key="MyNet.Color.Control.Border.Focus">#646464</Color>

    <!-- Specifics -->
    <Color x:Key="MyNet.Color.Button.Close.Hover">#D52515</Color>

    <!-- Validation -->
    <Color x:Key="MyNet.Color.Validation.Error">#A1260D</Color>

    <!-- States -->
    <Color x:Key="MyNet.Color.Success">#388A34</Color>
    <Color x:Key="MyNet.Color.Error">#A1260D</Color>
    <Color x:Key="MyNet.Color.Warning">#DD6E00</Color>
    <Color x:Key="MyNet.Color.Information">#1BA1E2</Color>
    <Color x:Key="MyNet.Color.Neutral">#828282</Color>

    <!-- CodeBlock -->
    <Color x:Key="MyNet.Color.CodeBlock.Unknown">DarkSlateGray</Color>
    <Color x:Key="MyNet.Color.CodeBlock.Space">Transparent</Color>
    <Color x:Key="MyNet.Color.CodeBlock.Comment">DarkGreen</Color>
    <Color x:Key="MyNet.Color.CodeBlock.Tag">Lime</Color>
    <Color x:Key="MyNet.Color.CodeBlock.Quote">RoyalBlue</Color>
    <Color x:Key="MyNet.Color.CodeBlock.AttributeValue">RoyalBlue</Color>
    <Color x:Key="MyNet.Color.CodeBlock.AttributeKey">CornflowerBlue</Color>
    <Color x:Key="MyNet.Color.CodeBlock.Brace">Chocolate</Color>
    <Color x:Key="MyNet.Color.CodeBlock.Entity">LightSeaGreen</Color>

    <!-- Gender -->
    <Color x:Key="MyNet.Color.Gender.Female">#c90076</Color>
    <Color x:Key="MyNet.Color.Gender.Male">#2986cc</Color>
    
    <!-- Special brushes -->
    <VisualBrush x:Key="MyNet.Brush.Transparency"
                 DestinationRect="0,0,20,20"
                 Stretch="Uniform"
                 TileMode="Tile">
        <VisualBrush.Visual>
            <Image Width="20" Height="20">
                <Image.Source>
                    <DrawingImage>
                        <DrawingImage.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L2,0 2,2, 0,2Z" />
                                <GeometryDrawing Brush="{StaticResource MyNet.Brush.Control.Background}" Geometry="M0,1 L2,1 2,2, 1,2 1,0 0,0Z" />
                            </DrawingGroup>
                        </DrawingImage.Drawing>
                    </DrawingImage>
                </Image.Source>
            </Image>
        </VisualBrush.Visual>
    </VisualBrush>
    <VisualBrush x:Key="MyNet.Brush.Transparency.Small"
                 DestinationRect="0,0,8,8"
                 Stretch="Uniform"
                 TileMode="Tile">
        <VisualBrush.Visual>
            <Image Width="8" Height="8">
                <Image.Source>
                    <DrawingImage>
                        <DrawingImage.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L2,0 2,2, 0,2Z" />
                                <GeometryDrawing Brush="{StaticResource MyNet.Brush.Control.Background}" Geometry="M0,1 L2,1 2,2, 1,2 1,0 0,0Z" />
                            </DrawingGroup>
                        </DrawingImage.Drawing>
                    </DrawingImage>
                </Image.Source>
            </Image>
        </VisualBrush.Visual>
    </VisualBrush>
</ResourceDictionary>