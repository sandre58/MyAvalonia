<Styles x:Class="MyNet.Avalonia.Theme.MyTheme"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="using:MyNet.Avalonia.Theme.Themes">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceInclude x:Key="Dark" Source="avares://MyNet.Avalonia.Theme/Themes/Dark.axaml" />
                <ResourceInclude x:Key="Light" Source="avares://MyNet.Avalonia.Theme/Themes/Light.axaml" />
                <ResourceInclude x:Key="{x:Static themes:ThemeVariantProvider.DarkBlue}" Source="avares://MyNet.Avalonia.Theme/Themes/DarkBlue.axaml" />
                <ResourceInclude x:Key="{x:Static themes:ThemeVariantProvider.HighContrast}" Source="avares://MyNet.Avalonia.Theme/Themes/HighContrast.axaml" />
            </ResourceDictionary.ThemeDictionaries>

            <ResourceDictionary.MergedDictionaries>

                <!-- ══════════════════════════════════════════════════════════ -->
                <!-- 1. TOKENS - Design tokens (values)                         -->
                <!-- ══════════════════════════════════════════════════════════ -->
                <ResourceInclude Source="avares://MyNet.Avalonia.Theme/Tokens/_index.axaml" />

                <!-- ══════════════════════════════════════════════════════════ -->
                <!-- 2. RESOURCES - Resources only (DataTemplates, Icons)       -->
                <!-- ══════════════════════════════════════════════════════════ -->
                <ResourceInclude Source="avares://MyNet.Avalonia.Theme/Resources/_index.axaml" />

                <!-- ══════════════════════════════════════════════════════════ -->
                <!-- 3. CONTROLS - ControlThemes                                -->
                <!-- ══════════════════════════════════════════════════════════ -->
                <ResourceInclude Source="avares://MyNet.Avalonia.Theme/Controls/_index.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- 4. STYLES - Utility styles                                 -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <StyleInclude Source="avares://MyNet.Avalonia.Theme/Styles/_index.axaml" />
</Styles>
