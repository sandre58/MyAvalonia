<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">

    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- RESOURCES (DataTemplates, Geometries, etc.)                -->
    <!-- These are loaded BEFORE Controls                           -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://MyNet.Avalonia.Theme/Resources/DataTemplates.axaml" />
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
