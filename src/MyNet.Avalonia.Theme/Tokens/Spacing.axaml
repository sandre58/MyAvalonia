<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ===================================================================== -->
    <!-- Spacing Tokens                                                        -->
    <!-- ===================================================================== -->

    <sys:Double x:Key="MyNet.Spacing.None">0</sys:Double>
    <sys:Double x:Key="MyNet.Spacing.Xxs">1</sys:Double>
    <sys:Double x:Key="MyNet.Spacing.Xs">2</sys:Double>
    <sys:Double x:Key="MyNet.Spacing.Sm">5</sys:Double>
    <sys:Double x:Key="MyNet.Spacing.Md">10</sys:Double>
    <sys:Double x:Key="MyNet.Spacing.Lg">16</sys:Double>
    <sys:Double x:Key="MyNet.Spacing.Xl">24</sys:Double>
    <sys:Double x:Key="MyNet.Spacing.Xxl">32</sys:Double>
    <sys:Double x:Key="MyNet.Spacing.Xxxl">48</sys:Double>

    <sys:Double x:Key="MyNet.Spacing.Icon">5</sys:Double>

    <!-- ===================================================================== -->
    <!-- Padding Tokens                                                        -->
    <!-- ===================================================================== -->

    <!-- Button Padding -->
    <Thickness x:Key="MyNet.Padding.Button.Sm">6,2</Thickness>
    <Thickness x:Key="MyNet.Padding.Button.Md">11,4</Thickness>
    <Thickness x:Key="MyNet.Padding.Button.Lg">16,4</Thickness>

    <!-- Input Padding -->
    <Thickness x:Key="MyNet.Padding.Input.Md">4,0,0,0</Thickness>
    <Thickness x:Key="MyNet.Padding.Input.Inner.Md">0,4,4,4</Thickness>
    <Thickness x:Key="MyNet.Padding.Input.Underline.Md">0</Thickness>
    <Thickness x:Key="MyNet.Padding.Input.Underline.Inner.Md">2,4</Thickness>

    <!-- Tag Padding -->
    <Thickness x:Key="MyNet.Padding.Tag">4,1</Thickness>

    <!-- Label Padding -->
    <Thickness x:Key="MyNet.Padding.Label.Sm">4,1</Thickness>
    <Thickness x:Key="MyNet.Padding.Label.Md">8,2</Thickness>
    <Thickness x:Key="MyNet.Padding.Label.Lg">10,4</Thickness>

    <!-- Popup & ToolTip Padding -->
    <Thickness x:Key="MyNet.Padding.Popup">10</Thickness>
    <Thickness x:Key="MyNet.Padding.ToolTip">5</Thickness>

    <!-- Banner & Surface Padding -->
    <Thickness x:Key="MyNet.Padding.Banner">10,7</Thickness>
    <Thickness x:Key="MyNet.Padding.Surface">10</Thickness>
    <Thickness x:Key="MyNet.Padding.Surface.Header.Sm">4,2</Thickness>
    <Thickness x:Key="MyNet.Padding.Surface.Header.Md">10,7</Thickness>
    <Thickness x:Key="MyNet.Padding.Surface.Header.Lg">12,10</Thickness>

    <!-- MenuItem Padding -->
    <Thickness x:Key="MyNet.Padding.MenuItem">20,8</Thickness>
    <Thickness x:Key="MyNet.Padding.MenuItem.Horizontal">8,4,8,7</Thickness>

    <!-- ListBoxItem Padding -->
    <Thickness x:Key="MyNet.Padding.ListBoxItem">16,8</Thickness>
    <Thickness x:Key="MyNet.Padding.ListBoxItem.Sm">3,2</Thickness>
    <Thickness x:Key="MyNet.Padding.ListBoxItem.Md">5</Thickness>
    <Thickness x:Key="MyNet.Padding.ListBoxItem.Lg">10,8</Thickness>

    <!-- Tab Padding -->
    <Thickness x:Key="MyNet.Padding.Tab.Sm">10,3</Thickness>
    <Thickness x:Key="MyNet.Padding.Tab.Md">11,4</Thickness>
    <Thickness x:Key="MyNet.Padding.Tab.Lg">16,4</Thickness>

    <!-- Calendar Padding -->
    <Thickness x:Key="MyNet.Padding.Calendar.Item.Sm">2</Thickness>
    <Thickness x:Key="MyNet.Padding.Calendar.Item.Md">4</Thickness>
    <Thickness x:Key="MyNet.Padding.Calendar.Item.Lg">6</Thickness>

    <!-- ScrollViewer Padding -->
    <Thickness x:Key="MyNet.Padding.ScrollViewer.Popup">3</Thickness>

    <!-- ===================================================================== -->
    <!-- Margin Tokens                                                         -->
    <!-- ===================================================================== -->

    <!-- Form Margins -->
    <Thickness x:Key="MyNet.Margin.Form.Item">0,10</Thickness>
    <Thickness x:Key="MyNet.Margin.Form.Group">0,30,0,0</Thickness>

    <!-- Popup & ToolTip Margins -->
    <Thickness x:Key="MyNet.Margin.Popup">2,2,8,8</Thickness>
    <Thickness x:Key="MyNet.Margin.ToolTip">2,2,4,4</Thickness>
</ResourceDictionary>
