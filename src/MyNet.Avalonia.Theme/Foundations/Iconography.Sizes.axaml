<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:my="http://mynet.com/avalonia">

    <!-- Button + ToggleButton + HyperlinkButton + DropDownButton + SplitButton + ToggleSplitButton + CheckBox + RadioButton + Label + Tag + TreeView + ListBox + TabControl + TabStrip -->
    <Style Selector=":is(Button), :is(SplitButton), Label, my|Tag, TreeView, ListBox, TabControl, TabStrip">

        <Style Selector="^, ^ TreeViewItem, ^ ListBoxItem, ^ TabItem, ^ TabStripItem">

            <Style Selector="^ PathIcon[(my|IconAssist.Role)=Label]:not(.kind-glyph)">
                <Setter Property="Height" Value="{StaticResource MyNet.Size.Icon.Sm}" />
                <Setter Property="Width" Value="{StaticResource MyNet.Size.Icon.Sm}" />
            </Style>
            <Style Selector="^ PathIcon[(my|IconAssist.Role)=Primary]:not(.kind-glyph)">
                <Setter Property="Height" Value="{StaticResource MyNet.Size.Icon.Md}" />
                <Setter Property="Width" Value="{StaticResource MyNet.Size.Icon.Md}" />
            </Style>

            <Style Selector="^.kind-tool PathIcon:not(.kind-glyph), ^.kind-caption PathIcon:not(.kind-glyph)">
                <Setter Property="Height" Value="{StaticResource MyNet.Size.Icon.Tool}" />
                <Setter Property="Width" Value="{StaticResource MyNet.Size.Icon.Tool}" />
            </Style>

            <Style Selector="^ PathIcon.kind-glyph">
                <Setter Property="Height" Value="{StaticResource MyNet.Size.Glyph.Md}" />
                <Setter Property="Width" Value="{StaticResource MyNet.Size.Glyph.Md}" />
            </Style>

        </Style>

        <Style Selector="^.size-sm, ^.size-sm TreeViewItem, ^.size-sm ListBoxItem, ^.size-sm TabItem, ^.size-sm TabStripItem">

            <Style Selector="^ PathIcon[(my|IconAssist.Role)=Label]:not(.kind-glyph)">
                <Setter Property="Height" Value="{StaticResource MyNet.Size.Icon.Xs}" />
                <Setter Property="Width" Value="{StaticResource MyNet.Size.Icon.Xs}" />
            </Style>
            <Style Selector="^ PathIcon[(my|IconAssist.Role)=Primary]:not(.kind-glyph)">
                <Setter Property="Height" Value="{StaticResource MyNet.Size.Icon.Sm}" />
                <Setter Property="Width" Value="{StaticResource MyNet.Size.Icon.Sm}" />
            </Style>

            <Style Selector="^.kind-tool PathIcon:not(.kind-glyph)">
                <Setter Property="Height" Value="{StaticResource MyNet.Size.Icon.Tool.Sm}" />
                <Setter Property="Width" Value="{StaticResource MyNet.Size.Icon.Tool.Sm}" />
            </Style>

            <Style Selector="^ PathIcon.kind-glyph">
                <Setter Property="Height" Value="{StaticResource MyNet.Size.Glyph.Sm}" />
                <Setter Property="Width" Value="{StaticResource MyNet.Size.Glyph.Sm}" />
            </Style>

        </Style>

        <Style Selector="^.size-lg, ^.size-lg TreeViewItem, ^.size-lg ListBoxItem, ^.size-lg TabItem, ^.size-lg TabStripItem">

            <Style Selector="^ PathIcon[(my|IconAssist.Role)=Label]:not(.kind-glyph)">
                <Setter Property="Height" Value="{StaticResource MyNet.Size.Icon.Md}" />
                <Setter Property="Width" Value="{StaticResource MyNet.Size.Icon.Md}" />
            </Style>
            <Style Selector="^ PathIcon[(my|IconAssist.Role)=Primary]:not(.kind-glyph)">
                <Setter Property="Height" Value="{StaticResource MyNet.Size.Icon.Lg}" />
                <Setter Property="Width" Value="{StaticResource MyNet.Size.Icon.Lg}" />
            </Style>

            <Style Selector="^ PathIcon.kind-glyph">
                <Setter Property="Height" Value="{StaticResource MyNet.Size.Glyph.Lg}" />
                <Setter Property="Width" Value="{StaticResource MyNet.Size.Glyph.Lg}" />
            </Style>

        </Style>

    </Style>

    <!-- Variants (TextFields) : AutoCompleteBox, ComboBox, CalendarDatePicker, DatePicker, NumericUpDown, TimePicker, TextBox, CalendarDatePickerEx, CodeBlock, ColorPickerEx, DateRangePicker, DateTimePicker, MultiComboBox, TagBox, TimePickerEx, TimeRangePicker -->
    <Style Selector="AutoCompleteBox, ComboBox, CalendarDatePicker, DatePicker, NumericUpDown, TimePicker, TextBox, my|CalendarDatePickerEx, my|CodeBlock, my|ColorPickerEx, my|DateRangePicker, my|DateTimePicker, my|MultiComboBox, my|TagBox, my|TimePickerEx, my|TimeRangePicker">

        <Style Selector="^">

            <Style Selector="^ /template/ ContentControl#PART_Icon PathIcon">
                <Setter Property="Height" Value="{StaticResource MyNet.Size.Icon.Sm}" />
                <Setter Property="Width" Value="{StaticResource MyNet.Size.Icon.Sm}" />
            </Style>

        </Style>

        <Style Selector="^.size-sm">

            <Style Selector="^ /template/ ContentControl#PART_Icon PathIcon">
                <Setter Property="Height" Value="{StaticResource MyNet.Size.Icon.Xs}" />
                <Setter Property="Width" Value="{StaticResource MyNet.Size.Icon.Xs}" />
            </Style>

        </Style>

        <Style Selector="^.size-lg">

            <Style Selector="^ /template/ ContentControl#PART_Icon PathIcon">
                <Setter Property="Height" Value="{StaticResource MyNet.Size.Icon.Md}" />
                <Setter Property="Width" Value="{StaticResource MyNet.Size.Icon.Md}" />
            </Style>

        </Style>

    </Style>

    <!-- HeaderedContentControl + Expander + Banner -->
    <Style Selector="HeaderedContentControl, Expander, my|Banner">

        <Style Selector="^">

            <Style Selector="^ /template/ Border#PART_Header PathIcon[(my|IconAssist.Role)=Label]:not(.kind-glyph), ^ /template/ Border#PART_Header PathIcon[(my|IconAssist.Role)=Primary]:not(.kind-glyph)">
                <Setter Property="Height" Value="{StaticResource MyNet.Size.Icon.Md}" />
                <Setter Property="Width" Value="{StaticResource MyNet.Size.Icon.Md}" />
            </Style>

            <Style Selector="^^ /template/ Border#PART_Header PathIcon.kind-glyph">
                <Setter Property="Height" Value="{StaticResource MyNet.Size.Glyph.Md}" />
                <Setter Property="Width" Value="{StaticResource MyNet.Size.Glyph.Md}" />
            </Style>

        </Style>

        <Style Selector="^.size-sm">

            <Style Selector="^ /template/ Border#PART_Header PathIcon[(my|IconAssist.Role)=Label]:not(.kind-glyph), ^ /template/ Border#PART_Header PathIcon[(my|IconAssist.Role)=Primary]:not(.kind-glyph)">
                <Setter Property="Height" Value="{StaticResource MyNet.Size.Icon.Sm}" />
                <Setter Property="Width" Value="{StaticResource MyNet.Size.Icon.Sm}" />
            </Style>

            <Style Selector="^^ /template/ Border#PART_Header PathIcon.kind-glyph">
                <Setter Property="Height" Value="{StaticResource MyNet.Size.Glyph.Sm}" />
                <Setter Property="Width" Value="{StaticResource MyNet.Size.Glyph.Sm}" />
            </Style>

        </Style>

        <Style Selector="^.size-lg">

            <Style Selector="^ /template/ Border#PART_Header PathIcon[(my|IconAssist.Role)=Label]:not(.kind-glyph), ^ /template/ Border#PART_Header PathIcon[(my|IconAssist.Role)=Primary]:not(.kind-glyph)">
                <Setter Property="Height" Value="{StaticResource MyNet.Size.Icon.Lg}" />
                <Setter Property="Width" Value="{StaticResource MyNet.Size.Icon.Lg}" />
            </Style>

            <Style Selector="^^ /template/ Border#PART_Header PathIcon.kind-glyph">
                <Setter Property="Height" Value="{StaticResource MyNet.Size.Glyph.Lg}" />
                <Setter Property="Width" Value="{StaticResource MyNet.Size.Glyph.Lg}" />
            </Style>

        </Style>

    </Style>

    <!-- Badge -->
    <Style Selector="my|Badge">

        <Style Selector="^">

            <Style Selector="^ /template/ Border#PART_Header PathIcon[(my|IconAssist.Role)=Label]:not(.kind-glyph), ^ /template/ Border#PART_Header PathIcon[(my|IconAssist.Role)=Primary]:not(.kind-glyph)">
                <Setter Property="Height" Value="{StaticResource MyNet.Size.Icon.Sm}" />
                <Setter Property="Width" Value="{StaticResource MyNet.Size.Icon.Sm}" />
            </Style>

        </Style>

        <Style Selector="^.size-sm">

            <Style Selector="^ /template/ Border#PART_Header PathIcon[(my|IconAssist.Role)=Label]:not(.kind-glyph), ^ /template/ Border#PART_Header PathIcon[(my|IconAssist.Role)=Primary]:not(.kind-glyph)">
                <Setter Property="Height" Value="{StaticResource MyNet.Size.Icon.Xs}" />
                <Setter Property="Width" Value="{StaticResource MyNet.Size.Icon.Xs}" />
            </Style>

        </Style>

        <Style Selector="^.size-lg">

            <Style Selector="^ /template/ Border#PART_Header PathIcon[(my|IconAssist.Role)=Label]:not(.kind-glyph), ^ /template/ Border#PART_Header PathIcon[(my|IconAssist.Role)=Primary]:not(.kind-glyph)">
                <Setter Property="Height" Value="{StaticResource MyNet.Size.Icon.Md}" />
                <Setter Property="Width" Value="{StaticResource MyNet.Size.Icon.Md}" />
            </Style>

        </Style>

    </Style>

    <!-- ToggleSwitch -->
    <Style Selector="ToggleSwitch">

        <Style Selector="^">

            <Style Selector="^ PathIcon">
                <Setter Property="Height" Value="{StaticResource MyNet.Size.Icon.Sm}" />
                <Setter Property="Width" Value="{StaticResource MyNet.Size.Icon.Sm}" />
            </Style>

        </Style>

        <Style Selector="^.size-sm">

            <Style Selector="^ PathIcon">
                <Setter Property="Height" Value="{StaticResource MyNet.Size.Icon.Xs}" />
                <Setter Property="Width" Value="{StaticResource MyNet.Size.Icon.Xs}" />
            </Style>

        </Style>

        <Style Selector="^.size-lg">

            <Style Selector="^ PathIcon">
                <Setter Property="Height" Value="{StaticResource MyNet.Size.Icon.Md}" />
                <Setter Property="Width" Value="{StaticResource MyNet.Size.Icon.Md}" />
            </Style>

        </Style>
    </Style>

    <!-- Avatar -->
    <Style Selector="my|Avatar">
        <Style Selector="^ PathIcon">
            <Setter Property="Height" Value="{Binding $parent[my:Avatar].Width, Converter={x:Static my:MathConverter.Divide}, ConverterParameter=1.5}" />
            <Setter Property="Width" Value="{Binding $parent[my:Avatar].Width, Converter={x:Static my:MathConverter.Divide}, ConverterParameter=1.5}" />
        </Style>
    </Style>

    <!-- PathIcon -->
    <Style Selector=":is(PathIcon)">
        <Style Selector="^.size-xs">
            <Setter Property="Height" Value="{StaticResource MyNet.Size.Icon.Xs}" />
            <Setter Property="Width" Value="{StaticResource MyNet.Size.Icon.Xs}" />
        </Style>
        <Style Selector="^.size-sm">
            <Setter Property="Height" Value="{StaticResource MyNet.Size.Icon.Sm}" />
            <Setter Property="Width" Value="{StaticResource MyNet.Size.Icon.Sm}" />
        </Style>
        <Style Selector="^.size-md">
            <Setter Property="Height" Value="{StaticResource MyNet.Size.Icon.Md}" />
            <Setter Property="Width" Value="{StaticResource MyNet.Size.Icon.Md}" />
        </Style>
        <Style Selector="^.size-lg">
            <Setter Property="Height" Value="{StaticResource MyNet.Size.Icon.Lg}" />
            <Setter Property="Width" Value="{StaticResource MyNet.Size.Icon.Lg}" />
        </Style>
        <Style Selector="^.size-xl">
            <Setter Property="Height" Value="{StaticResource MyNet.Size.Icon.Xl}" />
            <Setter Property="Width" Value="{StaticResource MyNet.Size.Icon.Xl}" />
        </Style>
    </Style>
</Styles>
