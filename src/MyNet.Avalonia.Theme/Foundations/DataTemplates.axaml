<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:my="http://mynet.com/avalonia"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:o="using:MyNet.Observable.Translatables"
                    xmlns:media="using:Avalonia.Media">

    <DataTemplate x:Key="MyNet.DataTemplate.PathIcon" DataType="{x:Type media:Geometry}">
        <PathIcon Data="{Binding}" />
    </DataTemplate>

    <DataTemplate x:Key="MyNet.DataTemplate.Translatable" DataType="{x:Type o:StringTranslatable}">
        <TextBlock Text="{Binding Value}" />
    </DataTemplate>

    <DataTemplate x:Key="MyNet.DataTemplates.Text.ClipBoard">
        <DockPanel>
            <Button DockPanel.Dock="Right" Classes="kind-tool is-clipboard" CommandParameter="{Binding}" Margin="{my:Thickness Sm, Left}" />
            <TextBlock Text="{Binding}" FontStyle="Italic" />
        </DockPanel>
    </DataTemplate>

</ResourceDictionary>