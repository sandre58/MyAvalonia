<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal">
    
    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- UTILITY STYLES                                             -->
    <!-- These will be loaded AFTER Controls to override defaults   -->
    <!-- ══════════════════════════════════════════════════════════ -->
