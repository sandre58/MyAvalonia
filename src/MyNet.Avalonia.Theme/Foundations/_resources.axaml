<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal">
    
    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- RESOURCES (DataTemplates, Geometries, etc.)                -->
    <!-- These are loaded BEFORE Controls                           -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://MyNet.Avalonia.Theme/Foundations/DataTemplates.axaml" />
                <ResourceInclude Source="avares://MyNet.Avalonia.Theme/Foundations/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
