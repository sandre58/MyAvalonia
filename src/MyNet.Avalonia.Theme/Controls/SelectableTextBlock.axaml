<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:my="http://mynet.com/avalonia"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <MenuFlyout x:Key="MyNet.MenuFlyout.Embedded.SelectableTextBlock" x:DataType="sys:Object" Placement="Bottom">
        <MenuItem Command="{Binding $parent[SelectableTextBlock].Copy}"
                  Header="{my:Loc Copy}"
                  Icon="{my:MaterialIcon ContentCopy}"
                  InputGesture="{Binding Converter={x:Static my:KeyGesturesConverter.Default}, ConverterParameter=copy}"
                  IsEnabled="{Binding $parent[SelectableTextBlock].CanCopy}" />
        <MenuItem Command="{Binding $parent[SelectableTextBlock].SelectAll}"
                  Header="{my:Loc SelectAll}"
                  Icon="{my:MaterialIcon SelectAll}"
                  InputGesture="{Binding Converter={x:Static my:KeyGesturesConverter.Default}, ConverterParameter=selectall}" />
    </MenuFlyout>

    <ControlTheme x:Key="{x:Type SelectableTextBlock}" TargetType="SelectableTextBlock">
        <Setter Property="my:ThemeAssist.Category" Value="Unknown" />
        <Setter Property="HorizontalAlignment" Value="{StaticResource MyNet.HorizontalAlignment.Control}" />
        <Setter Property="VerticalAlignment" Value="{StaticResource MyNet.VerticalAlignment.Control}" />
        <Setter Property="Cursor" Value="Ibeam" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />

        <!-- Default colors -->
        <Setter Property="my:VariantAssist.DefaultPrimary" Value="{my:ThemeContext Primary}" />

        <!-- Theme -->
        <Setter Property="SelectionBrush" Value="{my:ThemeRole Primary, Opacity=Scrim}" />

        <Style Selector="^.has-role">
            <Setter Property="my:VariantAssist.DefaultForeground" Value="{my:Foreground AncestorType=Control}" />
            <Setter Property="Foreground" Value="{my:ThemeRole Foreground}" />
        </Style>

        <Style Selector="^[IsEnabled=True]">
            <Setter Property="ContextFlyout" Value="{StaticResource MyNet.MenuFlyout.Embedded.SelectableTextBlock}" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
