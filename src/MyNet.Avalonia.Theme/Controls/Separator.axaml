<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:my="http://mynet.com/avalonia">
    <Styles.Resources>
        
        <!-- ═════════════════════════════════════════════════════════ -->
        <!-- DEFAULT SEPARATOR THEME                                   -->
        <!-- ═════════════════════════════════════════════════════════ -->
        <ControlTheme x:Key="{x:Type Separator}" TargetType="Separator">
            <Setter Property="Margin" Value="{my:Thickness Sm}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Height" Value="1" />
            <Setter Property="MinHeight" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                </ControlTemplate>
            </Setter>
            
            <Setter Property="my:PaletteAssist.Background" Value="{my:ThemeContext Divider}" />
            <Setter Property="Background" Value="{my:ThemeRole Background}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </ControlTheme>

    </Styles.Resources>

    <Style Selector=":is(Separator)">
        
        <!-- ═════════════════════════════════════════════════════════ -->
        <!-- VARIANTS                                                  -->
        <!-- ═════════════════════════════════════════════════════════ -->

        <Style Selector="^.orientation-vertical">
            <Setter Property="Height" Value="NaN" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="1" />
            <Setter Property="Width" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>

    </Style>
</Styles>