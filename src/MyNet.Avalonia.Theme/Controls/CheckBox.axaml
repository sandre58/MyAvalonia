<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:my="http://mynet.com/avalonia">
    <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox" BasedOn="{StaticResource MyNet.Theme.ToggleButton.CheckBox}">
        <Setter Property="my:ThemeAssist.Category" Value="Selection" />
</ControlTheme>
</ResourceDictionary>
