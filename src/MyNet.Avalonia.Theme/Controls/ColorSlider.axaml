<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:my="http://mynet.com/avalonia">

    <!-- --------------------------------------------------------- -->
    <!-- EMBEDDED COLORSLIDER THUMB THEME                          -->
    <!-- --------------------------------------------------------- -->
    <ControlTheme x:Key="MyNet.Theme.Thumb.Embedded.ColorSlider" TargetType="{x:Type Thumb}" BasedOn="{StaticResource MyNet.Theme.Thumb.Embedded.Slider}">
        <Setter Property="BorderBrush" Value="White" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="my:InteractionAssist.HoverBackground" Value="Transparent" />
        <Setter Property="my:InteractionAssist.ActiveBackground" Value="Transparent" />
        <Setter Property="my:ShadowAssist.ShadowDepth" Value="Depth2" />
    </ControlTheme>

    <!-- --------------------------------------------------------- -->
    <!-- DEFAULT COLORSLIDER THEME                                 -->
    <!-- --------------------------------------------------------- -->
    <ControlTheme x:Key="{x:Type ColorSlider}" TargetType="ColorSlider" BasedOn="{StaticResource {x:Type Slider}}">
        <Setter Property="my:SliderAssist.ThumbTheme" Value="{StaticResource MyNet.Theme.Thumb.Embedded.ColorSlider}" />
        <Setter Property="my:SliderAssist.ShowValueOnMouseOver" Value="False" />
        <Setter Property="my:SliderAssist.BarSize" Value="16" />
        <Setter Property="my:SliderAssist.ThumbSize" Value="16" />
        <Setter Property="CornerRadius" Value="8" />

        <!-- Theme -->
        <Setter Property="BorderThickness" Value="0" />

        <Style Selector="^:horizontal">
            <Setter Property="Template">
                <ControlTemplate TargetType="Slider">
                    <DataValidationErrors Name="PART_DataValidation" Theme="{TemplateBinding my:ValidationAssist.Theme}">
                        <Grid Name="SliderContainer" Margin="{TemplateBinding Padding}">
                            <Rectangle Height="{TemplateBinding my:SliderAssist.BarSize}"
                                       VerticalAlignment="Center"
                                       Fill="{my:Theme Transparency.Small}"
                                       RadiusX="{TemplateBinding CornerRadius, Converter={x:Static my:CornerRadiusConverter.ToDouble.TopLeft}}"
                                       RadiusY="{TemplateBinding CornerRadius, Converter={x:Static my:CornerRadiusConverter.ToDouble.TopLeft}}" />
                            <Rectangle Height="{TemplateBinding my:SliderAssist.BarSize}"
                                       VerticalAlignment="Center"
                                       Fill="{TemplateBinding Background}"
                                       RadiusX="{TemplateBinding CornerRadius, Converter={x:Static my:CornerRadiusConverter.ToDouble.TopLeft}}"
                                       RadiusY="{TemplateBinding CornerRadius, Converter={x:Static my:CornerRadiusConverter.ToDouble.TopLeft}}" />
                            <Rectangle Height="{TemplateBinding my:SliderAssist.BarSize}"
                                       VerticalAlignment="Center"
                                       Stroke="{TemplateBinding BorderBrush}"
                                       StrokeThickness="{TemplateBinding BorderThickness, Converter={x:Static my:ThicknessConverter.ToDouble.Left}}"
                                       RadiusX="{TemplateBinding CornerRadius, Converter={x:Static my:CornerRadiusConverter.ToDouble.TopLeft}}"
                                       RadiusY="{TemplateBinding CornerRadius, Converter={x:Static my:CornerRadiusConverter.ToDouble.TopLeft}}" />
                            <Track Name="PART_Track"
                                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Minimum="{TemplateBinding Minimum}"
                                   Orientation="Horizontal"
                                   Value="{TemplateBinding Value, Mode=TwoWay}">
                                <Track.DecreaseButton>
                                    <RepeatButton Name="PART_DecreaseButton"
                                                  Background="Transparent"
                                                  CornerRadius="{TemplateBinding CornerRadius, Converter={x:Static my:CornerRadiusConverter.Adjust.Left}}"
                                                  Focusable="False"
                                                  Theme="{StaticResource MyNet.Theme.Button.Embedded.Slider.Horizontal}" />
                                </Track.DecreaseButton>
                                <Track.IncreaseButton>
                                    <RepeatButton Name="PART_IncreaseButton"
                                                  Background="Transparent"
                                                  CornerRadius="{TemplateBinding CornerRadius, Converter={x:Static my:CornerRadiusConverter.Adjust.Right}}"
                                                  Focusable="False"
                                                  Theme="{StaticResource MyNet.Theme.Button.Embedded.Slider.Horizontal}" />
                                </Track.IncreaseButton>
                                <Thumb Name="ColorSliderThumb"
                                       my:SliderAssist.ShowValueOnMouseOver="{TemplateBinding my:SliderAssist.ShowValueOnMouseOver}"
                                       DataContext="{TemplateBinding Value}"
                                       Theme="{TemplateBinding my:SliderAssist.ThumbTheme}" />
                            </Track>
                        </Grid>
                    </DataValidationErrors>
                </ControlTemplate>
            </Setter>

            <Style Selector="^[IsDirectionReversed=True] /template/ RepeatButton#PART_DecreaseButton">
                <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius, Converter={x:Static my:CornerRadiusConverter.Adjust.Right}}" />
            </Style>
            <Style Selector="^[IsDirectionReversed=True] /template/ RepeatButton#PART_IncreaseButton">
                <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius, Converter={x:Static my:CornerRadiusConverter.Adjust.Left}}" />
            </Style>
        </Style>
        <Style Selector="^:vertical">
            <Setter Property="Template">
                <ControlTemplate>
                    <DataValidationErrors Name="PART_DataValidation" Theme="{TemplateBinding my:ValidationAssist.Theme}">
                        <Grid Name="SliderContainer" Margin="{TemplateBinding Padding}">
                            <Rectangle Width="{TemplateBinding my:SliderAssist.BarSize}"
                                       HorizontalAlignment="Center"
                                       Fill="{my:Theme Transparency.Small}"
                                       RadiusX="{TemplateBinding CornerRadius, Converter={x:Static my:CornerRadiusConverter.ToDouble.TopLeft}}"
                                       RadiusY="{TemplateBinding CornerRadius, Converter={x:Static my:CornerRadiusConverter.ToDouble.TopLeft}}" />
                            <Rectangle Width="{TemplateBinding my:SliderAssist.BarSize}"
                                       HorizontalAlignment="Center"
                                       Fill="{TemplateBinding Background}"
                                       RadiusX="{TemplateBinding CornerRadius, Converter={x:Static my:CornerRadiusConverter.ToDouble.TopLeft}}"
                                       RadiusY="{TemplateBinding CornerRadius, Converter={x:Static my:CornerRadiusConverter.ToDouble.TopLeft}}" />
                            <Rectangle Width="{TemplateBinding my:SliderAssist.BarSize}"
                                       HorizontalAlignment="Center"
                                       Stroke="{TemplateBinding BorderBrush}"
                                       StrokeThickness="{TemplateBinding BorderThickness, Converter={x:Static my:ThicknessConverter.ToDouble.Left}}"
                                       RadiusX="{TemplateBinding CornerRadius, Converter={x:Static my:CornerRadiusConverter.ToDouble.TopLeft}}"
                                       RadiusY="{TemplateBinding CornerRadius, Converter={x:Static my:CornerRadiusConverter.ToDouble.TopLeft}}" />
                            <Track Name="PART_Track"
                                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Minimum="{TemplateBinding Minimum}"
                                   Orientation="Vertical"
                                   Value="{TemplateBinding Value, Mode=TwoWay}">
                                <Track.DecreaseButton>
                                    <RepeatButton Name="PART_DecreaseButton"
                                                  Background="Transparent"
                                                  CornerRadius="{TemplateBinding CornerRadius, Converter={x:Static my:CornerRadiusConverter.Adjust.Bottom}}"
                                                  Focusable="False"
                                                  Theme="{StaticResource MyNet.Theme.Button.Embedded.Slider.Vertical}" />
                                </Track.DecreaseButton>
                                <Track.IncreaseButton>
                                    <RepeatButton Name="PART_IncreaseButton"
                                                  Background="Transparent"
                                                  CornerRadius="{TemplateBinding CornerRadius, Converter={x:Static my:CornerRadiusConverter.Adjust.Top}}"
                                                  Focusable="False"
                                                  Theme="{StaticResource MyNet.Theme.Button.Embedded.Slider.Vertical}" />
                                </Track.IncreaseButton>
                                <Thumb Name="ColorSliderThumb"
                                       my:SliderAssist.ShowValueOnMouseOver="{TemplateBinding my:SliderAssist.ShowValueOnMouseOver}"
                                       DataContext="{TemplateBinding Value}"
                                       Theme="{TemplateBinding my:SliderAssist.ThumbTheme}" />
                            </Track>
                        </Grid>
                    </DataValidationErrors>
                </ControlTemplate>
            </Setter>

            <Style Selector="^[IsDirectionReversed=True] /template/ RepeatButton#PART_DecreaseButton">
                <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius, Converter={x:Static my:CornerRadiusConverter.Adjust.Top}}" />
            </Style>
            <Style Selector="^[IsDirectionReversed=True] /template/ RepeatButton#PART_IncreaseButton">
                <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius, Converter={x:Static my:CornerRadiusConverter.Adjust.Bottom}}" />
            </Style>
        </Style>

        <Style Selector="^:dark-selector /template/ Thumb#ColorSliderThumb">
            <Setter Property="BorderBrush" Value="Black" />
        </Style>
        <Style Selector="^:light-selector /template/ Thumb#ColorSliderThumb">
            <Setter Property="BorderBrush" Value="White" />
        </Style>

    </ControlTheme>

</ResourceDictionary>
