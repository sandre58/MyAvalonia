<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:my="http://mynet.com/avalonia">

    <!-- --------------------------------------------------------- -->
    <!-- DEFAULT BADGE THEME                                       -->
    <!-- --------------------------------------------------------- -->
    <ControlTheme x:Key="{x:Type my:Badge}" TargetType="{x:Type my:Badge}">
        <Setter Property="my:ThemeAssist.Category" Value="Indicator" />
        <Setter Property="HorizontalAlignment" Value="{StaticResource MyNet.HorizontalAlignment.Control}" />
        <Setter Property="VerticalAlignment" Value="{StaticResource MyNet.VerticalAlignment.Control}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Padding" Value="{StaticResource MyNet.Padding.Label.Sm}" />
        <Setter Property="CornerRadius" Value="{StaticResource MyNet.Corners.Control}" />
        <Setter Property="my:ShadowAssist.ShadowDepth" Value="Depth0" />
        <Setter Property="BadgeFontSize" Value="{StaticResource MyNet.Font.Size.Sm}" />
        <Setter Property="BadgeFontFamily" Value="{StaticResource MyNet.Font.FontFamily}" />
        <Setter Property="BadgeFontWeight" Value="{StaticResource MyNet.Font.Weight}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="CornerPosition" Value="TopRight" />

        <!-- Default colors -->
        <Setter Property="my:VariantAssist.DefaultBackground" Value="{my:ThemeContext Surface.Level3}" />
        <Setter Property="my:VariantAssist.DefaultBorderBrush" Value="{my:ThemeContext Surface.Border}" />
        <Setter Property="my:VariantAssist.DefaultForeground" Value="{my:ThemeContext Foreground.Primary}" />

        <!-- Variant -->
        <Setter Property="my:VariantAssist.Background" Value="{my:ThemeRole Background}" />
        <Setter Property="my:VariantAssist.BorderBrush" Value="{my:ThemeRole BorderBrush}" />
        <Setter Property="my:VariantAssist.Foreground" Value="{my:ThemeRole Foreground, Contrast=True}" />
        <Setter Property="my:VariantAssist.BorderThickness" Value="1" />

        <!-- Theme -->
        <Setter Property="BorderThickness" Value="{Binding $self.(my:VariantAssist.BorderThickness)}" />
        <Setter Property="Background" Value="{Binding $self.(my:VariantAssist.Background)}" />
        <Setter Property="BorderBrush" Value="{Binding $self.(my:VariantAssist.BorderBrush)}" />
        <Setter Property="BadgeForeground" Value="{Binding $self.(my:VariantAssist.Foreground)}" />
        <Setter Property="MaskBackground" Value="{my:Theme Surface.Level2}" />

        <Style Selector="^.context-contrast">
            <Setter Property="MaskBackground" Value="Transparent" />
        </Style>

        <Setter Property="Template">
            <ControlTemplate TargetType="{x:Type my:Badge}">
                <Grid HorizontalAlignment="{TemplateBinding HorizontalAlignment}" VerticalAlignment="{TemplateBinding VerticalAlignment}" ClipToBounds="False">
                    <ContentPresenter x:Name="PART_ContentPresenter"
                                      HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalAlignment}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                    <Panel Name="{x:Static my:Badge.PartBadgeContainer}" Classes="is-disablable" IsVisible="{Binding Header, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Border Background="{TemplateBinding MaskBackground}" CornerRadius="{TemplateBinding CornerRadius}" />
                        <Border Name="PART_Header"
                                my:ShadowAssist.ShadowDepth="{TemplateBinding my:ShadowAssist.ShadowDepth}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <my:IconContentControl Name="IconContent"
                                                   Padding="{TemplateBinding Padding}"
                                                   Icon="{TemplateBinding (my:IconAssist.Icon)}"
                                                   IconOpacity="{TemplateBinding (my:IconAssist.Opacity)}"
                                                   IconTemplate="{TemplateBinding (my:IconAssist.IconTemplate)}"
                                                   IconPosition="{TemplateBinding (my:IconAssist.Alignment)}"
                                                   LabelIconSize="{TemplateBinding (my:IconAssist.LabelSize)}"
                                                   PrimaryIconSize="{TemplateBinding (my:IconAssist.PrimarySize)}"
                                                   Spacing="{TemplateBinding (my:IconAssist.Spacing)}"
                                                   HorizontalAlignment="Stretch"
                                                   VerticalAlignment="Stretch"
                                                   HorizontalContentAlignment="{TemplateBinding my:HeaderAssist.HorizontalAlignment}"
                                                   VerticalContentAlignment="{TemplateBinding my:HeaderAssist.VerticalAlignment}"
                                                   FontFamily="{TemplateBinding BadgeFontFamily}"
                                                   FontSize="{TemplateBinding BadgeFontSize}"
                                                   FontWeight="{TemplateBinding BadgeFontWeight}"
                                                   Foreground="{TemplateBinding BadgeForeground}"
                                                   FontStyle="{TemplateBinding my:HeaderAssist.FontStyle}"
                                                   UseLayoutRounding="False">
                                <ContentPresenter Name="PART_HeaderPresenter" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"/>
                            </my:IconContentControl>
                        </Border>
                    </Panel>
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^[IsRounded=True]">
            <Setter Property="Template">
                <ControlTemplate TargetType="{x:Type my:Badge}">
                    <Grid HorizontalAlignment="{TemplateBinding HorizontalAlignment}" VerticalAlignment="{TemplateBinding VerticalAlignment}" ClipToBounds="False">
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <Panel Name="{x:Static my:Badge.PartBadgeContainer}" Classes="is-disablable use-transitions" IsVisible="{Binding Header, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Ellipse Width="{TemplateBinding BadgeWidth}" Height="{TemplateBinding BadgeHeight}" Fill="{TemplateBinding MaskBackground}" />
                            <Border Name="PART_ShadowBorder"
                                    Width="{TemplateBinding BadgeWidth}"
                                    Height="{TemplateBinding BadgeHeight}"
                                    IsHitTestVisible="False"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource MyNet.Corners.Round}"
                                    my:ShadowAssist.ShadowDepth="{TemplateBinding my:ShadowAssist.ShadowDepth}" />
                            <Ellipse Name="PART_Border"
                                     Width="{TemplateBinding BadgeWidth}"
                                     Height="{TemplateBinding BadgeHeight}"
                                     Fill="{TemplateBinding Background}"
                                     Stroke="{TemplateBinding BorderBrush}"
                                     StrokeThickness="{TemplateBinding BorderThickness, Converter={x:Static my:ThicknessConverter.ToDouble.Left}}" />
                            <Border Name="PART_Header">
                                <my:IconContentControl Name="IconContent"
                                                       Padding="{TemplateBinding Padding}"
                                                       Icon="{TemplateBinding (my:IconAssist.Icon)}"
                                                       IconOpacity="{TemplateBinding (my:IconAssist.Opacity)}"
                                                       IconTemplate="{TemplateBinding (my:IconAssist.IconTemplate)}"
                                                       IconPosition="{TemplateBinding (my:IconAssist.Alignment)}"
                                                       LabelIconSize="{TemplateBinding (my:IconAssist.LabelSize)}"
                                                       PrimaryIconSize="{TemplateBinding (my:IconAssist.PrimarySize)}"
                                                       Spacing="{TemplateBinding (my:IconAssist.Spacing)}"
                                                       HorizontalAlignment="Stretch"
                                                       VerticalAlignment="Stretch"
                                                       HorizontalContentAlignment="{TemplateBinding my:HeaderAssist.HorizontalAlignment}"
                                                       VerticalContentAlignment="{TemplateBinding my:HeaderAssist.VerticalAlignment}"
                                                       FontFamily="{TemplateBinding BadgeFontFamily}"
                                                       FontSize="{TemplateBinding BadgeFontSize}"
                                                       FontWeight="{TemplateBinding BadgeFontWeight}"
                                                       Foreground="{TemplateBinding BadgeForeground}"
                                                       FontStyle="{TemplateBinding my:HeaderAssist.FontStyle}"
                                                       UseLayoutRounding="False">
                                    <ContentPresenter Name="PART_HeaderPresenter" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"/>
                                </my:IconContentControl>
                            </Border>
                        </Panel>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- --------------------------------------------------------- -->
        <!-- SIZES                                                     -->
        <!-- --------------------------------------------------------- -->

        <Style Selector="^.size-sm">
            <Setter Property="Padding" Value="{StaticResource MyNet.Padding.Label.Sm}" />
            <Setter Property="BadgeFontSize" Value="{StaticResource MyNet.Font.Size.Sm}" />
            <Setter Property="my:IconAssist.LabelSize" Value="{StaticResource MyNet.Size.Icon.Xs}" />
            <Setter Property="my:IconAssist.PrimarySize" Value="{StaticResource MyNet.Size.Icon.Sm}" />
        </Style>

        <Style Selector="^.size-md">
            <Setter Property="Padding" Value="{StaticResource MyNet.Padding.Label.Md}" />
            <Setter Property="BadgeFontSize" Value="{StaticResource MyNet.Font.Size.Md}" />
            <Setter Property="my:IconAssist.LabelSize" Value="{StaticResource MyNet.Size.Icon.Sm}" />
            <Setter Property="my:IconAssist.PrimarySize" Value="{StaticResource MyNet.Size.Icon.Md}" />
        </Style>

        <Style Selector="^.size-lg">
            <Setter Property="Padding" Value="{StaticResource MyNet.Padding.Label.Lg}" />
            <Setter Property="BadgeFontSize" Value="{StaticResource MyNet.Font.Size.Lg}" />
            <Setter Property="my:IconAssist.LabelSize" Value="{StaticResource MyNet.Size.Icon.Md}" />
            <Setter Property="my:IconAssist.PrimarySize" Value="{StaticResource MyNet.Size.Icon.Lg}" />
        </Style>

    </ControlTheme>

</ResourceDictionary>
