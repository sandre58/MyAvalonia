<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:my="http://mynet.com/avalonia"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <ControlTheme x:Key="{x:Type NumericUpDown}" TargetType="NumericUpDown">

        <!-- Common -->
        <Setter Property="my:ThemeAssist.Category" Value="Input" />
        <Setter Property="my:DisableAssist.IsDisablable" Value="True" />
        <Setter Property="my:TransitionsAssist.UseTransitions" Value="True" />
        <Setter Property="HorizontalAlignment" Value="{StaticResource MyNet.HorizontalAlignment.Control}" />
        <Setter Property="VerticalAlignment" Value="{StaticResource MyNet.VerticalAlignment.Control}" />
        <Setter Property="CornerRadius" Value="{StaticResource MyNet.Corners.Control}" />
        <Setter Property="FontSize" Value="{StaticResource MyNet.Font.Size.Input}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="BackgroundSizing" Value="OuterBorderEdge" />
        <Setter Property="Padding" Value="{StaticResource MyNet.Padding.Input.Md}" />
        <Setter Property="MinHeight" Value="{StaticResource MyNet.Height.Input.Md}" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ScrollViewer.IsScrollChainingEnabled" Value="True" />
        <Setter Property="my:IconAssist.Alignment" Value="Left" />
        <Setter Property="my:IconAssist.Spacing" Value="{StaticResource MyNet.Spacing.Icon}" />
        <Setter Property="my:IconAssist.Opacity" Value="{DynamicResource MyNet.Opacity.High}" />
        <Setter Property="my:InputAssist.InnerFontSize" Value="{Binding $self.FontSize}" />
        <Setter Property="my:InputAssist.InnerPadding" Value="{StaticResource MyNet.Padding.Input.Inner.Md}" />
        <Setter Property="my:InputAssist.UnderFontSize" Value="{StaticResource MyNet.Font.Size.Sm}" />
        <Setter Property="my:InputAssist.PlaceholderFontSize" Value="{Binding $self.FontSize}" />
        <Setter Property="my:InputAssist.FloatingScale" Value="0.75" />
        <Setter Property="my:InputAssist.FloatingOffset" Value="12" />
        <Setter Property="my:ProxyBehavior.Enable" Value="True" />
        <Setter Property="my:ValidationAssist.Theme" Value="{StaticResource {x:Type DataValidationErrors}}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />

        <!-- Specific -->
        <Setter Property="InputMethod.IsInputMethodEnabled" Value="True" />
        <Setter Property="Cursor" Value="IBeam" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="PlaceholderText" Value="{x:Static sys:String.Empty}" />
        <Setter Property="FormatString" Value="0" />
        <Setter Property="my:SpinnerAssist.Layout" Value="Horizontal" />
        <Setter Property="my:SpinnerAssist.DecreaseContent">
            <Template>
                <my:MaterialIcon Kind="Minus" />
            </Template>
        </Setter>
        <Setter Property="my:SpinnerAssist.IncreaseContent">
            <Template>
                <my:MaterialIcon Kind="Plus" />
            </Template>
        </Setter>

        <!-- Default -->
        <Setter Property="my:VariantAssist.DefaultPrimary" Value="{my:ThemeContext Primary}" />
        <Setter Property="my:VariantAssist.Background" Value="{my:ThemeContext Surface.Level4}" />
        <Setter Property="my:VariantAssist.BorderBrush" Value="{my:ThemeContext Control.Border}" />
        <Setter Property="my:VariantAssist.Foreground" Value="{my:ThemeContext Foreground.Primary}" />
        <Setter Property="my:VariantAssist.Primary" Value="{my:ThemeRole Primary}" />
        <Setter Property="my:VariantAssist.BorderThickness" Value="1" />

        <!-- Theme -->
        <Setter Property="BorderThickness" Value="{Binding $self.(my:VariantAssist.BorderThickness)}" />
        <Setter Property="Background" Value="{Binding $self.(my:VariantAssist.Background)}" />
        <Setter Property="BorderBrush" Value="{Binding $self.(my:VariantAssist.BorderBrush)}" />
        <Setter Property="Foreground" Value="{Binding $self.(my:VariantAssist.Foreground)}" />
        <Setter Property="my:InputAssist.UnderForeground" Value="{my:Foreground Opacity=High}" />
        <Setter Property="my:InputAssist.InnerForeground" Value="{my:Foreground Opacity=High}" />
        <Setter Property="my:InputAssist.PlaceholderForeground" Value="{my:Foreground Opacity=Medium}" />
        <Setter Property="my:InteractionAssist.HoverBackground" Value="{my:Foreground Opacity=Hover}" />
        <Setter Property="my:InteractionAssist.HoverBorderBrush" Value="{my:ThemeContext Control.Border.Hover}" />
        <Setter Property="my:InteractionAssist.HoverForeground" Value="{my:Foreground}" />
        <Setter Property="my:InteractionAssist.RippleColor" Value="{my:Foreground}" />
        <Setter Property="my:InteractionAssist.ActiveBackground" Value="{my:Foreground Opacity=Focus}" />
        <Setter Property="my:InteractionAssist.ActiveForeground" Value="{Binding $self.(my:VariantAssist.Primary)}" />
        <Setter Property="my:InteractionAssist.ActiveBorderBrush" Value="{Binding $self.(my:VariantAssist.Primary)}" />

        <!-- ═════════════════════════════════════════════════════════ -->
        <!-- TEMPLATE                                                  -->
        <!-- Delegates all visual chrome to the ButtonSpinner theme    -->
        <!-- ═════════════════════════════════════════════════════════ -->
        <Setter Property="Template">
            <ControlTemplate TargetType="NumericUpDown">
                <ButtonSpinner Name="PART_Spinner"
                               Foreground="{TemplateBinding Foreground}"
                               FontSize="{TemplateBinding FontSize}"
                               FontWeight="{TemplateBinding FontWeight}"
                               Padding="{TemplateBinding Padding}"
                               MinHeight="{TemplateBinding MinHeight}"
                               HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                               VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch"
                               AllowSpin="{TemplateBinding AllowSpin}"
                               ShowButtonSpinner="{TemplateBinding ShowButtonSpinner}"
                               ButtonSpinnerLocation="{TemplateBinding ButtonSpinnerLocation}"
                               my:SpinnerAssist.Layout="{TemplateBinding (my:SpinnerAssist.Layout)}"
                               my:SpinnerAssist.SwitchButtons="{TemplateBinding (my:SpinnerAssist.SwitchButtons)}"
                               my:SpinnerAssist.DecreaseContent="{TemplateBinding (my:SpinnerAssist.DecreaseContent)}"
                               my:SpinnerAssist.IncreaseContent="{TemplateBinding (my:SpinnerAssist.IncreaseContent)}"
                               my:IconAssist.Icon="{TemplateBinding (my:IconAssist.Icon)}"
                               my:IconAssist.IconTemplate="{TemplateBinding (my:IconAssist.IconTemplate)}"
                               my:IconAssist.Alignment="{TemplateBinding (my:IconAssist.Alignment)}"
                               my:IconAssist.Spacing="{TemplateBinding (my:IconAssist.Spacing)}"
                               my:IconAssist.Opacity="{TemplateBinding (my:IconAssist.Opacity)}"
                               my:InputAssist.PlaceholderText="{TemplateBinding PlaceholderText}"
                               my:InputAssist.InnerLeftContent="{TemplateBinding InnerLeftContent}"
                               my:InputAssist.InnerRightContent="{TemplateBinding InnerRightContent}"
                               my:InputAssist.InnerPadding="{TemplateBinding (my:InputAssist.InnerPadding)}"
                               my:InputAssist.InnerFontSize="{TemplateBinding (my:InputAssist.InnerFontSize)}"
                               my:InputAssist.InnerForeground="{TemplateBinding (my:InputAssist.InnerForeground)}"
                               my:InputAssist.PlaceholderForeground="{TemplateBinding (my:InputAssist.PlaceholderForeground)}"
                               my:InputAssist.PlaceholderFontSize="{TemplateBinding (my:InputAssist.PlaceholderFontSize)}"
                               my:InputAssist.FloatingScale="{TemplateBinding (my:InputAssist.FloatingScale)}"
                               my:InputAssist.FloatingOffset="{TemplateBinding (my:InputAssist.FloatingOffset)}"
                               my:InputAssist.UseFloatingPlaceholder="{TemplateBinding (my:InputAssist.UseFloatingPlaceholder)}"
                               my:InputAssist.ShowClearButton="{TemplateBinding (my:InputAssist.ShowClearButton)}"
                               my:InputAssist.UnderText="{TemplateBinding (my:InputAssist.UnderText)}"
                               my:InputAssist.UnderForeground="{TemplateBinding (my:InputAssist.UnderForeground)}"
                               my:InputAssist.UnderFontSize="{TemplateBinding (my:InputAssist.UnderFontSize)}"
                               my:InputAssist.UnderFontStyle="{TemplateBinding (my:InputAssist.UnderFontStyle)}"
                               my:InputAssist.UnderFontWeight="{TemplateBinding (my:InputAssist.UnderFontWeight)}"
                               my:ProxyBehavior.Enable="False"
                               my:ProxyBehavior.Proxy="{TemplateBinding (my:ProxyBehavior.Proxy)}"
                               my:ValidationAssist.Theme="{TemplateBinding (my:ValidationAssist.Theme)}"
                               my:ShadowAssist.ShadowDepth="{TemplateBinding (my:ShadowAssist.ShadowDepth)}"
                               my:TransitionsAssist.UseTransitions="{TemplateBinding (my:TransitionsAssist.UseTransitions)}"
                               my:DisableAssist.IsDisablable="False"
                               DataValidationErrors.Errors="{TemplateBinding (DataValidationErrors.Errors)}">

                    <!-- TextBox as content of the ButtonSpinner -->
                    <TextBox Name="PART_TextBox"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch"
                             AcceptsReturn="False"
                             CaretBrush="{my:ThemeBrush (my:InteractionAssist.ActiveForeground), RelativeSource={RelativeSource Mode=TemplatedParent}}"
                             my:DisableAssist.IsDisablable="False"
                             DataValidationErrors.Errors="{TemplateBinding (DataValidationErrors.Errors)}"
                             IsHitTestVisible="{TemplateBinding (my:InputBehavior.IsTextEditable)}"
                             IsReadOnly="{Binding !(my:InputBehavior.IsTextEditable), RelativeSource={RelativeSource TemplatedParent}}"
                             SelectionBrush="{my:ThemeBrush (my:InteractionAssist.ActiveForeground), RelativeSource={RelativeSource Mode=TemplatedParent}, Opacity=Scrim}"
                             SelectionForegroundBrush="{TemplateBinding Foreground}"
                             TextWrapping="NoWrap"
                             Theme="{StaticResource MyNet.Theme.TextBox.Clean}" />
                </ButtonSpinner>
            </ControlTemplate>
        </Setter>

        <!-- ═════════════════════════════════════════════════════════ -->
        <!-- FORWARD VARIANT TO BUTTONSPINNER (via styles so that    -->
        <!-- ButtonSpinner state styles :error/:focus can override)   -->
        <!-- ═════════════════════════════════════════════════════════ -->
        <Style Selector="^ /template/ ButtonSpinner#PART_Spinner">
            <Setter Property="my:VariantAssist.DefaultPrimary" Value="{Binding (my:VariantAssist.DefaultPrimary), RelativeSource={RelativeSource AncestorType=NumericUpDown}}" />
            <Setter Property="my:VariantAssist.Background" Value="{Binding (my:VariantAssist.Background), RelativeSource={RelativeSource AncestorType=NumericUpDown}}" />
            <Setter Property="my:VariantAssist.BorderBrush" Value="{Binding (my:VariantAssist.BorderBrush), RelativeSource={RelativeSource AncestorType=NumericUpDown}}" />
            <Setter Property="my:VariantAssist.Foreground" Value="{Binding (my:VariantAssist.Foreground), RelativeSource={RelativeSource AncestorType=NumericUpDown}}" />
            <Setter Property="my:VariantAssist.Primary" Value="{Binding (my:VariantAssist.Primary), RelativeSource={RelativeSource AncestorType=NumericUpDown}}" />
            <Setter Property="my:VariantAssist.BorderThickness" Value="{Binding (my:VariantAssist.BorderThickness), RelativeSource={RelativeSource AncestorType=NumericUpDown}}" />
        </Style>

        <!-- ═════════════════════════════════════════════════════════ -->
        <!-- PROPAGATE CLASSES TO BUTTONSPINNER                       -->
        <!-- ═════════════════════════════════════════════════════════ -->
        <Style Selector="^.size-sm /template/ ButtonSpinner#PART_Spinner">
            <Setter Property="my:ClassesAssist.AddClasses" Value="size-sm" />
        </Style>

        <Style Selector="^.size-lg /template/ ButtonSpinner#PART_Spinner">
            <Setter Property="my:ClassesAssist.AddClasses" Value="size-lg" />
        </Style>

        <Style Selector="^.icon-right /template/ ButtonSpinner#PART_Spinner">
            <Setter Property="my:ClassesAssist.AddClasses" Value="icon-right" />
        </Style>

        <Style Selector="^.button-right /template/ ButtonSpinner#PART_Spinner">
            <Setter Property="my:ClassesAssist.AddClasses" Value="button-right" />
        </Style>

        <!-- ═════════════════════════════════════════════════════════ -->
        <!-- NUMERICUPDOWN-SPECIFIC STYLES                             -->
        <!-- ═════════════════════════════════════════════════════════ -->

        <!-- Is Read only -->
        <Style Selector="^[(my|InputBehavior.IsTextEditable)=False]">
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="my:InputBehavior.UpdateValueOnKeyboard" Value="True" />
            <Setter Property="my:InputBehavior.UpdateValueOnMouseWheel" Value="True" />
        </Style>
    </ControlTheme>

    <!-- ═════════════════════════════════════════════════════════════ -->
    <!-- UNDERLINE VARIANT                                             -->
    <!-- ═════════════════════════════════════════════════════════════ -->
    <ControlTheme x:Key="MyNet.Theme.NumericUpDown.Underline" TargetType="NumericUpDown" BasedOn="{StaticResource {x:Type NumericUpDown}}">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="{StaticResource MyNet.Padding.Input.Underline.Md}" />
        <Setter Property="my:InputAssist.InnerPadding" Value="{StaticResource MyNet.Padding.Input.Underline.Inner.Md}" />
        <Setter Property="my:InputAssist.UseFloatingPlaceholder" Value="True" />

        <!-- Default colors -->
        <Setter Property="my:VariantAssist.Background" Value="Transparent" />

        <!-- Default Theme -->
        <Setter Property="BorderThickness" Value="0 0 0 1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="my:InteractionAssist.HoverBackground" Value="Transparent" />
        <Setter Property="my:InteractionAssist.ActiveBackground" Value="Transparent" />
        <Setter Property="my:InteractionAssist.RippleColor" Value="Transparent" />

        <!-- Use underline theme for the ButtonSpinner -->
        <Style Selector="^ /template/ ButtonSpinner#PART_Spinner">
            <Setter Property="Theme" Value="{StaticResource MyNet.Theme.ButtonSpinner.Underline}" />
        </Style>

    </ControlTheme>

</ResourceDictionary>
