<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:my="http://mynet.com/avalonia"
                    xmlns:c="using:MyNet.Avalonia.Theme.Converters.Internals">

    <!-- --------------------------------------------------------- -->
    <!-- DEFAULT CLOCKTIMECOMPONENTCELL THEME                      -->
    <!-- --------------------------------------------------------- -->
    <ControlTheme x:Key="{x:Type my:ClockTimeComponentCell}" TargetType="my:ClockTimeComponentCell">
        <Setter Property="Background" Value="{Binding $parent[my:ClockTimeComponent].(my:ItemsAssist.Background)}" />
        <Setter Property="BorderBrush" Value="{Binding $parent[my:ClockTimeComponent].(my:ItemsAssist.BorderBrush)}" />
        <Setter Property="BorderThickness" Value="{Binding $parent[my:ClockTimeComponent].(my:ItemsAssist.BorderThickness)}" />
        <Setter Property="Foreground" Value="{Binding $parent[my:ClockTimeComponent].(my:ItemsAssist.Foreground)}" />
        <Setter Property="my:InteractionAssist.HoverBackground" Value="{Binding $parent[my:ClockTimeComponent].(my:ItemsAssist.HoverBackground)}" />
        <Setter Property="my:InteractionAssist.HoverBorderBrush" Value="{Binding $parent[my:ClockTimeComponent].(my:ItemsAssist.HoverBorderBrush)}" />
        <Setter Property="my:InteractionAssist.HoverForeground" Value="{Binding $parent[my:ClockTimeComponent].(my:ItemsAssist.HoverForeground)}" />
        <Setter Property="my:InteractionAssist.ActiveBackground" Value="{Binding $parent[my:ClockTimeComponent].(my:ItemsAssist.ActiveBackground)}" />
        <Setter Property="my:InteractionAssist.ActiveBorderBrush" Value="{Binding $parent[my:ClockTimeComponent].(my:ItemsAssist.ActiveBorderBrush)}" />
        <Setter Property="my:InteractionAssist.ActiveForeground" Value="{Binding $parent[my:ClockTimeComponent].(my:ItemsAssist.ActiveForeground)}" />
        <Setter Property="my:ShadowAssist.ShadowDepth" Value="{Binding $parent[my:ClockTimeComponent].(my:ItemsAssist.ShadowDepth)}" />
        <Setter Property="Margin" Value="-16" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsDot" Value="True" />
        <Setter Property="IsSelected" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Name="PART_RootPanel">

                    <Border Name="PART_ShadowBorder"
                            IsHitTestVisible="False"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource MyNet.Corners.Round}"
                            my:ShadowAssist.ShadowDepth="{TemplateBinding my:ShadowAssist.ShadowDepth}" />

                    <Ellipse Name="PART_MainEllipse"
                             Fill="{TemplateBinding Background}"
                             Stroke="{TemplateBinding BorderBrush}"
                             StrokeThickness="{Binding BorderThickness, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static my:ThicknessConverter.ToDouble.Left}}" />

                    <Ellipse Name="PART_ActiveEllipse"
                             Fill="{TemplateBinding my:InteractionAssist.ActiveBackground}"
                             Stroke="{TemplateBinding my:InteractionAssist.ActiveBorderBrush}"
                             StrokeThickness="{Binding BorderThickness, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static my:ThicknessConverter.ToDouble.Left}}"
                             Theme="{StaticResource MyNet.Theme.Ellipse.State}" />

                    <Ellipse Name="PART_HoverEllipse"
                             Fill="{TemplateBinding my:InteractionAssist.HoverBackground}"
                             Stroke="{TemplateBinding my:InteractionAssist.HoverBorderBrush}"
                             StrokeThickness="{Binding BorderThickness, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static my:ThicknessConverter.ToDouble.Left}}"
                             Theme="{StaticResource MyNet.Theme.Ellipse.State}" />

                    <ContentPresenter Name="PART_ContentPresenter"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      BackgroundSizing="{TemplateBinding BackgroundSizing}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Content="{TemplateBinding Value}"
                                      Foreground="{TemplateBinding Foreground}"
                                      RecognizesAccessKey="True"
                                      TextElement.FontSize="{TemplateBinding FontSize}"
                                      TextElement.FontWeight="{TemplateBinding FontWeight}"
                                      UseLayoutRounding="False" />
                </Panel>
            </ControlTemplate>
        </Setter>

        <!-- Hover -->
        <Style Selector="^:not(:disabled):pointerover">
            <Setter Property="Foreground" Value="{Binding $self.(my:InteractionAssist.HoverForeground)}" />

            <Style Selector="^.shadow-control /template/ Border#PART_ShadowBorder, ^.shadow-surface /template/ Border#PART_ShadowBorder">
                <Setter Property="my:ShadowAssist.Darken" Value="True" />
            </Style>

            <Style Selector="^ /template/ Ellipse#PART_HoverEllipse">
                <Setter Property="Opacity" Value="1" />
            </Style>
        </Style>

        <!-- Active (for button with state "selected") -->
        <Style Selector="^:selected, ^.Selected">
            <Setter Property="Foreground" Value="{Binding $self.(my:InteractionAssist.ActiveForeground)}" />

            <Style Selector="^.shadow-control /template/ Border#PART_ShadowBorder, ^.shadow-surface /template/ Border#PART_ShadowBorder">
                <Setter Property="my:ShadowAssist.Darken" Value="True" />
            </Style>

            <Style Selector="^ /template/ Ellipse#PART_ActiveEllipse">
                <Setter Property="Opacity" Value="1" />
            </Style>

        </Style>

        <Style Selector="^:dot /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="^:dot">
            <Setter Property="Margin" Value="-4" />
        </Style>
    </ControlTheme>

    <!-- --------------------------------------------------------- -->
    <!-- DEFAULT CLOCKTIMECOMPONENT THEME                          -->
    <!-- --------------------------------------------------------- -->
    <ControlTheme x:Key="{x:Type my:ClockTimeComponent}" TargetType="my:ClockTimeComponent">
        <Setter Property="my:ItemsAssist.Background" Value="{Binding $parent[my:ClockSelector].(my:ItemsAssist.Background)}" />
        <Setter Property="my:ItemsAssist.BorderBrush" Value="{Binding $parent[my:ClockSelector].(my:ItemsAssist.BorderBrush)}" />
        <Setter Property="my:ItemsAssist.BorderThickness" Value="{Binding $parent[my:ClockSelector].(my:ItemsAssist.BorderThickness)}" />
        <Setter Property="my:ItemsAssist.Foreground" Value="{Binding $parent[my:ClockSelector].(my:ItemsAssist.Foreground)}" />
        <Setter Property="my:ItemsAssist.HoverBackground" Value="{Binding $parent[my:ClockSelector].(my:ItemsAssist.HoverBackground)}" />
        <Setter Property="my:ItemsAssist.HoverBorderBrush" Value="{Binding $parent[my:ClockSelector].(my:ItemsAssist.HoverBorderBrush)}" />
        <Setter Property="my:ItemsAssist.HoverForeground" Value="{Binding $parent[my:ClockSelector].(my:ItemsAssist.HoverForeground)}" />
        <Setter Property="my:ItemsAssist.ActiveBackground" Value="{Binding $parent[my:ClockSelector].(my:ItemsAssist.ActiveBackground)}" />
        <Setter Property="my:ItemsAssist.ActiveBorderBrush" Value="{Binding $parent[my:ClockSelector].(my:ItemsAssist.ActiveBorderBrush)}" />
        <Setter Property="my:ItemsAssist.ActiveForeground" Value="{Binding $parent[my:ClockSelector].(my:ItemsAssist.ActiveForeground)}" />
        <Setter Property="my:ItemsAssist.ShadowDepth" Value="{Binding $parent[my:ClockSelector].(my:ItemsAssist.ShadowDepth)}" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="59" />
        <Setter Property="RadiusMultiplier" Value="0.8" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Name="PART_RootPanel">

                    <Ellipse Width="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static my:MathConverter.Multiply}, ConverterParameter=0.06}"
                             Height="{Binding Bounds.Height, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static my:MathConverter.Multiply}, ConverterParameter=0.06}"
                             Fill="{TemplateBinding CenterBackground}"
                             Stroke="{TemplateBinding CenterBorderBrush}"
                             StrokeThickness="{TemplateBinding CenterBorderThickness}" />

                    <Panel Name="PART_Pointer" Width="0" Height="0">
                        <Rectangle Name="PART_PointerPin" Fill="{TemplateBinding HandBrush}" UseLayoutRounding="False" VerticalAlignment="Top" Width="{TemplateBinding HandWidth}" />
                    </Panel>

                    <Canvas Name="PART_CellPanel" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- --------------------------------------------------------- -->
    <!-- DEFAULT CLOCKSELECTOR THEME                               -->
    <!-- --------------------------------------------------------- -->
    <ControlTheme x:Key="{x:Type my:ClockSelector}" TargetType="my:ClockSelector">
        <Setter Property="my:ThemeAssist.Category" Value="Navigation" />
        <Setter Property="HorizontalAlignment" Value="{StaticResource MyNet.HorizontalAlignment.Control}" />
        <Setter Property="VerticalAlignment" Value="{StaticResource MyNet.VerticalAlignment.Control}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="my:ShadowAssist.ShadowDepth" Value="Depth0" />
        <Setter Property="my:DisableAssist.IsDisablable" Value="True" />
        <Setter Property="my:TransitionsAssist.UseTransitions" Value="True" />

        <!-- Default colors -->
        <Setter Property="my:VariantAssist.DefaultBackground" Value="{my:ThemeContext Surface.Level3}" />
        <Setter Property="my:VariantAssist.DefaultBorderBrush" Value="{my:ThemeContext Surface.Border}" />
        <Setter Property="my:VariantAssist.DefaultForeground" Value="{my:ThemeContext Foreground.Primary}" />
        <Setter Property="my:VariantAssist.DefaultPrimary" Value="{my:ThemeContext Primary}" />

        <!-- Variant -->
        <Setter Property="my:VariantAssist.Background" Value="{my:ThemeRole Background}" />
        <Setter Property="my:VariantAssist.BorderBrush" Value="{my:ThemeRole BorderBrush}" />
        <Setter Property="my:VariantAssist.Foreground" Value="{my:ThemeRole Foreground, Contrast=True}" />
        <Setter Property="my:VariantAssist.Primary" Value="{my:ThemeRole Primary, Role=(my:ItemsAssist.Role)}" />
        <Setter Property="my:VariantAssist.BorderThickness" Value="1" />

        <!-- Surface -->
        <Setter Property="BorderThickness" Value="{Binding $self.(my:VariantAssist.BorderThickness)}" />
        <Setter Property="Background" Value="{Binding $self.(my:VariantAssist.Background)}" />
        <Setter Property="BorderBrush" Value="{Binding $self.(my:VariantAssist.BorderBrush)}" />
        <Setter Property="Foreground" Value="{Binding $self.(my:VariantAssist.Foreground)}" />
        <Setter Property="HandBrush" Value="{Binding $self.(my:VariantAssist.Primary)}" />
        <Setter Property="CenterBackground" Value="{Binding $self.(my:VariantAssist.Primary)}" />
        <Setter Property="CenterBorderBrush" Value="{Binding $self.(my:VariantAssist.Primary)}" />
        <Setter Property="CenterBorderThickness" Value="0" />

        <!-- Items -->
        <Setter Property="my:ItemsAssist.Background" Value="Transparent" />
        <Setter Property="my:ItemsAssist.BorderBrush" Value="Transparent" />
        <Setter Property="my:ItemsAssist.Foreground" Value="{my:Foreground}" />
        <Setter Property="my:ItemsAssist.BorderThickness" Value="0" />
        <Setter Property="my:ItemsAssist.HoverBackground" Value="{my:Foreground Opacity=Hover}" />
        <Setter Property="my:ItemsAssist.HoverBorderBrush" Value="Transparent" />
        <Setter Property="my:ItemsAssist.HoverForeground" Value="{my:Foreground}" />
        <Setter Property="my:ItemsAssist.ActiveBackground" Value="{Binding $self.(my:VariantAssist.Primary)}" />
        <Setter Property="my:ItemsAssist.ActiveForeground" Value="{my:ThemeBrush (my:ItemsAssist.ActiveBackground), Contrast=True}" />
        <Setter Property="my:ItemsAssist.RippleColor" Value="{my:ThemeBrush (my:ItemsAssist.ActiveForeground)}" />

        <Style Selector="^[(my|ItemsAssist.Role)=Contrast]">
            <Setter Property="my:ItemsAssist.ActiveBackground" Value="{my:Foreground}" />
        </Style>

        <Style Selector="^.role-contrast">
            <Setter Property="HandBrush" Value="{my:Foreground}" />
            <Setter Property="CenterBackground" Value="{my:Foreground}" />
            <Setter Property="CenterBorderBrush" Value="{my:Foreground}" />
        </Style>

        <Setter Property="Template">
            <ControlTemplate TargetType="my:ClockSelector">
                <Grid>
                    <Border IsHitTestVisible="False"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource MyNet.Corners.Round}"
                            my:ShadowAssist.ShadowDepth="{TemplateBinding my:ShadowAssist.ShadowDepth}" />
                    <Grid Margin="{TemplateBinding Padding}">
                        <Carousel x:Name="PART_Carousel" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Carousel.PageTransition>
                                <CompositePageTransition>
                                    <CrossFade Duration="{StaticResource MyNet.Animation.Fade}" />
                                </CompositePageTransition>
                            </Carousel.PageTransition>
                            <my:ClockTimeComponent x:Name="PART_Hour"
                                                   CellShiftNumber="{TemplateBinding TimeFormat, Converter={x:Static c:TimeFormatToCellShiftConverter.Default}}"
                                                   Minimum="{TemplateBinding TimeFormat, Converter={x:Static c:AmPmRangeConverter.Minimum}}"
                                                   Maximum="{TemplateBinding TimeFormat, Converter={x:Static c:AmPmRangeConverter.Maximum}}"
                                                   Value="{TemplateBinding Hour, Mode=TwoWay}"
                                                   CenterBackground="{TemplateBinding CenterBackground}"
                                                   CenterBorderBrush="{TemplateBinding CenterBorderBrush}"
                                                   CenterBorderThickness="{TemplateBinding CenterBorderThickness}"
                                                   HandWidth="{TemplateBinding HandWidth}"
                                                   HandBrush="{TemplateBinding HandBrush}" />
                            <my:ClockTimeComponent x:Name="PART_Minute"
                                                   Minimum="0"
                                                   Maximum="59"
                                                   Value="{TemplateBinding Minute, Mode=TwoWay}"
                                                   StepFrequency="5"
                                                   CenterBackground="{TemplateBinding CenterBackground}"
                                                   CenterBorderBrush="{TemplateBinding CenterBorderBrush}"
                                                   CenterBorderThickness="{TemplateBinding CenterBorderThickness}"
                                                   HandWidth="{TemplateBinding HandWidth}"
                                                   HandBrush="{TemplateBinding HandBrush}" />
                            <my:ClockTimeComponent x:Name="PART_Second"
                                                   Minimum="0"
                                                   Maximum="59"
                                                   Value="{TemplateBinding Second, Mode=TwoWay}"
                                                   StepFrequency="5"
                                                   CenterBackground="{TemplateBinding CenterBackground}"
                                                   CenterBorderBrush="{TemplateBinding CenterBorderBrush}"
                                                   CenterBorderThickness="{TemplateBinding CenterBorderThickness}"
                                                   HandWidth="{TemplateBinding HandWidth}"
                                                   HandBrush="{TemplateBinding HandBrush}"
                                                   IsEnabled="{TemplateBinding ShowSeconds}" />
                        </Carousel>
                    </Grid>
                </Grid>
            </ControlTemplate>
        </Setter>

    </ControlTheme>

</ResourceDictionary>
