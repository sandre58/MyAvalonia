<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:my="http://mynet.com/avalonia"
                    x:CompileBindings="True">
    <ControlTheme x:Key="MyNet.Theme.Button.Caption" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Margin" Value="0, 4" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Width" Value="28" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="my:PaletteAssist.Primary" Value="{my:Foreground AncestorType=TemplatedControl}" />
        <Setter Property="ContentTemplate" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{my:ThemeRole Opacity=High}" />
        <Setter Property="my:ThemeAssist.HoverBackground" Value="{my:Foreground, Opacity=Hover}" />
        <Setter Property="my:ThemeAssist.HoverForeground" Value="{my:Foreground}" />
        <Setter Property="my:ThemeAssist.RippleColor" Value="{my:Foreground}" />

        <Style Selector="^.Close">
            <Setter Property="my:ThemeAssist.HoverBackground" Value="{my:Theme Button.Close.Hover}" />
            <Setter Property="my:ThemeAssist.HoverForeground" Value="{my:Theme Button.Close.Hover, Contrast=True}" />
            <Setter Property="my:ThemeAssist.RippleColor" Value="{my:Theme Button.Close.Hover, Contrast=True}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type CaptionButtons}" TargetType="CaptionButtons">
        <Setter Property="Margin" Value="0 0 4 0" />
        <Setter Property="Template">
            <ControlTemplate TargetType="CaptionButtons">
                <StackPanel VerticalAlignment="Stretch"
                            Orientation="Horizontal"
                            Spacing="2"
                            TextElement.FontSize="10">
                    <Button Name="PART_FullScreenButton" Theme="{StaticResource MyNet.Theme.Button.Caption}" ToolTip.ShowDelay="1000">
                        <PathIcon Name="PART_FullScreenButtonIcon" Classes="ExtraSmall" Data="{StaticResource MyNet.Geometry.ArrowExpand}" />
                    </Button>
                    <Button Name="PART_MinimizeButton" Theme="{StaticResource MyNet.Theme.Button.Caption}" ToolTip.Tip="{my:LocTextBlock Minimize}">
                        <PathIcon Classes="ExtraSmall" Data="{StaticResource MyNet.Geometry.WindowMinimize}" />
                    </Button>
                    <Button Name="PART_RestoreButton" Theme="{StaticResource MyNet.Theme.Button.Caption}">
                        <PathIcon Name="PART_RestoreButtonIcon" Classes="ExtraSmall" Data="{StaticResource MyNet.Geometry.WindowMaximize}" />
                    </Button>
                    <Button Name="PART_CloseButton"
                            Classes="Close"
                            Theme="{StaticResource MyNet.Theme.Button.Caption}"
                            ToolTip.Tip="{my:LocTextBlock Close}">
                        <PathIcon Classes="ExtraSmall" Data="{StaticResource MyNet.Geometry.WindowClose}" />
                    </Button>
                </StackPanel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^">
            <Style Selector="^ /template/ Button#PART_RestoreButton">
                <Setter Property="ToolTip.Tip">
                    <Template>
                        <TextBlock Text="{my:Loc Maximize}" />
                    </Template>
                </Setter>
            </Style>
            <Style Selector="^ /template/ Button#PART_FullScreenButton">
                <Setter Property="ToolTip.Tip">
                    <Template>
                        <TextBlock Text="{my:Loc FullScreen}" />
                    </Template>
                </Setter>
            </Style>
        </Style>

        <Style Selector="^:maximized">

            <Style Selector="^ /template/ Button#PART_RestoreButton">
                <Setter Property="ToolTip.Tip">
                    <Template>
                        <TextBlock Text="{my:Loc Restore}" />
                    </Template>
                </Setter>
            </Style>

            <Style Selector="^ /template/ PathIcon#PART_RestoreButtonIcon">
                <Setter Property="Data" Value="{StaticResource MyNet.Geometry.WindowRestore}" />
            </Style>
        </Style>

        <Style Selector="^:fullscreen">
            <Style Selector="^ /template/ Button#PART_FullScreenButton">
                <Setter Property="ToolTip.Tip">
                    <Template>
                        <TextBlock Text="{my:Loc NoFullScreen}" />
                    </Template>
                </Setter>
            </Style>

            <Style Selector="^ /template/ PathIcon#PART_FullScreenButtonIcon">
                <Setter Property="Data" Value="{StaticResource MyNet.Geometry.ArrowCollapse}" />
            </Style>
            <Style Selector="^ /template/ Button#PART_RestoreButton">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^ /template/ Button#PART_MinimizeButton">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
