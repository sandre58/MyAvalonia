<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:MyNet.Avalonia.Theme.Converters.Internals"
                    xmlns:u="clr-namespace:MyNet.Utilities.DateTimes;assembly=MyNet.Utilities"
                    xmlns:my="http://mynet.com/avalonia"
                    x:CompileBindings="True">

    <ControlTheme x:Key="{x:Type my:NumericUpDownTimeComponent}" TargetType="my:NumericUpDownTimeComponent" BasedOn="{StaticResource {x:Type NumericUpDown}}">
        <Setter Property="ShowButtonSpinner" Value="False" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Width" Value="55" />

        <Style Selector="^[IsActive=False]">
            <Setter Property="Opacity" Value="{DynamicResource MyNet.Opacity.Medium}" />
        </Style>

        <Style Selector="^[IsActive=True]">
            <Setter Property="Opacity" Value="{DynamicResource MyNet.Opacity.Medium}" />
            <Setter Property="BorderThickness" Value="1" />

            <Style Selector="^ /template/ Border#PART_ActiveBorder">
                <Setter Property="Opacity" Value="1" />
            </Style>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type my:TimeView}" TargetType="my:TimeView">
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="MinHeight" Value="250" />
        <Setter Property="my:HeaderAssist.FontSize" Value="{StaticResource MyNet.Font.Size.H2}" />
        <Setter Property="my:HeaderAssist.FontWeight" Value="Normal" />
        
        <Setter Property="my:PaletteAssist.Primary" Value="{my:Theme Primary}" />

        <Setter Property="Template">
            <ControlTemplate TargetType="{x:Type my:TimeView}">
                <HeaderedContentControl my:PaletteAssist.Primary="{Binding $parent[my:TimeView].(my:PaletteAssist.Primary)}"
                                        my:ThemeAssist.Role="{Binding $parent[my:TimeView].(my:ThemeAssist.Role)}"
                                        Classes="Headered"
                                        Background="Transparent"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        my:HeaderAssist.HorizontalAlignment="Center"
                                        my:HeaderAssist.FontSize="{TemplateBinding my:HeaderAssist.FontSize}"
                                        my:HeaderAssist.FontWeight="{TemplateBinding my:HeaderAssist.FontWeight}">
                    <HeaderedContentControl.Header>
                        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" TextElement.Foreground="{my:ThemeRole Contrast=True, RelativeSource={RelativeSource Mode=TemplatedParent}}">
                            <my:NumericUpDownTimeComponent x:Name="PART_Hour"
                                                           Grid.Column="0"
                                                           my:ThemeAssist.Role="Inverse"
                                                           FormatString="{TemplateBinding NumberFormat}"
                                                           Value="{TemplateBinding Hour, Mode=TwoWay, Converter={x:Static my:IntToDecimalConverter.Default}}"
                                                           FontSize="{TemplateBinding my:HeaderAssist.FontSize}"
                                                           Minimum="{TemplateBinding TimeFormat, Converter={x:Static c:AmPmRangeConverter.Minimum}}"
                                                           Maximum="{TemplateBinding TimeFormat, Converter={x:Static c:AmPmRangeConverter.Maximum}}"
                                                           Increment="1"
                                                           IsActive="True" />
                            <ContentControl Content=":"
                                            Grid.Column="1"
                                            Margin="{my:Thickness Default, Horizontal}" />
                            <my:NumericUpDownTimeComponent x:Name="PART_Minute"
                                                           Grid.Column="2"
                                                           my:ThemeAssist.Role="Inverse"
                                                           FormatString="{TemplateBinding NumberFormat}"
                                                           FontSize="{TemplateBinding my:HeaderAssist.FontSize}"
                                                           Minimum="0"
                                                           Maximum="59"
                                                           Value="{TemplateBinding Minute, Mode=TwoWay, Converter={x:Static my:IntToDecimalConverter.Default}}"
                                                           Increment="1" />
                            <ContentControl Grid.Column="3"
                                            Content=":"
                                            Margin="{my:Thickness Default, Horizontal}"
                                            IsVisible="{TemplateBinding ShowSeconds}" />
                            <my:NumericUpDownTimeComponent x:Name="PART_Second"
                                                           Grid.Column="4"
                                                           my:ThemeAssist.Role="Inverse"
                                                           FontSize="{TemplateBinding my:HeaderAssist.FontSize}"
                                                           FormatString="{TemplateBinding NumberFormat}"
                                                           Minimum="0"
                                                           Maximum="59"
                                                           Increment="1"
                                                           Value="{TemplateBinding Second, Mode=TwoWay, Converter={x:Static my:IntToDecimalConverter.Default}}"
                                                           IsEnabled="{TemplateBinding ShowSeconds}"
                                                           IsVisible="{TemplateBinding ShowSeconds}"/>
                            <Separator Grid.Column="5" Margin="{my:Thickness Default, Horizontal}" IsVisible="{TemplateBinding TimeFormat, Converter={x:Static my:EnumConverter.Any}, ConverterParameter={x:Static u:TimeFormat.TwelveHour}}" />
                            <ListBox Grid.Column="6"
                                     FontSize="{TemplateBinding FontSize}"
                                     my:ThemeAssist.Role="Inverse"
                                     Classes="Cards Vertical Small"
                                     SelectedValue="{TemplateBinding IsAm, Mode=TwoWay}"
                                     SelectedValueBinding="{ReflectionBinding DataContext}"
                                     IsVisible="{TemplateBinding TimeFormat, Converter={x:Static my:EnumConverter.Any}, ConverterParameter={x:Static u:TimeFormat.TwelveHour}}">
                                <ListBoxItem DataContext="{x:True}" Content="{my:LocTextBlock Am, Casing=AllCaps}" />
                                <ListBoxItem DataContext="{x:False}" Content="{my:LocTextBlock Pm, Casing=AllCaps}" />
                            </ListBox>
                        </Grid>
                    </HeaderedContentControl.Header>
                    <my:ClockSelector x:Name="PART_ClockSelector"
                                      Classes="Solid Shadow"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Height="{Binding $self.Bounds.Width}"
                                      MinWidth="220"
                                      Hour="{TemplateBinding Hour, Mode=TwoWay}"
                                      Minute="{TemplateBinding Minute, Mode=TwoWay}"
                                      Second="{TemplateBinding Second, Mode=TwoWay}"
                                      my:ThemeAssist.Role="{TemplateBinding (my:ThemeAssist.Role)}"
                                      TimeFormat="{TemplateBinding TimeFormat}"
                                      ShowSeconds="{TemplateBinding ShowSeconds}"
                                      SelectedComponent="{TemplateBinding SelectedComponent, Mode=TwoWay}"
                                      IsAm="{TemplateBinding IsAm}" />
                </HeaderedContentControl>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
