<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="Visual.opacity-high">
        <Setter Property="Opacity" Value="{DynamicResource MyNet.Opacity.High}" />
    </Style>

    <Style Selector="Visual.opacity-medium">
        <Setter Property="Opacity" Value="{DynamicResource MyNet.Opacity.Medium}" />
    </Style>

    <Style Selector="Visual.opacity-low">
        <Setter Property="Opacity" Value="{DynamicResource MyNet.Opacity.Low}" />
    </Style>
</Styles>
