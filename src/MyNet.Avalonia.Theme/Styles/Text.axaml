<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Wrap -->
    <Style Selector="TextBlock.text-wrap">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="ContentPresenter.text-wrap">
        <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
    </Style>

    <!-- Legacy: parent class (Form label) -->
    <Style Selector=":is(Control).text-wrap TextBlock, :is(Control).text-wrapping TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Truncate -->
    <Style Selector="TextBlock.truncate">
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="ContentPresenter.truncate">
        <Setter Property="TextBlock.TextWrapping" Value="NoWrap" />
        <Setter Property="TextBlock.TextTrimming" Value="CharacterEllipsis" />
    </Style>
</Styles>
