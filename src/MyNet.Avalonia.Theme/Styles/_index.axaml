<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal">

    <StyleInclude Source="avares://MyNet.Avalonia.Theme/Styles/Rectangle.axaml" />
    <StyleInclude Source="avares://MyNet.Avalonia.Theme/Styles/Text.axaml" />

    <!-- Force the custom ToolTip theme on all tooltips, including those in
         non-client decoration popups that cannot resolve the implicit ControlTheme
         through the resource chain. -->
    <Style Selector="ToolTip">
        <Setter Property="Theme" Value="{DynamicResource {x:Type ToolTip}}" />
    </Style>
</Styles>
