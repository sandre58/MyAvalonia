<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:my="http://mynet.com/avalonia">

    <!-- ═════════════════════════════════════════════════════════ -->
    <!-- KINDS                                                     -->
    <!-- ═════════════════════════════════════════════════════════ -->

    <Style Selector=":is(HeaderedContentControl).kind-label">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{my:Foreground AncestorType=Control}" />
        <Setter Property="my:HeaderAssist.Foreground" Value="{my:Foreground AncestorType=Control}" />
        <Setter Property="my:HeaderAssist.Opacity" Value="{DynamicResource MyNet.Opacity.High}" />
        <Setter Property="my:HeaderAssist.Padding" Value="{my:Thickness Sm, Right}" />
        <Setter Property="my:HeaderAssist.FontWeight" Value="Normal" />
        <Setter Property="my:HeaderAssist.FontSize" Value="{Binding $self.FontSize}" />

        <Style Selector="^.variant-watermark">
            <Setter Property="my:HeaderAssist.FontSize" Value="{Binding $self.FontSize, Converter={x:Static my:MathConverter.Multiply}, ConverterParameter=0.75}" />
            <Setter Property="my:HeaderAssist.Foreground" Value="{my:Foreground}" />
            <Setter Property="my:HeaderAssist.Opacity" Value="{DynamicResource MyNet.Opacity.Medium}" />
        </Style>

        <Style Selector="^.position-left">
            <Setter Property="my:HeaderAssist.Padding" Value="{my:Thickness Sm, Right}" />
        </Style>

        <Style Selector="^.position-right">
            <Setter Property="my:HeaderAssist.Padding" Value="{my:Thickness Sm, Left}" />
        </Style>

        <Style Selector="^.position-top">
            <Setter Property="my:HeaderAssist.Padding" Value="{my:Thickness Sm, Bottom}" />
        </Style>

        <Style Selector="^.position-bottom">
            <Setter Property="my:HeaderAssist.Padding" Value="{my:Thickness Sm, Top}" />
        </Style>
    </Style>

    <!-- ═════════════════════════════════════════════════════════ -->
    <!-- VARIANTS                                                  -->
    <!-- ═════════════════════════════════════════════════════════ -->

    <Style Selector=":is(HeaderedContentControl).variant-underline">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{my:Foreground AncestorType=Control}" />
        <Setter Property="my:HeaderAssist.Background" Value="Transparent" />
        <Setter Property="my:HeaderAssist.BorderThickness" Value="0 0 0 1" />
        <Setter Property="my:HeaderAssist.BorderBrush" Value="{my:ThemeRole BorderBrush}" />
        <Setter Property="my:HeaderAssist.Foreground" Value="{my:Foreground}" />
        <Setter Property="my:HeaderAssist.Padding" Value="{my:Thickness Sm, Bottom}" />

        <Style Selector="^.variant-solid, ^.variant-outlined, ^.variant-light">
            <Setter Property="my:HeaderAssist.Margin" Value="{my:Thickness Md, Bottom=0}" />
        </Style>

        <Style Selector="^:not(.variant-solid):not(.variant-outlined):not(.variant-light)">
            <Setter Property="Padding" Value="{my:Thickness Md, Top}" />
        </Style>
    </Style>

    <Style Selector="my|Badge.context-contrast">
        <Setter Property="MaskBackground" Value="Transparent" />
    </Style>

</Styles>