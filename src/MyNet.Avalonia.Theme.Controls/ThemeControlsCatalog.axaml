<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MyNet.Avalonia.Theme.Controls.ThemeControlsCatalog">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://MyNet.Avalonia.Theme.Controls/Foundation/_index.axaml" />
                <ResourceInclude Source="avares://MyNet.Avalonia.Theme.Controls/Standard/_index.axaml" />
                <ResourceInclude Source="avares://MyNet.Avalonia.Theme.Controls/Custom/_index.axaml" />
                <ResourceInclude Source="avares://MyNet.Avalonia.Theme.Controls/Presets/_index.axaml" />
                <ResourceInclude Source="avares://MyNet.Avalonia.Theme.Controls/Resources/DataTemplates.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>