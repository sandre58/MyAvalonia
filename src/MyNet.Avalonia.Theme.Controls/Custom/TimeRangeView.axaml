<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:my="http://mynet.com/avalonia"
                    xmlns:loc="clr-namespace:MyNet.Avalonia.Controls.Localization;assembly=MyNet.Avalonia.Controls">

    <ControlTheme x:Key="{x:Type my:TimeRangeView}" TargetType="my:TimeRangeView">
        <Setter Property="my:ThemeAssist.Category" Value="Input" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />

        <Setter Property="Template">
            <ControlTemplate TargetType="my:TimeRangeView">
                <TabControl x:Name="PART_BoundarySelector"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Padding="0"
                            Classes="flex-uniform"
                            my:DisableAssist.IsDisablable="False"
                            my:ItemsAssist.Role="{TemplateBinding (my:ThemeAssist.Role)}"
                            my:VariantAssist.Primary="{my:Theme Primary}"
                            my:HeaderAssist.Padding="0">
                    <TabItem Header="{x:Static loc:TimeRangePickerExResources.Start}">
                        <my:TimeView x:Name="PART_StartTimeView"
                                     Margin="{StaticResource MyNet.Padding.Popup}"
                                     ShowClock="True"
                                     my:ThemeAssist.Role="{TemplateBinding (my:ThemeAssist.Role)}"
                                     my:ItemsAssist.Role="{TemplateBinding (my:ThemeAssist.Role)}"
                                     my:VariantAssist.DefaultPrimary="{my:Theme Primary}"
                                     Foreground="{TemplateBinding Foreground}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     NumberFormat="{TemplateBinding NumberFormat}"
                                     ShowSeconds="{TemplateBinding ShowSeconds}"
                                     TimeFormat="{TemplateBinding TimeFormat}" />
                    </TabItem>
                    <TabItem Header="{x:Static loc:TimeRangePickerExResources.End}">
                        <my:TimeView x:Name="PART_EndTimeView"
                                     Margin="{StaticResource MyNet.Padding.Popup}"
                                     ShowClock="True"
                                     my:ThemeAssist.Role="{TemplateBinding (my:ThemeAssist.Role)}"
                                     my:ItemsAssist.Role="{TemplateBinding (my:ThemeAssist.Role)}"
                                     my:VariantAssist.DefaultPrimary="{my:Theme Primary}"
                                     Foreground="{TemplateBinding Foreground}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     NumberFormat="{TemplateBinding NumberFormat}"
                                     ShowSeconds="{TemplateBinding ShowSeconds}"
                                     TimeFormat="{TemplateBinding TimeFormat}" />
                    </TabItem>
                </TabControl>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
