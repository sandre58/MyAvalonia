<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:my="http://mynet.com/avalonia"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:icons="clr-namespace:Material.Icons;assembly=Material.Icons">

    <ControlTheme x:Key="{x:Type my:MultiComboBoxItem}" TargetType="my:MultiComboBoxItem">
        <Setter Property="my:DisableAssist.IsDisablable" Value="True" />
        <Setter Property="my:TransitionsAssist.UseTransitions" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment"
                Value="{Binding $parent[my:MultiComboBox].(my:ItemsAssist.HorizontalAlignment)}" />
        <Setter Property="VerticalAlignment"
                Value="{Binding $parent[my:MultiComboBox].(my:ItemsAssist.VerticalAlignment)}" />
        <Setter Property="Margin" Value="{Binding $parent[my:MultiComboBox].(my:ItemsAssist.Margin)}" />
        <Setter Property="Padding" Value="{Binding $parent[my:MultiComboBox].(my:ItemsAssist.Padding)}" />
        <Setter Property="CornerRadius" Value="{Binding $parent[my:MultiComboBox].(my:ItemsAssist.CornerRadius)}" />
        <Setter Property="Background" Value="{Binding $parent[my:MultiComboBox].(my:ItemsAssist.Background)}" />
        <Setter Property="Foreground" Value="{Binding $parent[my:MultiComboBox].(my:ItemsAssist.Foreground)}" />
        <Setter Property="BorderBrush" Value="{Binding $parent[my:MultiComboBox].(my:ItemsAssist.BorderBrush)}" />
        <Setter Property="BorderThickness" Value="{Binding $parent[my:MultiComboBox].(my:ItemsAssist.BorderThickness)}" />
        <Setter Property="my:InteractionAssist.HoverBackground"
                Value="{Binding $parent[my:MultiComboBox].(my:ItemsAssist.HoverBackground)}" />
        <Setter Property="my:InteractionAssist.HoverBorderBrush"
                Value="{Binding $parent[my:MultiComboBox].(my:ItemsAssist.HoverBorderBrush)}" />
        <Setter Property="my:InteractionAssist.HoverForeground"
                Value="{Binding $parent[my:MultiComboBox].(my:ItemsAssist.HoverForeground)}" />
        <Setter Property="my:InteractionAssist.ActiveBackground"
                Value="{Binding $parent[my:MultiComboBox].(my:ItemsAssist.ActiveBackground)}" />
        <Setter Property="my:InteractionAssist.ActiveBorderBrush"
                Value="{Binding $parent[my:MultiComboBox].(my:ItemsAssist.ActiveBorderBrush)}" />
        <Setter Property="my:InteractionAssist.ActiveForeground"
                Value="{Binding $parent[my:MultiComboBox].(my:ItemsAssist.ActiveForeground)}" />
        <Setter Property="my:InteractionAssist.RippleColor"
                Value="{Binding $parent[my:MultiComboBox].(my:ItemsAssist.RippleColor)}" />
        <Setter Property="my:ShadowAssist.ShadowDepth"
                Value="{Binding $parent[my:MultiComboBox].(my:ItemsAssist.ShadowDepth)}" />
        <Setter Property="my:IconAssist.Alignment"
                Value="{Binding $parent[my:MultiComboBox].(my:IconAssist.Alignment)}" />
        <Setter Property="my:IconAssist.Spacing" Value="{Binding $parent[my:MultiComboBox].(my:IconAssist.Spacing)}" />
        <Setter Property="my:IconAssist.Opacity" Value="{Binding $parent[my:MultiComboBox].(my:IconAssist.Opacity)}" />
        <Setter Property="UseLayoutRounding" Value="False" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />

        <Setter Property="Template">
            <ControlTemplate TargetType="my:MultiComboBoxItem">
                <Panel Name="PART_RootPanel">

                    <Border Name="PART_MainBorder"
                            my:ShadowAssist.ShadowDepth="{TemplateBinding my:ShadowAssist.ShadowDepth}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}" />

                    <Border Name="PART_ActiveBorder"
                            Background="{TemplateBinding my:InteractionAssist.ActiveBackground}"
                            BorderBrush="{TemplateBinding my:InteractionAssist.ActiveBorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Theme="{StaticResource MyNet.Theme.Border.State}" />

                    <Border Name="PART_HoverBorder"
                            Background="{TemplateBinding my:InteractionAssist.HoverBackground}"
                            BorderBrush="{TemplateBinding my:InteractionAssist.HoverBorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Theme="{StaticResource MyNet.Theme.Border.State}" />

                    <Border ClipToBounds="True" CornerRadius="{TemplateBinding CornerRadius}">
                        <my:Ripple Name="PART_Ripple" RippleFill="{TemplateBinding my:InteractionAssist.RippleColor}">
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              BackgroundSizing="{TemplateBinding BackgroundSizing}"
                                              BorderThickness="{TemplateBinding BorderThickness}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              CornerRadius="{TemplateBinding CornerRadius}"
                                              Foreground="{TemplateBinding Foreground}"
                                              RecognizesAccessKey="True"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              UseLayoutRounding="False" />
                        </my:Ripple>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^.use-transitions">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Easing="LinearEasing" Property="Opacity"
                                      Duration="{StaticResource MyNet.Animation.Opacity}" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="TextBlock.TextWrapping" Value="NoWrap" />
            <Setter Property="TextBlock.TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- Hover -->
        <Style Selector="^:not(:disabled):pointerover">
            <Setter Property="Foreground" Value="{Binding $self.(my:InteractionAssist.HoverForeground)}" />


            <Style Selector="^ /template/ Border#PART_MainBorder">
                <Setter Property="my:ShadowAssist.Darken" Value="True" />
            </Style>

            <Style Selector="^ /template/ Border#PART_HoverBorder">
                <Setter Property="Opacity" Value="1" />
            </Style>
        </Style>

        <!-- Selected -->
        <Style Selector="^:selected">
            <Setter Property="Foreground" Value="{Binding $self.(my:InteractionAssist.ActiveForeground)}" />

            <Style Selector="^ /template/ Border#PART_MainBorder">
                <Setter Property="my:ShadowAssist.Darken" Value="True" />
            </Style>

            <Style Selector="^ /template/ Border#PART_ActiveBorder">
                <Setter Property="Opacity" Value="1" />
            </Style>

        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type my:MultiComboBoxSelectedItemList}" TargetType="my:MultiComboBoxSelectedItemList">
        <Setter Property="Template">
            <ControlTemplate TargetType="my:MultiComboBoxSelectedItemList">
                <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="MyNet.Theme.Tag.Embedded.MultiComboBox" TargetType="my:Tag"
                  BasedOn="{StaticResource {x:Type my:Tag}}">
        <Setter Property="Margin" Value="1" />
    </ControlTheme>

    <ControlTheme x:Key="{x:Type my:MultiComboBox}" TargetType="my:MultiComboBox">

        <!-- Common -->
        <Setter Property="my:ThemeAssist.Category" Value="Input" />
        <Setter Property="my:TransitionsAssist.UseTransitions" Value="True" />
        <Setter Property="my:DisableAssist.IsDisablable" Value="True" />
        <Setter Property="HorizontalAlignment" Value="{StaticResource MyNet.HorizontalAlignment.Control}" />
        <Setter Property="VerticalAlignment" Value="{StaticResource MyNet.VerticalAlignment.Control}" />
        <Setter Property="CornerRadius" Value="{StaticResource MyNet.Corners.Control}" />
        <Setter Property="FontSize" Value="{StaticResource MyNet.Font.Size.Input}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="BackgroundSizing" Value="OuterBorderEdge" />
        <Setter Property="Padding" Value="{StaticResource MyNet.Padding.Input.Md}" />
        <Setter Property="MinHeight" Value="{StaticResource MyNet.Height.Input.Md}" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ScrollViewer.IsScrollChainingEnabled" Value="True" />
        <Setter Property="my:IconAssist.Alignment" Value="Left" />
        <Setter Property="my:IconAssist.Spacing" Value="{StaticResource MyNet.Spacing.Icon}" />
        <Setter Property="my:IconAssist.Opacity" Value="{DynamicResource MyNet.Opacity.High}" />
        <Setter Property="my:InputAssist.InnerFontSize" Value="{Binding $self.FontSize}" />
        <Setter Property="my:InputAssist.InnerPadding" Value="{StaticResource MyNet.Padding.Input.Inner.Md}" />
        <Setter Property="my:InputAssist.UnderFontSize" Value="{StaticResource MyNet.Font.Size.Sm}" />
        <Setter Property="my:InputAssist.PlaceholderFontSize" Value="{Binding $self.FontSize}" />
        <Setter Property="my:InputAssist.FloatingScale" Value="0.75" />
        <Setter Property="my:InputAssist.FloatingOffset" Value="12" />
        <Setter Property="my:ProxyBehavior.Enable" Value="True" />
        <Setter Property="my:ValidationAssist.Theme" Value="{StaticResource {x:Type DataValidationErrors}}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />

        <!-- Specific -->
        <Setter Property="InputMethod.IsInputMethodEnabled" Value="True" />
        <Setter Property="PlaceholderText" Value="{x:Static sys:String.Empty}" />
        <Setter Property="MaxDropDownHeight" Value="350" />
        <Setter Property="MaxSelectionBoxHeight" Value="270" />
        <Setter Property="my:ItemsSearchBehavior.IsEnabled" Value="False" />
        <Setter Property="my:ItemsSearchBehavior.TextBoxTheme"
                Value="{StaticResource MyNet.Theme.TextBox.Embedded.Popup.Search}" />
        <Setter Property="my:ItemsSearchAssist.PlaceholderText"
                Value="{my:Loc SearchPlaceholder, Filename=ItemsSearchResources}" />
        <Setter Property="SelectedItemContainerTheme" Value="{StaticResource MyNet.Theme.Tag.Embedded.MultiComboBox}" />
        <Setter Property="my:ItemsAssist.HorizontalAlignment" Value="Stretch" />
        <Setter Property="my:ItemsAssist.VerticalAlignment" Value="Stretch" />
        <Setter Property="my:ItemsAssist.Margin" Value="0 1" />
        <Setter Property="my:ItemsAssist.Padding" Value="{StaticResource MyNet.Padding.ListBoxItem}" />
        <Setter Property="my:ItemsAssist.CornerRadius" Value="{StaticResource MyNet.Corners.Control}" />
        <Setter Property="my:ItemsAssist.ShadowDepth" Value="Depth0" />

        <!-- Default -->
        <Setter Property="my:VariantAssist.DefaultPrimary" Value="{my:ThemeContext Primary}" />
        <Setter Property="my:VariantAssist.Background" Value="{my:ThemeContext Surface.Level2}" />
        <Setter Property="my:VariantAssist.BorderBrush" Value="{my:ThemeContext Control.Border}" />
        <Setter Property="my:VariantAssist.Foreground" Value="{my:ThemeContext Foreground.Primary}" />
        <Setter Property="my:VariantAssist.Primary" Value="{my:ThemeRole Primary}" />
        <Setter Property="my:VariantAssist.BorderThickness" Value="1" />

        <!-- Theme -->
        <Setter Property="BorderThickness" Value="{Binding $self.(my:VariantAssist.BorderThickness)}" />
        <Setter Property="Background" Value="{Binding $self.(my:VariantAssist.Background)}" />
        <Setter Property="BorderBrush" Value="{Binding $self.(my:VariantAssist.BorderBrush)}" />
        <Setter Property="Foreground" Value="{Binding $self.(my:VariantAssist.Foreground)}" />
        <Setter Property="my:InputAssist.UnderForeground" Value="{my:Foreground Opacity=High}" />
        <Setter Property="my:InputAssist.InnerForeground" Value="{my:Foreground Opacity=High}" />
        <Setter Property="my:InputAssist.PlaceholderForeground" Value="{my:Foreground Opacity=Medium}" />
        <Setter Property="my:InteractionAssist.HoverBackground" Value="{my:Foreground Opacity=Hover}" />
        <Setter Property="my:InteractionAssist.HoverBorderBrush" Value="{my:ThemeContext Control.Border.Hover}" />
        <Setter Property="my:InteractionAssist.HoverForeground" Value="{my:Foreground}" />
        <Setter Property="my:InteractionAssist.RippleColor" Value="{my:Foreground}" />
        <Setter Property="my:InteractionAssist.ActiveBackground" Value="{my:Foreground Opacity=Focus}" />
        <Setter Property="my:InteractionAssist.ActiveForeground" Value="{Binding $self.(my:VariantAssist.Primary)}" />
        <Setter Property="my:InteractionAssist.ActiveBorderBrush" Value="{Binding $self.(my:VariantAssist.Primary)}" />
        <Setter Property="my:PopupAssist.Background" Value="{my:ThemeContext Surface.Popup}" />
        <Setter Property="my:PopupAssist.Role" Value="{Binding $self.(my:ThemeAssist.Role)}" />
        <Setter Property="my:ItemsAssist.Background" Value="Transparent" />
        <Setter Property="my:ItemsAssist.BorderBrush" Value="Transparent" />
        <Setter Property="my:ItemsAssist.BorderThickness" Value="0" />
        <Setter Property="my:ItemsAssist.Foreground" Value="{my:ThemeBrush (my:PopupAssist.Background), Contrast=True}" />
        <Setter Property="my:ItemsAssist.HoverBackground"
                Value="{my:ThemeBrush (my:PopupAssist.Background), Opacity=Hover, Contrast=True}" />
        <Setter Property="my:ItemsAssist.HoverBorderBrush" Value="Transparent" />
        <Setter Property="my:ItemsAssist.HoverForeground"
                Value="{my:ThemeBrush (my:PopupAssist.Background), Contrast=True}" />
        <Setter Property="my:ItemsAssist.ActiveBackground" Value="{my:ThemeRole Primary, Role='(my:PopupAssist.Role)'}" />
        <Setter Property="my:ItemsAssist.ActiveForeground"
                Value="{my:ThemeBrush (my:ItemsAssist.ActiveBackground), Contrast=True}" />
        <Setter Property="my:ItemsAssist.RippleColor"
                Value="{my:ThemeBrush (my:PopupAssist.Background), Contrast=True}" />

        <Setter Property="Template">
            <ControlTemplate TargetType="my:MultiComboBox">
                <DataValidationErrors Name="PART_DataValidation" Theme="{TemplateBinding my:ValidationAssist.Theme}">
                    <Panel Name="PART_RootPanel">

                        <Border Name="PART_MainBorder"
                                my:ShadowAssist.ShadowDepth="{TemplateBinding my:ShadowAssist.ShadowDepth}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" />

                        <Border Name="PART_HoverBorder"
                                Background="{TemplateBinding my:InteractionAssist.HoverBackground}"
                                BorderBrush="{TemplateBinding my:InteractionAssist.HoverBorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Theme="{StaticResource MyNet.Theme.Border.State}" />

                        <Border Name="PART_ActiveBorder"
                                Background="{TemplateBinding my:InteractionAssist.ActiveBackground}"
                                BorderBrush="{TemplateBinding my:InteractionAssist.ActiveBorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Theme="{StaticResource MyNet.Theme.Border.State}" />

                        <Border ClipToBounds="True" CornerRadius="{TemplateBinding CornerRadius}">
                            <my:Ripple Name="PART_Ripple"
                                       RippleFill="{TemplateBinding my:InteractionAssist.RippleColor}">
                                <Grid Name="PART_Grid" Margin="{TemplateBinding Padding}"
                                      ColumnDefinitions="Auto,*,Auto,Auto,Auto">

                                    <!-- Icon -->
                                    <ContentControl x:Name="PART_Adornment"
                                                    Grid.Column="0"
                                                    Margin="{TemplateBinding (my:IconAssist.Spacing), Converter={x:Static my:ThicknessFromDoubleConverter.Right}}"
                                                    VerticalAlignment="Stretch"
                                                    my:IconAssist.Role="Label"
                                                    Content="{TemplateBinding (my:IconAssist.Icon)}"
                                                    ContentTemplate="{TemplateBinding (my:IconAssist.IconTemplate)}"
                                                    Focusable="False"
                                                    Opacity="{TemplateBinding (my:IconAssist.Opacity)}">
                                        <ContentControl.IsVisible>
                                            <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                                <Binding Converter="{x:Static ObjectConverters.IsNotNull}"
                                                         Path="(my:IconAssist.Icon)"
                                                         RelativeSource="{RelativeSource TemplatedParent}" />
                                                <Binding Converter="{x:Static ObjectConverters.IsNotNull}"
                                                         Path="(my:IconAssist.IconTemplate)"
                                                         RelativeSource="{RelativeSource TemplatedParent}" />
                                            </MultiBinding>
                                        </ContentControl.IsVisible>
                                    </ContentControl>

                                    <my:InputChrome Name="PART_Input"
                                                    Grid.Column="1"
                                                    Padding="{TemplateBinding (my:InputAssist.InnerPadding)}"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Center"
                                                    ActiveForeground="{TemplateBinding (my:InteractionAssist.ActiveForeground)}"
                                                    FloatingOffset="{TemplateBinding (my:InputAssist.FloatingOffset)}"
                                                    FloatingScale="{TemplateBinding (my:InputAssist.FloatingScale)}"
                                                    InactiveForeground="{TemplateBinding (my:InputAssist.PlaceholderForeground)}"
                                                    InnerFontSize="{TemplateBinding (my:InputAssist.InnerFontSize)}"
                                                    InnerForeground="{TemplateBinding (my:InputAssist.InnerForeground)}"
                                                    InnerLeftContent="{TemplateBinding (my:InputAssist.InnerLeftContent)}"
                                                    InnerRightContent="{TemplateBinding (my:InputAssist.InnerRightContent)}"
                                                    Proxy="{TemplateBinding (my:ProxyBehavior.Proxy)}"
                                                    UseFloatingPlaceholder="{TemplateBinding (my:InputAssist.UseFloatingPlaceholder)}"
                                                    PlaceholderText="{TemplateBinding PlaceholderText}"
                                                    PlaceholderFontSize="{TemplateBinding (my:InputAssist.PlaceholderFontSize)}">

                                        <ScrollViewer MaxHeight="{TemplateBinding MaxSelectionBoxHeight}"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <my:MultiComboBoxSelectedItemList VerticalAlignment="Center"
                                                                              ItemContainerTheme="{TemplateBinding SelectedItemContainerTheme}"
                                                                              ItemTemplate="{TemplateBinding SelectedItemTemplate}"
                                                                              ItemsSource="{TemplateBinding SelectedItems}"
                                                                              RemoveCommand="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Remove}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Background="Transparent" Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </my:MultiComboBoxSelectedItemList>
                                        </ScrollViewer>

                                    </my:InputChrome>

                                    <!-- Clear button -->
                                    <Button Name="PART_ClearButton"
                                            Grid.Column="2"
                                            Classes="kind-tool is-stretch"
                                            my:DisableAssist.IsDisablable="False"
                                            Command="{Binding $parent[my:MultiComboBox].UnselectAll}"
                                            Content="{my:MaterialIcon Close}"
                                            IsVisible="False" />

                                    <!-- DropDown Glyph -->
                                    <PathIcon Name="PART_ExpanderIcon"
                                              Grid.Column="4"
                                              Margin="4 0 8 0"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Classes="kind-glyph is-dropdown"
                                              Focusable="False"
                                              IsHitTestVisible="False"
                                              Opacity="{DynamicResource MyNet.Opacity.Medium}"
                                              UseLayoutRounding="False" />
                                </Grid>
                            </my:Ripple>
                        </Border>

                        <!-- UnderText -->
                        <Border Name="PART_BorderUnderText">
                            <TextBlock Name="PART_UnderText"
                                       Margin="0 0 0 -15"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Bottom"
                                       FontSize="{TemplateBinding (my:InputAssist.UnderFontSize)}"
                                       FontStyle="{TemplateBinding (my:InputAssist.UnderFontStyle)}"
                                       FontWeight="{TemplateBinding (my:InputAssist.UnderFontWeight)}"
                                       Foreground="{TemplateBinding (my:InputAssist.UnderForeground)}"
                                       IsVisible="{Binding (my:InputAssist.UnderText), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static my:NullConverter.IsPresent}}"
                                       Text="{TemplateBinding (my:InputAssist.UnderText)}" />
                        </Border>

                        <Panel Name="PART_PopupContainer">
                            <Popup Name="PART_Popup"
                                   my:PopupBehavior.EnableSlide="True"
                                   MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                   HorizontalOffset="-2"
                                   InheritsTransform="True"
                                   IsLightDismissEnabled="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                                   MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="BottomEdgeAlignedLeft"
                                   PlacementTarget="PART_MainBorder"
                                   WindowManagerAddShadowHint="False">
                                <Border
                                    MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                                    HorizontalAlignment="Stretch"
                                    Theme="{StaticResource MyNet.Theme.Border.Popup}"
                                    Background="{TemplateBinding (my:PopupAssist.Background)}">
                                    <Border HorizontalAlignment="Stretch" ClipToBounds="True"
                                            CornerRadius="{StaticResource MyNet.Corners.Popup}">
                                        <Grid HorizontalAlignment="Stretch"
                                              RowDefinitions="Auto,Auto,*"
                                              TextElement.Foreground="{my:ThemeBrush (my:PopupAssist.Background), RelativeSource={RelativeSource TemplatedParent}, Contrast=True}">
                                            <TextBox Name="PART_SearchBox"
                                                     Grid.Row="0"
                                                     Classes="kind-embedded-search"
                                                     HorizontalAlignment="Stretch"
                                                     IsVisible="{TemplateBinding (my:ItemsSearchBehavior.IsEnabled)}"
                                                     PlaceholderText="{TemplateBinding (my:ItemsSearchAssist.PlaceholderText)}"
                                                     Text="{TemplateBinding (my:ItemsSearchBehavior.Text), Mode=TwoWay}"
                                                     Theme="{TemplateBinding (my:ItemsSearchBehavior.TextBoxTheme)}" />
                                            <Separator Grid.Row="1"
                                                       IsVisible="{TemplateBinding (my:ItemsSearchBehavior.IsEnabled)}" />
                                            <my:PlaceholderContentControl Name="PART_SearchPlaceholder"
                                                                          Grid.Row="2"
                                                                          HorizontalAlignment="Stretch"
                                                                          Classes="variant-watermark size-sm"
                                                                          my:IconAssist.Icon="{x:Static icons:MaterialIconKind.FileSearchOutline}"
                                                                          my:PlaceholderAssist.MinHeight="60"
                                                                          my:PlaceholderAssist.Padding="{StaticResource MyNet.Padding.Surface}"
                                                                          PlaceholderText="{my:Loc NoResults, Filename=ItemsSearchResources}">
                                                <DockPanel>
                                                    <Button HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            my:IconAssist.Icon="{my:MaterialIcon CheckAll}"
                                                            Command="{Binding $parent[my:MultiComboBox].SelectAll}"
                                                            Content="{my:Loc SelectAll}"
                                                            Margin="{my:Thickness Sm, Horizontal}"
                                                            DockPanel.Dock="Top"
                                                            FontSize="{Binding $parent[TemplatedControl].FontSize}"
                                                            IsVisible="{TemplateBinding ShowSelectAll}"
                                                            Classes="variant-text"
                                                            my:ThemeAssist.Role="Contrast" />
                                                    <Separator DockPanel.Dock="Top"
                                                               IsVisible="{TemplateBinding ShowSelectAll}" />
                                                    <ScrollViewer Name="PART_SearchItems"
                                                                  Theme="{StaticResource MyNet.Theme.ScrollViewer.Embedded.Popup}">
                                                        <ItemsPresenter Name="PART_ItemsPresenter"
                                                                        Grid.IsSharedSizeScope="True"
                                                                        ItemsPanel="{TemplateBinding ItemsPanel}"
                                                                        KeyboardNavigation.TabNavigation="Continue" />
                                                    </ScrollViewer>
                                                </DockPanel>
                                            </my:PlaceholderContentControl>
                                        </Grid>
                                    </Border>
                                </Border>
                            </Popup>
                        </Panel>
                    </Panel>
                </DataValidationErrors>
            </ControlTemplate>
        </Setter>

        <Style Selector="^.use-transitions /template/ PathIcon#PART_ExpanderIcon">
            <Setter Property="my:TransitionsAssist.Transitions">
                <Transitions>
                    <DoubleTransition Easing="LinearEasing" Property="Opacity"
                                      Duration="{StaticResource MyNet.Animation.Opacity}" />
                    <BrushTransition Easing="LinearEasing" Property="Foreground"
                                     Duration="{StaticResource MyNet.Animation.Opacity}" />
                    <TransformOperationsTransition Property="RenderTransform"
                                                   Duration="{StaticResource MyNet.Animation.Glyph}" />
                </Transitions>
            </Setter>
        </Style>

        <!-- Layout -->
        <Style Selector="^ /template/ ContentControl#PART_Adornment">
            <Setter Property="my:IconAssist.Size" Value="{StaticResource MyNet.Size.Icon.Sm}" />
        </Style>

        <Style Selector="^.icon-right, ^.button-right">
            <Style Selector="^ /template/ ContentControl#PART_Adornment">
                <Setter Property="Grid.Column" Value="3" />
            </Style>
        </Style>

        <Style Selector="^.icon-right /template/ ContentControl#PART_Adornment">
            <Setter Property="Margin"
                    Value="{Binding (my:IconAssist.Spacing), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static my:ThicknessFromDoubleConverter.Left}}" />
        </Style>

        <Style Selector="^.button-right /template/ ContentControl#PART_Adornment">
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style Selector="^[(my|InputAssist.UseFloatingPlaceholder)=True]">
            <Style Selector="^ /template/ my|InputChrome#PART_Input">
                <Setter Property="Margin"
                        Value="{Binding (my:InputAssist.FloatingOffset), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static my:ThicknessFromDoubleConverter.Top}}" />
            </Style>
            <Style Selector="^ /template/ Button#PART_ClearButton">
                <Setter Property="Padding" Value="{my:Thickness Sm}" />
            </Style>
        </Style>

        <!-- With clear button -->
        <Style Selector="^[(my|InputAssist.ShowClearButton)=True]">
            <Style Selector="^[(my|ProxyBehavior.IsEmpty)=False] /template/ Button#PART_ClearButton">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </Style>

        <!-- Hover -->
        <Style Selector="^:not(:disabled):not(:focus-within):pointerover">
            <Style Selector="^ /template/ Border#PART_HoverBorder">
                <Setter Property="Opacity" Value="1" />
            </Style>
            <Style Selector="^ /template/ PathIcon#PART_ExpanderIcon">
                <Setter Property="Opacity" Value="1" />
            </Style>
        </Style>

        <!-- Focused -->
        <Style Selector="^:focus-within, ^:flyout-open">
            <Setter Property="BorderThickness" Value="1" />

            <Style Selector="^ /template/ Border#PART_ActiveBorder">
                <Setter Property="Opacity" Value="1" />
            </Style>

            <Style Selector="^ /template/ PathIcon#PART_ExpanderIcon">
                <Setter Property="Foreground"
                        Value="{Binding $parent[my:MultiComboBox].(my:InteractionAssist.ActiveBorderBrush)}" />
                <Setter Property="Opacity" Value="1" />
            </Style>
        </Style>

        <!-- DropDownOpen -->
        <Style Selector="^:flyout-open">
            <Style Selector="^ /template/ PathIcon#PART_ExpanderIcon">
                <Setter Property="RenderTransform" Value="rotate(180deg)" />
            </Style>
        </Style>

        <!-- Error -->
        <Style Selector="^:error">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{my:Theme Validation.Error}" />
            <Setter Property="my:InteractionAssist.HoverBorderBrush" Value="{my:Theme Validation.Error}" />
            <Setter Property="my:InteractionAssist.ActiveBorderBrush" Value="{my:Theme Validation.Error}" />
            <Setter Property="my:InteractionAssist.ActiveForeground" Value="{my:Theme Validation.Error}" />

            <Style Selector="^ /template/ my|Underline#PART_Underline">
                <Setter Property="ActiveBrush" Value="{my:Theme Validation.Error}" />
            </Style>

            <Style Selector="^ /template/ Border#PART_BorderUnderText">
                <Setter Property="IsVisible" Value="False" />
            </Style>

            <Style Selector="^ /template/ PathIcon#PART_ExpanderIcon">
                <Setter Property="Foreground" Value="{my:Theme Validation.Error}" />
                <Setter Property="Opacity" Value="1" />
            </Style>
        </Style>

        <!-- ????????????????????????????????????????????????????????? -->
        <!-- SIZES                                                     -->
        <!-- ????????????????????????????????????????????????????????? -->

        <Style Selector="^.size-sm">
            <Setter Property="MinHeight" Value="{StaticResource MyNet.Height.Input.Sm}" />

            <Style Selector="^ /template/ ContentControl#PART_Adornment">
                <Setter Property="my:IconAssist.Size" Value="{StaticResource MyNet.Size.Icon.Xs}" />
            </Style>
        </Style>

        <Style Selector="^.size-lg">
            <Setter Property="MinHeight" Value="{StaticResource MyNet.Height.Input.Lg}" />

            <Style Selector="^ /template/ ContentControl#PART_Adornment">
                <Setter Property="my:IconAssist.Size" Value="{StaticResource MyNet.Size.Icon.Lg}" />
            </Style>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="MyNet.Theme.MultiComboBox.Underline" TargetType="my:MultiComboBox"
                  BasedOn="{StaticResource {x:Type my:MultiComboBox}}">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="{StaticResource MyNet.Padding.Input.Underline.Md}" />
        <Setter Property="my:InputAssist.InnerPadding" Value="{StaticResource MyNet.Padding.Input.Underline.Inner.Md}" />
        <Setter Property="my:InputAssist.UseFloatingPlaceholder" Value="True" />

        <!-- Default colors -->
        <Setter Property="my:VariantAssist.Background" Value="Transparent" />

        <!-- Default Theme -->
        <Setter Property="BorderThickness" Value="0 0 0 1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="my:InteractionAssist.HoverBackground" Value="Transparent" />
        <Setter Property="my:InteractionAssist.ActiveBackground" Value="Transparent" />
        <Setter Property="my:InteractionAssist.RippleColor" Value="Transparent" />

        <Setter Property="Template">
            <ControlTemplate TargetType="my:MultiComboBox">
                <DataValidationErrors Name="PART_DataValidation" Theme="{TemplateBinding my:ValidationAssist.Theme}">
                    <Panel Name="PART_RootPanel">

                        <Border Name="PART_MainBorder"
                                my:ShadowAssist.ShadowDepth="{TemplateBinding my:ShadowAssist.ShadowDepth}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" />

                        <Border Name="PART_HoverBorder"
                                Background="{TemplateBinding my:InteractionAssist.HoverBackground}"
                                BorderBrush="{TemplateBinding my:InteractionAssist.HoverBorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Theme="{StaticResource MyNet.Theme.Border.State}" />

                        <Border ClipToBounds="False">
                            <Grid Margin="{TemplateBinding Padding}" ColumnDefinitions="Auto,*,Auto,Auto,Auto">

                                <!-- Icon -->
                                <ContentControl x:Name="PART_Adornment"
                                                Grid.Column="0"
                                                Margin="{TemplateBinding (my:IconAssist.Spacing), Converter={x:Static my:ThicknessFromDoubleConverter.Right}}"
                                                VerticalAlignment="Stretch"
                                                my:IconAssist.Role="Label"
                                                Content="{TemplateBinding (my:IconAssist.Icon)}"
                                                ContentTemplate="{TemplateBinding (my:IconAssist.IconTemplate)}"
                                                Focusable="False"
                                                Opacity="{TemplateBinding (my:IconAssist.Opacity)}">
                                    <ContentControl.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                            <Binding Converter="{x:Static ObjectConverters.IsNotNull}"
                                                     Path="(my:IconAssist.Icon)"
                                                     RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Converter="{x:Static ObjectConverters.IsNotNull}"
                                                     Path="(my:IconAssist.IconTemplate)"
                                                     RelativeSource="{RelativeSource TemplatedParent}" />
                                        </MultiBinding>
                                    </ContentControl.IsVisible>
                                </ContentControl>

                                <my:InputChrome Name="PART_Input" Grid.Column="1"
                                                Padding="{TemplateBinding (my:InputAssist.InnerPadding)}"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                ActiveForeground="{TemplateBinding (my:InteractionAssist.ActiveForeground)}"
                                                FloatingOffset="{TemplateBinding (my:InputAssist.FloatingOffset)}"
                                                FloatingScale="{TemplateBinding (my:InputAssist.FloatingScale)}"
                                                InactiveForeground="{TemplateBinding (my:InputAssist.PlaceholderForeground)}"
                                                InnerFontSize="{TemplateBinding (my:InputAssist.InnerFontSize)}"
                                                InnerForeground="{TemplateBinding (my:InputAssist.InnerForeground)}"
                                                InnerLeftContent="{TemplateBinding (my:InputAssist.InnerLeftContent)}"
                                                InnerRightContent="{TemplateBinding (my:InputAssist.InnerRightContent)}"
                                                Proxy="{TemplateBinding (my:ProxyBehavior.Proxy)}"
                                                UseFloatingPlaceholder="{TemplateBinding (my:InputAssist.UseFloatingPlaceholder)}"
                                                PlaceholderText="{TemplateBinding PlaceholderText}"
                                                PlaceholderFontSize="{TemplateBinding (my:InputAssist.PlaceholderFontSize)}">

                                    <ScrollViewer MaxHeight="{TemplateBinding MaxSelectionBoxHeight}"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <my:MultiComboBoxSelectedItemList VerticalAlignment="Center"
                                                                          ItemContainerTheme="{TemplateBinding SelectedItemContainerTheme}"
                                                                          ItemTemplate="{TemplateBinding SelectedItemTemplate}"
                                                                          ItemsSource="{TemplateBinding SelectedItems}"
                                                                          RemoveCommand="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Remove}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Background="Transparent" Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </my:MultiComboBoxSelectedItemList>
                                    </ScrollViewer>

                                </my:InputChrome>

                                <!-- Clear button -->
                                <Button Name="PART_ClearButton"
                                        Grid.Column="2"
                                        Margin="{my:Thickness Xs, Left}"
                                        Classes="kind-tool"
                                        my:DisableAssist.IsDisablable="False"
                                        Command="{Binding $parent[my:MultiComboBox].UnselectAll}"
                                        Content="{my:MaterialIcon Close}"
                                        IsVisible="False" />

                                <!-- Glyph -->
                                <PathIcon Name="PART_ExpanderIcon"
                                          Grid.Column="4"
                                          Margin="4 0 8 0"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Classes="kind-glyph is-dropdown"
                                          Focusable="False"
                                          IsHitTestVisible="False"
                                          Opacity="{DynamicResource MyNet.Opacity.Medium}"
                                          UseLayoutRounding="False" />
                            </Grid>
                        </Border>

                        <!-- Underline -->
                        <my:Underline x:Name="PART_Underline"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Bottom"
                                      ActiveBrush="{TemplateBinding my:InteractionAssist.ActiveBorderBrush}"
                                      ActiveHeight="2"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      CornerRadius="0"
                                      Focusable="False"
                                      InactiveHeight="0"
                                      IsHitTestVisible="False"
                                      Opacity="1" />

                        <!-- UnderText -->
                        <Border Name="PART_BorderUnderText">
                            <TextBlock Name="PART_UnderText"
                                       Margin="0 0 0 -15"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Bottom"
                                       FontSize="{TemplateBinding (my:InputAssist.UnderFontSize)}"
                                       FontStyle="{TemplateBinding (my:InputAssist.UnderFontStyle)}"
                                       FontWeight="{TemplateBinding (my:InputAssist.UnderFontWeight)}"
                                       Foreground="{TemplateBinding (my:InputAssist.UnderForeground)}"
                                       IsVisible="{Binding (my:InputAssist.UnderText), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static my:NullConverter.IsPresent}}"
                                       Text="{TemplateBinding (my:InputAssist.UnderText)}" />
                        </Border>

                        <Panel Name="PART_PopupContainer">
                            <Popup Name="PART_Popup"
                                   my:PopupBehavior.EnableSlide="True"
                                   MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                   HorizontalOffset="-2"
                                   InheritsTransform="True"
                                   IsLightDismissEnabled="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                                   MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="BottomEdgeAlignedLeft"
                                   PlacementTarget="PART_MainBorder"
                                   WindowManagerAddShadowHint="False">
                                <Border
                                    MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                                    HorizontalAlignment="Stretch"
                                    Theme="{StaticResource MyNet.Theme.Border.Popup}"
                                    Background="{TemplateBinding (my:PopupAssist.Background)}">
                                    <Border HorizontalAlignment="Stretch" ClipToBounds="True"
                                            CornerRadius="{StaticResource MyNet.Corners.Popup}">
                                        <Grid HorizontalAlignment="Stretch"
                                              RowDefinitions="Auto,Auto,Auto,Auto,*"
                                              TextElement.Foreground="{my:ThemeBrush (my:PopupAssist.Background), RelativeSource={RelativeSource TemplatedParent}, Contrast=True}">
                                            <TextBox Name="PART_SearchBox"
                                                     Grid.Row="0"
                                                     Classes="kind-embedded-search"
                                                     HorizontalAlignment="Stretch"
                                                     IsVisible="{TemplateBinding (my:ItemsSearchBehavior.IsEnabled)}"
                                                     my:ThemeAssist.Role="{TemplateBinding (my:PopupAssist.Role)}"
                                                     FontSize="{Binding $parent[TemplatedControl].FontSize}"
                                                     PlaceholderText="{TemplateBinding (my:ItemsSearchAssist.PlaceholderText)}"
                                                     Text="{TemplateBinding (my:ItemsSearchBehavior.Text), Mode=TwoWay}"
                                                     Theme="{TemplateBinding (my:ItemsSearchBehavior.TextBoxTheme)}" />
                                            <Separator Grid.Row="1"
                                                       Margin="{my:Thickness Left=8, Top=0, Right=8, Bottom=4}"
                                                       IsVisible="{TemplateBinding (my:ItemsSearchBehavior.IsEnabled)}"
                                                       Background="{my:ThemeBrush (my:PopupAssist.Background), RelativeSource={RelativeSource TemplatedParent}, Opacity=Medium, Contrast=True}" />
                                            <Button Grid.Row="2"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    my:IconAssist.Icon="{my:MaterialIcon CheckAll}"
                                                    Classes="variant-text"
                                                    my:ThemeAssist.Role="Contrast"
                                                    Command="{Binding $parent[my:MultiComboBox].SelectAll}"
                                                    Content="{my:Loc SelectAll}"
                                                    Margin="8,4,8,0"
                                                    FontSize="{Binding $parent[TemplatedControl].FontSize}"
                                                    IsVisible="{TemplateBinding ShowSelectAll}" />
                                            <Separator Grid.Row="3"
                                                       Margin="{my:Thickness Left=8, Top=0, Right=8, Bottom=4}"
                                                       IsVisible="{TemplateBinding ShowSelectAll}"
                                                       Background="{my:ThemeBrush (my:PopupAssist.Background), RelativeSource={RelativeSource TemplatedParent}, Opacity=Medium, Contrast=True}" />
                                            <my:PlaceholderContentControl Name="PART_SearchPlaceholder"
                                                                          Grid.Row="4"
                                                                          HorizontalAlignment="Stretch"
                                                                          Classes="variant-watermark size-sm"
                                                                          my:IconAssist.Icon="{x:Static icons:MaterialIconKind.FileSearchOutline}"
                                                                          my:PlaceholderAssist.MinHeight="96"
                                                                          my:PlaceholderAssist.Padding="{StaticResource MyNet.Padding.Surface}"
                                                                          PlaceholderText="{my:Loc NoResults, Filename=ItemsSearchResources}">
                                                <ScrollViewer Name="PART_SearchItems"
                                                              Theme="{StaticResource MyNet.Theme.ScrollViewer.Embedded.Popup}">
                                                    <ItemsPresenter Name="PART_ItemsPresenter"
                                                                    Grid.IsSharedSizeScope="True"
                                                                    ItemsPanel="{TemplateBinding ItemsPanel}"
                                                                    KeyboardNavigation.TabNavigation="Continue" />
                                                </ScrollViewer>
                                            </my:PlaceholderContentControl>
                                        </Grid>
                                    </Border>
                                </Border>
                            </Popup>
                        </Panel>
                    </Panel>
                </DataValidationErrors>
            </ControlTemplate>
        </Setter>

        <!-- Focused -->
        <Style Selector="^:focus-within, ^:flyout-open">
            <Setter Property="BorderThickness" Value="0 0 0 1" />

            <Style Selector="^ /template/ my|Underline#PART_Underline">
                <Setter Property="IsActive" Value="True" />
            </Style>
        </Style>

        <!-- Error -->
        <Style Selector="^:error">
            <Setter Property="BorderThickness" Value="0 0 0 1" />
        </Style>
    </ControlTheme>

</ResourceDictionary>