<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:my="http://mynet.com/avalonia"
                    xmlns:o="using:MyNet.Observable">

    <!-- ═════════════════════════════════════════════════════════ -->
    <!-- FORM ITEM CONTAINER                                       -->
    <!-- ═════════════════════════════════════════════════════════ -->
    <ControlTheme x:Key="{x:Type my:FormItemContainer}" TargetType="my:FormItemContainer">
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="RequiredIndicatorTemplate">
            <DataTemplate>
                <TextBlock Text="*"
                           Foreground="{my:Theme Error}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </DataTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate TargetType="my:FormItemContainer">
                <!-- Label Layout -->
                <Grid Name="PART_Grid" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*">
                    <Grid Grid.Row="0"
                          Grid.Column="0"
                          Name="PART_LabelContainer"
                          IsVisible="{TemplateBinding ShowLabel}"
                          HorizontalAlignment="{TemplateBinding LabelAlignment}">
                        <Grid Margin="{TemplateBinding LabelMargin}"
                              ColumnDefinitions="Auto,Auto">
                            <Label Name="PART_Label"
                                   Grid.Column="0"
                                   my:DisableAssist.IsDisablable="False"
                                   Classes.text-wrapping="{TemplateBinding TextWrapping}"
                                   Target="{Binding #PART_ContentPresenter.Child}"
                                   Content="{TemplateBinding Label}"
                                   ContentTemplate="{TemplateBinding LabelTemplate}">
                                <ContentControl.DataTemplates>
                                    <DataTemplate DataType="o:LocalizedString">
                                        <TextBlock Text="{Binding Value}" />
                                    </DataTemplate>
                                    <DataTemplate DataType="x:String">
                                        <TextBlock Text="{Binding}" />
                                    </DataTemplate>
                                </ContentControl.DataTemplates>
                            </Label>

                            <ContentControl Grid.Column="1"
                                            Margin="{my:Thickness Xxs, Left}"
                                            Content="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                            ContentTemplate="{TemplateBinding RequiredIndicatorTemplate}"
                                            VerticalAlignment="Center"
                                            IsVisible="{TemplateBinding IsRequired}" />
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="0" Grid.Column="0" RowDefinitions="Auto,Auto" Name="PART_Content">
                        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <TextBlock Grid.Row="1" Margin="{my:Thickness Xs, Top}" Text="{TemplateBinding HelpText}"
                                   Classes="text-helper" TextWrapping="Wrap"
                                   IsVisible="{TemplateBinding HelpText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </Grid>
                </Grid>
            </ControlTemplate>
        </Setter>

        <!-- Label Position Pseudo Classes -->
        <Style Selector="^:left">
            <Style Selector="^ /template/ Grid#PART_LabelContainer">
                <Setter Property="Grid.Column" Value="0" />
                <Setter Property="Grid.Row" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style Selector="^ /template/ Grid#PART_Content">
                <Setter Property="Grid.Column" Value="1" />
                <Setter Property="Grid.Row" Value="0" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>
        </Style>

        <Style Selector="^:right">
            <Style Selector="^ /template/ Grid#PART_LabelContainer">
                <Setter Property="Grid.Column" Value="1" />
                <Setter Property="Grid.Row" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style Selector="^ /template/ Grid#PART_Content">
                <Setter Property="Grid.Column" Value="0" />
                <Setter Property="Grid.Row" Value="0" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>
        </Style>

        <Style Selector="^:top">
            <Style Selector="^ /template/ Grid#PART_LabelContainer">
                <Setter Property="Grid.Column" Value="0" />
                <Setter Property="Grid.Row" Value="0" />
            </Style>
            <Style Selector="^ /template/ Grid#PART_Content">
                <Setter Property="Grid.Column" Value="0" />
                <Setter Property="Grid.Row" Value="1" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>
        </Style>

        <Style Selector="^:bottom">
            <Style Selector="^ /template/ Grid#PART_LabelContainer">
                <Setter Property="Grid.Column" Value="0" />
                <Setter Property="Grid.Row" Value="1" />
            </Style>
            <Style Selector="^ /template/ Grid#PART_Content">
                <Setter Property="Grid.Column" Value="0" />
                <Setter Property="Grid.Row" Value="0" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>
        </Style>

        <!-- ═════════════════════════════════════════════════════════ -->
        <!-- KIND-FIELD — label + content hors Form                    -->
        <!-- ═════════════════════════════════════════════════════════ -->
        <Style Selector="^.kind-field">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="LabelMargin" Value="{my:Thickness Sm, Right}" />

            <Style Selector="^[VerticalAlignment=Stretch]">
                <Style Selector="^ /template/ Grid#PART_Content">
                    <Setter Property="VerticalAlignment" Value="Stretch" />
                </Style>
                <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </Style>

            <Style Selector="^ /template/ Label#PART_Label">
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="Foreground" Value="{my:Foreground AncestorType=Control}" />
                <Setter Property="Opacity" Value="{DynamicResource MyNet.Opacity.High}" />
            </Style>

            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Padding" Value="{Binding Padding, RelativeSource={RelativeSource AncestorType=my:FormItemContainer}}" />
            </Style>

            <Style Selector="^.variant-watermark /template/ Label#PART_Label">
                <Setter Property="FontSize"
                        Value="{Binding $parent[my:FormItemContainer].FontSize, Converter={x:Static my:MathConverter.Multiply}, ConverterParameter=0.75}" />
                <Setter Property="Foreground" Value="{my:Foreground}" />
                <Setter Property="Opacity" Value="{DynamicResource MyNet.Opacity.Medium}" />
            </Style>

            <Style Selector="^:left">
                <Setter Property="LabelMargin" Value="{my:Thickness Sm, Right}" />
            </Style>

            <Style Selector="^:right">
                <Setter Property="LabelMargin" Value="{my:Thickness Sm, Left}" />
            </Style>

            <Style Selector="^:top">
                <Setter Property="LabelMargin" Value="{my:Thickness Sm, Bottom}" />
            </Style>

            <Style Selector="^:bottom">
                <Setter Property="LabelMargin" Value="{my:Thickness Sm, Top}" />
            </Style>
        </Style>
    </ControlTheme>

    <!-- ═════════════════════════════════════════════════════════ -->
    <!-- FORM                                                      -->
    <!-- ═════════════════════════════════════════════════════════ -->
    <ControlTheme x:Key="{x:Type my:Form}" TargetType="my:Form">
        <Setter Property="my:ThemeAssist.Category" Value="Unknown" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Columns" Value="1" />
        <Setter Property="LabelMargin" Value="{my:Thickness Sm, Right}" />
        <Setter Property="LabelAlignment" Value="Left" />
        <Setter Property="LabelPosition" Value="Left" />
        <Setter Property="LabelWidth" Value="Auto" />
        <Setter Property="Spacing" Value="{StaticResource MyNet.Spacing.Lg}" />
        <Setter Property="GroupMargin" Value="{my:Thickness Xxl, Vertical}" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <my:FormItemsPanel Columns="{Binding Columns, RelativeSource={RelativeSource AncestorType=my:Form}}"
                                   Spacing="{Binding Spacing, RelativeSource={RelativeSource AncestorType=my:Form}}"
                                   LabelPosition="{Binding LabelPosition, RelativeSource={RelativeSource AncestorType=my:Form}}"
                                   LabelWidth="{Binding LabelWidth, RelativeSource={RelativeSource AncestorType=my:Form}}"
                                   GroupMargin="{Binding GroupMargin, RelativeSource={RelativeSource AncestorType=my:Form}}" />
            </ItemsPanelTemplate>
        </Setter>

        <Setter Property="Template">
            <ControlTemplate TargetType="my:Form">
                <ItemsPresenter Name="PART_ItemsPresenter"
                                ItemsPanel="{TemplateBinding ItemsPanel}"
                                KeyboardNavigation.TabNavigation="Continue" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- ═════════════════════════════════════════════════════════ -->
    <!-- FORM GROUP                                                -->
    <!-- ═════════════════════════════════════════════════════════ -->
    <ControlTheme x:Key="{x:Type my:FormGroup}" TargetType="my:FormGroup">
        <Setter Property="my:ThemeAssist.Category" Value="Surface" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="{StaticResource MyNet.HorizontalAlignment.Surface}" />
        <Setter Property="Padding" Value="{my:Thickness Md, Top}" />
        <Setter Property="LabelMargin" Value="{my:Thickness Sm, Right}" />
        <Setter Property="Focusable" Value="false" />
        <Setter Property="my:HeaderAssist.CornerRadius" Value="0" />
        <Setter Property="my:HeaderAssist.ShadowDepth" Value="Depth0" />
        <Setter Property="my:HeaderAssist.Padding" Value="{my:Thickness Xs, Bottom}" />
        <Setter Property="my:HeaderAssist.FontSize" Value="{StaticResource MyNet.Font.Size.Lg}" />
        <Setter Property="my:HeaderAssist.FontFamily" Value="{Binding $self.FontFamily}" />
        <Setter Property="my:HeaderAssist.FontStyle" Value="{Binding $self.FontStyle}" />
        <Setter Property="my:HeaderAssist.FontWeight" Value="{StaticResource MyNet.Font.Weight.Header}" />
        <Setter Property="my:HeaderAssist.Opacity" Value="1" />
        <Setter Property="my:HeaderAssist.HorizontalAlignment" Value="Left" />
        <Setter Property="my:HeaderAssist.VerticalAlignment" Value="Center" />
        <Setter Property="ClipToBounds" Value="True" />

        <!-- Default colors -->
        <Setter Property="my:VariantAssist.DefaultBackground" Value="Transparent" />
        <Setter Property="my:VariantAssist.DefaultBorderBrush" Value="Transparent" />

        <!-- Variant -->
        <Setter Property="my:VariantAssist.BorderThickness" Value="0" />

        <!-- Theme -->
        <Setter Property="BorderThickness" Value="{Binding $self.(my:VariantAssist.BorderThickness)}" />
        <Setter Property="Background" Value="{Binding $self.(my:VariantAssist.Background)}" />
        <Setter Property="BorderBrush" Value="{Binding $self.(my:VariantAssist.BorderBrush)}" />
        <Setter Property="my:HeaderAssist.Background" Value="Transparent" />
        <Setter Property="my:HeaderAssist.BorderThickness" Value="0 0 0 1" />
        <Setter Property="my:HeaderAssist.BorderBrush" Value="{my:ThemeContext Surface.Border}" />
        <Setter Property="my:HeaderAssist.Foreground" Value="{my:Foreground}" />

        <Setter Property="Template">
            <ControlTemplate TargetType="my:FormGroup">
                <Expander IsExpanded="{TemplateBinding IsExpanded, Mode=TwoWay}"
                          my:ExpanderAssist.IsExpandable="{TemplateBinding IsExpandable}"
                          Padding="{TemplateBinding Padding}"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Stretch"
                          my:IconAssist.Icon="{TemplateBinding (my:IconAssist.Icon)}"
                          my:IconAssist.Opacity="{TemplateBinding (my:IconAssist.Opacity)}"
                          my:IconAssist.IconTemplate="{TemplateBinding (my:IconAssist.IconTemplate)}"
                          my:IconAssist.Alignment="{TemplateBinding (my:IconAssist.Alignment)}"
                          my:IconAssist.Spacing="{TemplateBinding (my:IconAssist.Spacing)}"
                          my:HeaderAssist.Background="{TemplateBinding my:HeaderAssist.Background}"
                          my:HeaderAssist.BorderBrush="{TemplateBinding my:HeaderAssist.BorderBrush}"
                          my:HeaderAssist.BorderThickness="{TemplateBinding my:HeaderAssist.BorderThickness}"
                          my:HeaderAssist.CornerRadius="{TemplateBinding my:HeaderAssist.CornerRadius}"
                          my:HeaderAssist.FontFamily="{TemplateBinding my:HeaderAssist.FontFamily}"
                          my:HeaderAssist.FontSize="{TemplateBinding my:HeaderAssist.FontSize}"
                          my:HeaderAssist.FontStyle="{TemplateBinding my:HeaderAssist.FontStyle}"
                          my:HeaderAssist.FontWeight="{TemplateBinding my:HeaderAssist.FontWeight}"
                          my:HeaderAssist.Foreground="{TemplateBinding my:HeaderAssist.Foreground}"
                          my:HeaderAssist.HorizontalAlignment="{TemplateBinding my:HeaderAssist.HorizontalAlignment}"
                          my:HeaderAssist.Opacity="{TemplateBinding my:HeaderAssist.Opacity}"
                          my:HeaderAssist.Padding="{TemplateBinding my:HeaderAssist.Padding}"
                          my:HeaderAssist.ShadowDepth="{TemplateBinding my:HeaderAssist.ShadowDepth}"
                          my:HeaderAssist.VerticalAlignment="{TemplateBinding my:HeaderAssist.VerticalAlignment}"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Foreground="{TemplateBinding Foreground}"
                          Header="{TemplateBinding Header}"
                          HeaderTemplate="{TemplateBinding HeaderTemplate}"
                          HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                          VerticalAlignment="{TemplateBinding VerticalAlignment}"
                          ClipToBounds="{TemplateBinding ClipToBounds}">
                    <ItemsPresenter Name="PART_ItemsPresenter"
                                    ItemsPanel="{TemplateBinding ItemsPanel}"
                                    KeyboardNavigation.TabNavigation="Continue" />
                </Expander>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>