<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:MyNet.Avalonia.Theme.Controls.Converters.Internals"
                    xmlns:my="http://mynet.com/avalonia"
                    xmlns:temporal="clr-namespace:MyNet.Primitives.Temporal;assembly=MyNet.Primitives">

    <!--  ==============================================  -->
    <!--  PERIOD TIMECOMPONENT THEME  -->
    <!--  ==============================================  -->

    <ControlTheme x:Key="{x:Type my:PeriodTimeComponent}" TargetType="my:PeriodTimeComponent">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="Template">
            <ControlTemplate TargetType="my:PeriodTimeComponent">
                <StackPanel Classes="gap-xs" VerticalAlignment="Center" KeyboardNavigation.TabNavigation="None">
                    <RadioButton x:Name="PART_AmButton"
                                 IsTabStop="False"
                                 Content="{my:Loc Am, Casing=Upper}"
                                 my:ItemsAssist.Role="{TemplateBinding (my:ThemeAssist.Role)}"
                                 my:VariantAssist.Primary="{TemplateBinding (my:VariantAssist.Primary)}"
                                 Theme="{StaticResource {x:Type ToggleButton}}"
                                 FontSize="{TemplateBinding FontSize}"
                                 Classes="variant-text size-sm"
                                 my:DisableAssist.IsDisablable="False"
                                 IsChecked="{TemplateBinding IsAm, Mode=TwoWay}" />
                    <RadioButton x:Name="PART_PmButton"
                                 IsTabStop="False"
                                 Content="{my:Loc Pm, Casing=Upper}"
                                 my:ItemsAssist.Role="{TemplateBinding (my:ThemeAssist.Role)}"
                                 my:VariantAssist.Primary="{TemplateBinding (my:VariantAssist.Primary)}"
                                 Theme="{StaticResource {x:Type ToggleButton}}"
                                 FontSize="{TemplateBinding FontSize}"
                                 Classes="variant-text size-sm"
                                 my:DisableAssist.IsDisablable="False"
                                 IsChecked="{Binding !IsAm, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                </StackPanel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^[IsActive=False]">
            <Setter Property="Opacity" Value="{DynamicResource MyNet.Opacity.Medium}" />
        </Style>

        <Style Selector="^[IsActive=True]">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </ControlTheme>

    <!--  ==============================================  -->
    <!--  NUMERICUPDOWNTIMECOMPONENT THEME  -->
    <!--  ==============================================  -->

    <ControlTheme x:Key="{x:Type my:NumericUpDownTimeComponent}" TargetType="my:NumericUpDownTimeComponent" BasedOn="{StaticResource {x:Type NumericUpDown}}">
        <Setter Property="ShowButtonSpinner" Value="False" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Width" Value="55" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />

        <Style Selector="^ /template/ ButtonSpinner#PART_Spinner">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        </Style>

        <Style Selector="^ /template/ TextBox#PART_TextBox">
            <Setter Property="IsTabStop" Value="False" />
        </Style>

        <Style Selector="^[IsActive=False]">
            <Setter Property="Opacity" Value="{DynamicResource MyNet.Opacity.Medium}" />
        </Style>

        <Style Selector="^[IsActive=True]">
            <Setter Property="Opacity" Value="{DynamicResource MyNet.Opacity.Medium}" />
            <Setter Property="BorderThickness" Value="1" />

            <Style Selector="^ /template/ Border#PART_ActiveBorder">
                <Setter Property="Opacity" Value="1" />
            </Style>
        </Style>
    </ControlTheme>

    <!--  ==============================================  -->
    <!--  DEFAULT TIMEVIEW THEME  -->
    <!--  ==============================================  -->

    <ControlTheme x:Key="{x:Type my:TimeView}" TargetType="my:TimeView">
        <Setter Property="my:ThemeAssist.Category" Value="Navigation" />
        <Setter Property="my:DisableAssist.IsDisablable" Value="True" />
        <Setter Property="my:TransitionsAssist.UseTransitions" Value="True" />
        <Setter Property="HorizontalAlignment" Value="{StaticResource MyNet.HorizontalAlignment.Surface}" />
        <Setter Property="VerticalAlignment" Value="{StaticResource MyNet.VerticalAlignment.Surface}" />
        <Setter Property="CornerRadius" Value="{StaticResource MyNet.Corners.Surface}" />
        <Setter Property="Padding" Value="{StaticResource MyNet.Padding.Surface}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="my:ShadowAssist.ShadowDepth" Value="Depth0" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="my:HeaderAssist.CornerRadius" Value="0" />
        <Setter Property="my:HeaderAssist.ShadowDepth" Value="Depth0" />
        <Setter Property="my:HeaderAssist.Padding" Value="{StaticResource MyNet.Padding.Surface.Header.Md}" />
        <Setter Property="my:HeaderAssist.FontSize" Value="{StaticResource MyNet.Font.Size.H2}" />
        <Setter Property="my:HeaderAssist.FontFamily" Value="{Binding $self.FontFamily}" />
        <Setter Property="my:HeaderAssist.FontStyle" Value="{Binding $self.FontStyle}" />
        <Setter Property="my:HeaderAssist.FontWeight" Value="Normal" />
        <Setter Property="my:HeaderAssist.Opacity" Value="1" />
        <Setter Property="my:HeaderAssist.HorizontalAlignment" Value="Center" />
        <Setter Property="my:HeaderAssist.VerticalAlignment" Value="Center" />

        <!-- Default colors -->
        <Setter Property="my:VariantAssist.DefaultBackground" Value="{my:ThemeContext Surface.Level1}" />
        <Setter Property="my:VariantAssist.DefaultBorderBrush" Value="{my:ThemeContext Surface.Border}" />
        <Setter Property="my:VariantAssist.DefaultForeground" Value="{my:ThemeContext Foreground.Primary}" />

        <!-- Variant -->
        <Setter Property="my:VariantAssist.Background" Value="{my:ThemeRole Background}" />
        <Setter Property="my:VariantAssist.BorderBrush" Value="{my:ThemeRole BorderBrush}" />
        <Setter Property="my:VariantAssist.Foreground" Value="{my:ThemeRole Foreground, Contrast=True}" />
        <Setter Property="my:VariantAssist.Primary" Value="{my:ThemeRole Primary, Role=(my:ThemeAssist.Role)}" />
        <Setter Property="my:VariantAssist.BorderThickness" Value="1" />

        <!-- Surface -->
        <Setter Property="BorderThickness" Value="{Binding $self.(my:VariantAssist.BorderThickness)}" />
        <Setter Property="Background" Value="{Binding $self.(my:VariantAssist.Background)}" />
        <Setter Property="BorderBrush" Value="{Binding $self.(my:VariantAssist.BorderBrush)}" />
        <Setter Property="Foreground" Value="{Binding $self.(my:VariantAssist.Foreground)}" />
        <Setter Property="my:HeaderAssist.Foreground" Value="{my:ThemeRole Foreground, Contrast=True}" />
        <Setter Property="my:HeaderAssist.Background" Value="Transparent" />
        <Setter Property="my:HeaderAssist.BorderThickness" Value="0" />
        <Setter Property="my:HeaderAssist.BorderBrush" Value="Transparent" />

        <Setter Property="Template">
            <ControlTemplate TargetType="{x:Type my:TimeView}">
                <Border my:ShadowAssist.ShadowDepth="{TemplateBinding my:ShadowAssist.ShadowDepth}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="0">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="0">
                        <Border x:Name="PART_HeaderBand"
                                Grid.Row="0"
                                my:ShadowAssist.ShadowDepth="{TemplateBinding my:HeaderAssist.ShadowDepth}"
                                Background="{TemplateBinding my:HeaderAssist.Background}"
                                BorderBrush="{TemplateBinding my:HeaderAssist.BorderBrush}"
                                BorderThickness="{TemplateBinding my:HeaderAssist.BorderThickness}"
                                CornerRadius="{TemplateBinding my:HeaderAssist.CornerRadius}"
                                Padding="{TemplateBinding my:HeaderAssist.Padding}"
                                Opacity="{TemplateBinding my:HeaderAssist.Opacity}">
                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                  HorizontalAlignment="{TemplateBinding my:HeaderAssist.HorizontalAlignment}"
                                  VerticalAlignment="{TemplateBinding my:HeaderAssist.VerticalAlignment}"
                                  KeyboardNavigation.TabNavigation="Continue">
                                <my:NumericUpDownTimeComponent x:Name="PART_Hour"
                                                               Grid.Column="0"
                                                               TabIndex="0"
                                                               my:ThemeAssist.Role="{TemplateBinding (my:ThemeAssist.Role)}"
                                                               my:VariantAssist.Primary="{TemplateBinding (my:VariantAssist.Primary)}"
                                                               FormatString="{TemplateBinding NumberFormat}"
                                                               Value="{TemplateBinding Hour, Mode=TwoWay, Converter={x:Static my:IntToDecimalConverter.Default}}"
                                                               FontSize="{TemplateBinding my:HeaderAssist.FontSize}"
                                                               Minimum="{TemplateBinding TimeFormat, Converter={x:Static c:AmPmRangeConverter.Minimum}}"
                                                               Maximum="{TemplateBinding TimeFormat, Converter={x:Static c:AmPmRangeConverter.Maximum}}"
                                                               Increment="1"
                                                               IsActive="True"
                                                               my:DisableAssist.IsDisablable="False" />
                                <ContentControl Content=":"
                                                Grid.Column="1"
                                                Focusable="False"
                                                IsTabStop="False"
                                                Margin="{my:Thickness Sm, Horizontal}" />
                                <my:NumericUpDownTimeComponent x:Name="PART_Minute"
                                                               Grid.Column="2"
                                                               TabIndex="1"
                                                               my:ThemeAssist.Role="{TemplateBinding (my:ThemeAssist.Role)}"
                                                               my:VariantAssist.Primary="{TemplateBinding (my:VariantAssist.Primary)}"
                                                               FormatString="{TemplateBinding NumberFormat}"
                                                               FontSize="{TemplateBinding my:HeaderAssist.FontSize}"
                                                               Minimum="0"
                                                               Maximum="59"
                                                               Value="{TemplateBinding Minute, Mode=TwoWay, Converter={x:Static my:IntToDecimalConverter.Default}}"
                                                               Increment="1"
                                                               my:DisableAssist.IsDisablable="False" />
                                <ContentControl Grid.Column="3"
                                                Content=":"
                                                Focusable="False"
                                                IsTabStop="False"
                                                Margin="{my:Thickness Sm, Horizontal}"
                                                IsVisible="{TemplateBinding ShowSeconds}" />
                                <my:NumericUpDownTimeComponent x:Name="PART_Second"
                                                               Grid.Column="4"
                                                               TabIndex="2"
                                                               my:ThemeAssist.Role="{TemplateBinding (my:ThemeAssist.Role)}"
                                                               my:VariantAssist.Primary="{TemplateBinding (my:VariantAssist.Primary)}"
                                                               FontSize="{TemplateBinding my:HeaderAssist.FontSize}"
                                                               FormatString="{TemplateBinding NumberFormat}"
                                                               Minimum="0"
                                                               Maximum="59"
                                                               Increment="1"
                                                               Value="{TemplateBinding Second, Mode=TwoWay, Converter={x:Static my:IntToDecimalConverter.Default}}"
                                                               IsEnabled="{TemplateBinding ShowSeconds}"
                                                               IsVisible="{TemplateBinding ShowSeconds}"
                                                               my:DisableAssist.IsDisablable="False" />
                                <Separator Grid.Column="5" Margin="{my:Thickness Sm, Horizontal}" IsVisible="{TemplateBinding TimeFormat, Converter={x:Static my:EnumConverter.Any}, ConverterParameter={x:Static temporal:TimeFormat.TwelveHour}}" />
                                <my:PeriodTimeComponent x:Name="PART_Period"
                                                        Grid.Column="6"
                                                        TabIndex="3"
                                                        my:ThemeAssist.Role="{TemplateBinding (my:ThemeAssist.Role)}"
                                                        my:VariantAssist.Primary="{TemplateBinding (my:VariantAssist.Primary)}"
                                                        FontSize="{TemplateBinding FontSize}"
                                                        IsAm="{TemplateBinding IsAm, Mode=TwoWay}"
                                                        IsVisible="{TemplateBinding TimeFormat, Converter={x:Static my:EnumConverter.Any}, ConverterParameter={x:Static temporal:TimeFormat.TwelveHour}}" />
                            </Grid>
                        </Border>
                        <Border x:Name="PART_Body"
                                Grid.Row="1"
                                Padding="{StaticResource MyNet.Padding.Popup}"
                                IsVisible="{TemplateBinding ShowClock}">
                            <Grid x:Name="PART_ClockHost"
                                  Height="236"
                                  HorizontalAlignment="Center"
                                  ClipToBounds="False">
                                <Viewbox x:Name="PART_ClockViewbox"
                                         Stretch="Uniform"
                                         ClipToBounds="False"
                                         MaxWidth="236"
                                         MaxHeight="236">
                                    <Panel x:Name="PART_ClockPanel"
                                           Width="236"
                                           Height="236">
                                        <my:ClockSelector x:Name="PART_ClockSelector"
                                                          Width="220"
                                                          Height="220"
                                                          Margin="8"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Focusable="True"
                                                          IsTabStop="False"
                                                          TabIndex="-1"
                                                          BorderThickness="0"
                                                      Classes="variant-solid shadow-surface"
                                                          my:DisableAssist.IsDisablable="False"
                                                          Hour="{TemplateBinding Hour, Mode=TwoWay}"
                                                          Minute="{TemplateBinding Minute, Mode=TwoWay}"
                                                          Second="{TemplateBinding Second, Mode=TwoWay}"
                                                          my:ItemsAssist.Role="{TemplateBinding (my:ThemeAssist.Role)}"
                                                          my:VariantAssist.Primary="{TemplateBinding (my:VariantAssist.Primary)}"
                                                          my:VariantAssist.DefaultBackground="{my:ThemeContext Surface.Level2}"
                                                          TimeFormat="{TemplateBinding TimeFormat}"
                                                          ShowSeconds="{TemplateBinding ShowSeconds}"
                                                          SelectedComponent="{Binding SelectedComponent, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                          IsAm="{TemplateBinding IsAm}" />
                                    </Panel>
                                </Viewbox>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^[ShowClock=True]">
            <Setter Property="my:HeaderAssist.Background" Value="{my:ThemeContext Surface.Level1}" />
            <Setter Property="my:HeaderAssist.BorderBrush" Value="{my:ThemeContext Surface.Border}" />
            <Setter Property="my:HeaderAssist.BorderThickness" Value="0,0,0,1" />
            <Setter Property="my:HeaderAssist.Padding" Value="{StaticResource MyNet.Padding.Popup}" />
        </Style>

        <Style Selector="^[ShowClock=False]">
            <Setter Property="my:HeaderAssist.BorderThickness" Value="0" />
        </Style>

        <Style Selector="^ /template/ my|ClockSelector#PART_ClockSelector">
            <Setter Property="Focusable" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="TabIndex" Value="-1" />
        </Style>

        <!-- Compact layout for constrained popup hosts. -->
        <Style Selector="^.compact">
            <Setter Property="my:HeaderAssist.Padding" Value="{my:Thickness Sm}" />
        </Style>

        <Style Selector="^.compact /template/ Border#PART_Body">
            <Setter Property="Padding" Value="{my:Thickness Sm}" />
        </Style>

        <Style Selector="^.compact /template/ Grid#PART_ClockHost">
            <Setter Property="Height" Value="220" />
        </Style>

        <Style Selector="^.compact /template/ Viewbox#PART_ClockViewbox">
            <Setter Property="MaxWidth" Value="220" />
            <Setter Property="MaxHeight" Value="220" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
