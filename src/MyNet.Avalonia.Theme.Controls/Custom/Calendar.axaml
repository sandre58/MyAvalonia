<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:my="http://mynet.com/avalonia">

    <!-- ═════════════════════════════════════════════════════════ -->
    <!-- EMBEDDED CALENDAR BUTTON THEME                            -->
    <!-- ═════════════════════════════════════════════════════════ -->
    <ControlTheme x:Key="MyNet.Theme.Button.Embedded.Calendar" TargetType="Button">
        <Setter Property="my:DisableAssist.IsDisablable" Value="True" />
        <Setter Property="my:TransitionsAssist.UseTransitions" Value="True" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="UseLayoutRounding" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="ClickMode" Value="Release" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="{Binding $parent[Calendar].(my:ItemsAssist.Margin)}" />
        <Setter Property="Padding" Value="{Binding $parent[Calendar].(my:ItemsAssist.Padding)}" />
        <Setter Property="my:ShadowAssist.ShadowDepth" Value="{Binding $parent[Calendar].(my:ItemsAssist.ShadowDepth)}" />

        <!-- Default Theme -->
        <Setter Property="Background" Value="{Binding $parent[Calendar].(my:ItemsAssist.Background)}" />
        <Setter Property="BorderBrush" Value="{Binding $parent[Calendar].(my:ItemsAssist.BorderBrush)}" />
        <Setter Property="BorderThickness" Value="{Binding $parent[Calendar].(my:ItemsAssist.BorderThickness)}" />
        <Setter Property="Foreground" Value="{Binding $parent[Calendar].(my:ItemsAssist.Foreground)}" />
        <Setter Property="CornerRadius" Value="{Binding $parent[Calendar].(my:ItemsAssist.CornerRadius)}" />
        <Setter Property="my:InteractionAssist.HoverBackground"
                Value="{Binding $parent[Calendar].(my:ItemsAssist.HoverBackground)}" />
        <Setter Property="my:InteractionAssist.HoverBorderBrush"
                Value="{Binding $parent[Calendar].(my:ItemsAssist.HoverBorderBrush)}" />
        <Setter Property="my:InteractionAssist.HoverForeground"
                Value="{Binding $parent[Calendar].(my:ItemsAssist.HoverForeground)}" />
        <Setter Property="my:InteractionAssist.RippleColor"
                Value="{Binding $parent[Calendar].(my:ItemsAssist.RippleColor)}" />
        <Setter Property="my:InteractionAssist.ActiveBackground"
                Value="{Binding $parent[Calendar].(my:ItemsAssist.ActiveBackground)}" />
        <Setter Property="my:InteractionAssist.ActiveBorderBrush"
                Value="{Binding $parent[Calendar].(my:ItemsAssist.ActiveBorderBrush)}" />
        <Setter Property="my:InteractionAssist.ActiveForeground"
                Value="{Binding $parent[Calendar].(my:ItemsAssist.ActiveForeground)}" />

        <Setter Property="Template">
            <ControlTemplate TargetType="Button">
                <Panel Name="PART_RootPanel">

                    <Border Name="PART_MainBorder"
                            my:ShadowAssist.ShadowDepth="{TemplateBinding my:ShadowAssist.ShadowDepth}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}" />

                    <Border Name="PART_ActiveBorder"
                            Background="{TemplateBinding my:InteractionAssist.ActiveBackground}"
                            BorderBrush="{TemplateBinding my:InteractionAssist.ActiveBorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Theme="{StaticResource MyNet.Theme.Border.State}" />

                    <Border Name="PART_HoverBorder"
                            Background="{TemplateBinding my:InteractionAssist.HoverBackground}"
                            BorderBrush="{TemplateBinding my:InteractionAssist.HoverBorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Theme="{StaticResource MyNet.Theme.Border.State}" />

                    <Border ClipToBounds="True" CornerRadius="{TemplateBinding CornerRadius}">
                        <my:Ripple Name="PART_Ripple" RippleFill="{TemplateBinding my:InteractionAssist.RippleColor}">
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              BackgroundSizing="{TemplateBinding BackgroundSizing}"
                                              BorderThickness="{TemplateBinding BorderThickness}"
                                              CornerRadius="{TemplateBinding CornerRadius}"
                                              Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              UseLayoutRounding="False" />
                        </my:Ripple>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>

        <!-- Hover -->
        <Style Selector="^:not(:disabled):pointerover">
            <Setter Property="Foreground" Value="{Binding $self.(my:InteractionAssist.HoverForeground)}" />

            <Style Selector="^ /template/ Border#PART_HoverBorder">
                <Setter Property="Opacity" Value="1" />
            </Style>
        </Style>

        <Style Selector="^.Range">
            <Setter Property="Margin" Value="{my:Thickness Xs, Vertical}" />

            <Style Selector="^ /template/ Border#PART_ActiveBorder">
                <Setter Property="my:TransitionsAssist.UseTransitions" Value="False" />
            </Style>
            <Style Selector="^ /template/ Border#PART_HoverBorder">
                <Setter Property="my:TransitionsAssist.UseTransitions" Value="False" />
            </Style>
        </Style>

        <Style Selector="^:in-range, ^:preview-in-range">
            <Setter Property="CornerRadius" Value="0" />

            <Style Selector="^ /template/ Border#PART_ActiveBorder">
                <Setter Property="Opacity" Value="{DynamicResource MyNet.Opacity.Scrim}" />
                <Setter Property="CornerRadius" Value="0" />
            </Style>
        </Style>

        <!-- Active (for button with state "selected") -->
        <Style Selector="^:selected, ^:start-date, ^:end-date">
            <Setter Property="Foreground" Value="{Binding $self.(my:InteractionAssist.ActiveForeground)}" />

            <Style Selector="^ /template/ Border#PART_ActiveBorder">
                <Setter Property="Opacity" Value="1" />
            </Style>
        </Style>

        <Style Selector="^:today">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{my:ThemeBrush (my:InteractionAssist.ActiveBackground)}" />
        </Style>

        <Style Selector="^:inactive /template/ Panel#PART_RootPanel">
            <Setter Property="Opacity" Value="{DynamicResource MyNet.Opacity.Medium}" />
        </Style>

        <Style Selector="^:preview-start-date, ^:preview-end-date">

            <Style Selector="^ /template/ Border#PART_ActiveBorder">
                <Setter Property="Opacity" Value="{DynamicResource MyNet.Opacity.High}" />
            </Style>
        </Style>

        <Style Selector="^:start-date, ^:preview-start-date">
            <Setter Property="CornerRadius"
                    Value="{Binding Source={StaticResource MyNet.Corners.Control}, Converter={x:Static my:CornerRadiusAdjustConverter.Left}}" />

            <Style Selector="^ /template/ Border#PART_ActiveBorder">
                <Setter Property="CornerRadius"
                        Value="{Binding Source={StaticResource MyNet.Corners.Control}, Converter={x:Static my:CornerRadiusAdjustConverter.Left}}" />
            </Style>
        </Style>

        <Style Selector="^:start-date:end-date, ^:preview-start-date:preview-end-date">
            <Setter Property="CornerRadius" Value="{StaticResource MyNet.Corners.Control}" />

            <Style Selector="^ /template/ Border#PART_ActiveBorder">
                <Setter Property="CornerRadius" Value="{StaticResource MyNet.Corners.Control}" />
            </Style>
        </Style>

        <Style Selector="^:end-date, ^:preview-end-date">
            <Setter Property="CornerRadius"
                    Value="{Binding Source={StaticResource MyNet.Corners.Control}, Converter={x:Static my:CornerRadiusAdjustConverter.Right}}" />

            <Style Selector="^ /template/ Border#PART_ActiveBorder">
                <Setter Property="CornerRadius"
                        Value="{Binding Source={StaticResource MyNet.Corners.Control}, Converter={x:Static my:CornerRadiusAdjustConverter.Right}}" />
            </Style>
        </Style>

        <Style Selector="^:blackout /template/ Panel#PART_RootPanel">
            <Setter Property="Opacity" Value="{DynamicResource MyNet.Opacity.Disabled}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="MyNet.Theme.Button.Embedded.Calendar.Extended" TargetType="Button"
                  BasedOn="{StaticResource MyNet.Theme.Button.Embedded.Calendar}">
        <Setter Property="Margin" Value="{Binding $parent[my:Calendar].(my:ItemsAssist.Margin)}" />
        <Setter Property="Padding" Value="{Binding $parent[my:Calendar].(my:ItemsAssist.Padding)}" />
        <Setter Property="my:ShadowAssist.ShadowDepth"
                Value="{Binding $parent[my:Calendar].(my:ItemsAssist.ShadowDepth)}" />

        <!-- Default Theme -->
        <Setter Property="Background" Value="{Binding $parent[my:Calendar].(my:ItemsAssist.Background)}" />
        <Setter Property="BorderBrush" Value="{Binding $parent[my:Calendar].(my:ItemsAssist.BorderBrush)}" />
        <Setter Property="BorderThickness" Value="{Binding $parent[my:Calendar].(my:ItemsAssist.BorderThickness)}" />
        <Setter Property="Foreground" Value="{Binding $parent[my:Calendar].(my:ItemsAssist.Foreground)}" />
        <Setter Property="CornerRadius" Value="{Binding $parent[my:Calendar].(my:ItemsAssist.CornerRadius)}" />
        <Setter Property="my:InteractionAssist.HoverBackground"
                Value="{Binding $parent[my:Calendar].(my:ItemsAssist.HoverBackground)}" />
        <Setter Property="my:InteractionAssist.HoverBorderBrush"
                Value="{Binding $parent[my:Calendar].(my:ItemsAssist.HoverBorderBrush)}" />
        <Setter Property="my:InteractionAssist.HoverForeground"
                Value="{Binding $parent[my:Calendar].(my:ItemsAssist.HoverForeground)}" />
        <Setter Property="my:InteractionAssist.RippleColor"
                Value="{Binding $parent[my:Calendar].(my:ItemsAssist.RippleColor)}" />
        <Setter Property="my:InteractionAssist.ActiveBackground"
                Value="{Binding $parent[my:Calendar].(my:ItemsAssist.ActiveBackground)}" />
        <Setter Property="my:InteractionAssist.ActiveBorderBrush"
                Value="{Binding $parent[my:Calendar].(my:ItemsAssist.ActiveBorderBrush)}" />
        <Setter Property="my:InteractionAssist.ActiveForeground"
                Value="{Binding $parent[my:Calendar].(my:ItemsAssist.ActiveForeground)}" />
    </ControlTheme>

    <!-- ═════════════════════════════════════════════════════════ -->
    <!-- DEFAULT CALENDARDAYBUTTON THEME                           -->
    <!-- ═════════════════════════════════════════════════════════ -->
    <ControlTheme x:Key="{x:Type CalendarDayButton}" TargetType="CalendarDayButton"
                  BasedOn="{StaticResource MyNet.Theme.Button.Embedded.Calendar}" />
    <ControlTheme x:Key="{x:Type my:CalendarDayButton}" TargetType="my:CalendarDayButton"
                  BasedOn="{StaticResource MyNet.Theme.Button.Embedded.Calendar.Extended}" />

    <!-- ═════════════════════════════════════════════════════════ -->
    <!-- DEFAULT CALENDARBUTTON THEME                              -->
    <!-- ═════════════════════════════════════════════════════════ -->
    <ControlTheme x:Key="{x:Type CalendarButton}" TargetType="CalendarButton"
                  BasedOn="{StaticResource MyNet.Theme.Button.Embedded.Calendar}" />
    <ControlTheme x:Key="{x:Type my:CalendarYearButton}" TargetType="my:CalendarYearButton"
                  BasedOn="{StaticResource MyNet.Theme.Button.Embedded.Calendar.Extended}" />

    <!-- ═════════════════════════════════════════════════════════ -->
    <!-- DEFAULT CALENDARITEM THEME                                -->
    <!-- ═════════════════════════════════════════════════════════ -->
    <ControlTheme x:Key="{x:Type CalendarItem}" TargetType="CalendarItem">
        <Setter Property="HorizontalAlignment" Value="{StaticResource MyNet.HorizontalAlignment.Surface}" />
        <Setter Property="VerticalAlignment" Value="{StaticResource MyNet.VerticalAlignment.Surface}" />
        <Setter Property="CornerRadius" Value="{StaticResource MyNet.Corners.Surface}" />
        <Setter Property="Padding" Value="{StaticResource MyNet.Padding.Surface}" />
        <Setter Property="MinWidth" Value="240" />
        <Setter Property="MinHeight" Value="250" />
        <Setter Property="Focusable" Value="false" />
        <Setter Property="my:ShadowAssist.ShadowDepth" Value="Depth0" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="DayTitleTemplate">
            <Template>
                <TextBlock Margin="{my:Thickness Sm, Bottom}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           x:DataType="x:String"
                           FontSize="{StaticResource MyNet.Font.Size.Sm}"
                           Opacity="{DynamicResource MyNet.Opacity.High}"
                           Text="{Binding}" />
            </Template>
        </Setter>

        <Setter Property="Template">
            <ControlTemplate TargetType="CalendarItem">
                <Border Padding="{TemplateBinding Padding}"
                        my:ShadowAssist.ShadowDepth="{TemplateBinding my:ShadowAssist.ShadowDepth}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <Grid MinWidth="{TemplateBinding MinWidth}"
                          MinHeight="{TemplateBinding MinHeight}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" Margin="{my:Thickness Md, Bottom}" ColumnDefinitions="Auto,5,*,5,Auto">
                            <Button Name="PART_PreviousButton"
                                    Grid.Column="0"
                                    Classes="variant-text size-sm"
                                    my:DisableAssist.IsDisablable="False">
                                <PathIcon Data="{StaticResource MyNet.Geometry.ChevronLeft}" Classes="size-xs" />
                            </Button>

                            <Button Name="PART_HeaderButton"
                                    Grid.Column="2"
                                    HorizontalAlignment="Stretch"
                                    Classes="variant-text size-sm"
                                    my:DisableAssist.IsDisablable="False">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{my:Display Casing=Title}" />
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>

                            <Button Name="PART_NextButton"
                                    Grid.Column="4"
                                    Classes="variant-text size-sm"
                                    my:DisableAssist.IsDisablable="False">
                                <PathIcon Data="{StaticResource MyNet.Geometry.ChevronRight}" Classes="size-xs" />
                            </Button>
                        </Grid>
                        <Grid Name="PART_MonthView"
                              Grid.Row="1"
                              HorizontalAlignment="Stretch"
                              ColumnDefinitions="*,*,*,*,*,*,*"
                              IsVisible="False" RowDefinitions="Auto,*,*,*,*,*,*">
                        </Grid>
                        <Grid Name="PART_YearView"
                              Grid.Row="1"
                              ColumnDefinitions="*,*,*,*"
                              IsVisible="False"
                              RowDefinitions="*,*,*" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- ═════════════════════════════════════════════════════════ -->
    <!-- DEFAULT CALENDAR THEME                                    -->
    <!-- ═════════════════════════════════════════════════════════ -->
    <ControlTheme x:Key="{x:Type Calendar}" TargetType="Calendar">
        <Setter Property="my:ThemeAssist.Category" Value="Navigation" />
        <Setter Property="my:DisableAssist.IsDisablable" Value="True" />
        <Setter Property="my:TransitionsAssist.UseTransitions" Value="True" />
        <Setter Property="HorizontalAlignment" Value="{StaticResource MyNet.HorizontalAlignment.Surface}" />
        <Setter Property="VerticalAlignment" Value="{StaticResource MyNet.VerticalAlignment.Surface}" />
        <Setter Property="CornerRadius" Value="{StaticResource MyNet.Corners.Surface}" />
        <Setter Property="Padding" Value="{StaticResource MyNet.Padding.Surface}" />
        <Setter Property="Focusable" Value="false" />
        <Setter Property="my:ShadowAssist.ShadowDepth" Value="Depth0" />
        <Setter Property="ClipToBounds" Value="False" />

        <!-- Default colors -->
        <Setter Property="my:VariantAssist.DefaultBackground" Value="{my:ThemeContext Surface.Level1}" />
        <Setter Property="my:VariantAssist.DefaultBorderBrush" Value="{my:ThemeContext Surface.Border}" />
        <Setter Property="my:VariantAssist.DefaultForeground" Value="{my:ThemeContext Foreground.Primary}" />
        <Setter Property="my:VariantAssist.DefaultPrimary" Value="{my:ThemeContext Primary}" />

        <!-- Variant -->
        <Setter Property="my:VariantAssist.Background" Value="{my:ThemeRole Background}" />
        <Setter Property="my:VariantAssist.BorderBrush" Value="{my:ThemeRole BorderBrush}" />
        <Setter Property="my:VariantAssist.Foreground" Value="{my:ThemeRole Foreground, Contrast=True}" />
        <Setter Property="my:VariantAssist.Primary" Value="{my:ThemeRole Primary, Role=(my:ItemsAssist.Role)}" />
        <Setter Property="my:VariantAssist.BorderThickness" Value="1" />

        <!-- Theme -->
        <Setter Property="BorderThickness" Value="{Binding $self.(my:VariantAssist.BorderThickness)}" />
        <Setter Property="Background" Value="{Binding $self.(my:VariantAssist.Background)}" />
        <Setter Property="BorderBrush" Value="{Binding $self.(my:VariantAssist.BorderBrush)}" />
        <Setter Property="Foreground" Value="{Binding $self.(my:VariantAssist.Foreground)}" />

        <!-- Items -->
        <Setter Property="my:ItemsAssist.Margin" Value="2" />
        <Setter Property="my:ItemsAssist.Padding" Value="{StaticResource MyNet.Padding.Calendar.Item.Md}" />
        <Setter Property="my:ItemsAssist.CornerRadius" Value="{StaticResource MyNet.Corners.Control}" />
        <Setter Property="my:ItemsAssist.ShadowDepth" Value="Depth0" />
        <Setter Property="my:ItemsAssist.Background" Value="Transparent" />
        <Setter Property="my:ItemsAssist.BorderBrush" Value="Transparent" />
        <Setter Property="my:ItemsAssist.Foreground" Value="{my:Foreground}" />
        <Setter Property="my:ItemsAssist.BorderThickness" Value="0" />
        <Setter Property="my:ItemsAssist.HoverBackground" Value="{my:Foreground Opacity=Hover}" />
        <Setter Property="my:ItemsAssist.HoverBorderBrush" Value="Transparent" />
        <Setter Property="my:ItemsAssist.HoverForeground" Value="{my:Foreground}" />
        <Setter Property="my:ItemsAssist.ActiveBackground" Value="{Binding $self.(my:VariantAssist.Primary)}" />
        <Setter Property="my:ItemsAssist.ActiveBorderBrush" Value="{Binding $self.(my:VariantAssist.Primary)}" />
        <Setter Property="my:ItemsAssist.ActiveForeground"
                Value="{my:ThemeBrush (my:ItemsAssist.ActiveBackground), Contrast=True}" />
        <Setter Property="my:ItemsAssist.RippleColor" Value="{my:ThemeBrush (my:ItemsAssist.ActiveForeground)}" />

        <Style Selector="^.role-contrast">
            <Setter Property="my:ItemsAssist.ActiveBackground" Value="{my:Foreground}" />
        </Style>

        <Setter Property="Template">
            <ControlTemplate TargetType="Calendar">
                <StackPanel Name="PART_Root">
                    <CalendarItem Name="PART_CalendarItem"
                                  Padding="{TemplateBinding Padding}"
                                  my:ShadowAssist.ShadowDepth="{TemplateBinding my:ShadowAssist.ShadowDepth}"
                                  my:ThemeAssist.Role="{TemplateBinding (my:ThemeAssist.Role)}"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  HeaderBackground="{TemplateBinding HeaderBackground}" />
                </StackPanel>
            </ControlTemplate>
        </Setter>

        <!-- ═════════════════════════════════════════════════════════ -->
        <!-- SIZES                                                     -->
        <!-- ═════════════════════════════════════════════════════════ -->

        <Style Selector="^.size-sm">
            <Setter Property="my:ItemsAssist.Padding" Value="{StaticResource MyNet.Padding.Calendar.Item.Sm}" />
        </Style>

        <Style Selector="^.size-md">
            <Setter Property="my:ItemsAssist.Padding" Value="{StaticResource MyNet.Padding.Calendar.Item.Md}" />
        </Style>

        <Style Selector="^.size-lg">
            <Setter Property="my:ItemsAssist.Padding" Value="{StaticResource MyNet.Padding.Calendar.Item.Lg}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type my:Calendar}" TargetType="my:Calendar">
        <Setter Property="my:ThemeAssist.Category" Value="Navigation" />
        <Setter Property="my:DisableAssist.IsDisablable" Value="True" />
        <Setter Property="my:TransitionsAssist.UseTransitions" Value="True" />
        <Setter Property="HorizontalAlignment" Value="{StaticResource MyNet.HorizontalAlignment.Surface}" />
        <Setter Property="VerticalAlignment" Value="{StaticResource MyNet.VerticalAlignment.Surface}" />
        <Setter Property="CornerRadius" Value="{StaticResource MyNet.Corners.Surface}" />
        <Setter Property="Padding" Value="{StaticResource MyNet.Padding.Surface}" />
        <Setter Property="my:ShadowAssist.ShadowDepth" Value="Depth0" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="MinWidth" Value="240" />
        <Setter Property="MinHeight" Value="250" />
        <Setter Property="DayTitleTemplate">
            <Template>
                <TextBlock Margin="{my:Thickness Sm, Bottom}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           x:DataType="x:String"
                           FontSize="{StaticResource MyNet.Font.Size.Sm}"
                           Opacity="{DynamicResource MyNet.Opacity.High}"
                           Text="{Binding}" />
            </Template>
        </Setter>

        <!-- Default colors -->
        <Setter Property="my:VariantAssist.DefaultBackground" Value="{my:ThemeContext Surface.Level1}" />
        <Setter Property="my:VariantAssist.DefaultBorderBrush" Value="{my:ThemeContext Surface.Border}" />
        <Setter Property="my:VariantAssist.DefaultForeground" Value="{my:ThemeContext Foreground.Primary}" />
        <Setter Property="my:VariantAssist.DefaultPrimary" Value="{my:ThemeContext Primary}" />

        <!-- Variant -->
        <Setter Property="my:VariantAssist.Background" Value="{my:ThemeRole Background}" />
        <Setter Property="my:VariantAssist.BorderBrush" Value="{my:ThemeRole BorderBrush}" />
        <Setter Property="my:VariantAssist.Foreground" Value="{my:ThemeRole Foreground, Contrast=True}" />
        <Setter Property="my:VariantAssist.Primary" Value="{my:ThemeRole Primary, Role=(my:ItemsAssist.Role)}" />
        <Setter Property="my:VariantAssist.BorderThickness" Value="1" />

        <!-- Theme -->
        <Setter Property="BorderThickness" Value="{Binding $self.(my:VariantAssist.BorderThickness)}" />
        <Setter Property="Background" Value="{Binding $self.(my:VariantAssist.Background)}" />
        <Setter Property="BorderBrush" Value="{Binding $self.(my:VariantAssist.BorderBrush)}" />
        <Setter Property="Foreground" Value="{Binding $self.(my:VariantAssist.Foreground)}" />

        <!-- Items -->
        <Setter Property="my:ItemsAssist.Margin" Value="2" />
        <Setter Property="my:ItemsAssist.Padding" Value="{StaticResource MyNet.Padding.Calendar.Item.Md}" />
        <Setter Property="my:ItemsAssist.CornerRadius" Value="{StaticResource MyNet.Corners.Control}" />
        <Setter Property="my:ItemsAssist.ShadowDepth" Value="Depth0" />
        <Setter Property="my:ItemsAssist.Background" Value="Transparent" />
        <Setter Property="my:ItemsAssist.BorderBrush" Value="Transparent" />
        <Setter Property="my:ItemsAssist.Foreground" Value="{my:Foreground}" />
        <Setter Property="my:ItemsAssist.BorderThickness" Value="0" />
        <Setter Property="my:ItemsAssist.HoverBackground" Value="{my:Foreground Opacity=Hover}" />
        <Setter Property="my:ItemsAssist.HoverBorderBrush" Value="Transparent" />
        <Setter Property="my:ItemsAssist.HoverForeground" Value="{my:Foreground}" />
        <Setter Property="my:ItemsAssist.ActiveBackground" Value="{Binding $self.(my:VariantAssist.Primary)}" />
        <Setter Property="my:ItemsAssist.ActiveBorderBrush" Value="{Binding $self.(my:VariantAssist.Primary)}" />
        <Setter Property="my:ItemsAssist.ActiveForeground"
                Value="{my:ThemeBrush (my:ItemsAssist.ActiveBackground), Contrast=True}" />
        <Setter Property="my:ItemsAssist.RippleColor" Value="{my:ThemeBrush (my:ItemsAssist.ActiveForeground)}" />

        <Style Selector="^.role-contrast">
            <Setter Property="my:ItemsAssist.ActiveBackground" Value="{my:Foreground}" />
        </Style>

        <Setter Property="Template">
            <ControlTemplate TargetType="my:Calendar">
                <Border Padding="{TemplateBinding Padding}"
                        my:ShadowAssist.ShadowDepth="{TemplateBinding my:ShadowAssist.ShadowDepth}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <Grid MinWidth="{TemplateBinding MinWidth}"
                          MinHeight="{TemplateBinding MinHeight}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          RowDefinitions="Auto, *">
                        <Grid Grid.Row="0" Margin="{my:Thickness Md, Bottom}"
                              ColumnDefinitions="Auto, Auto,*, Auto, Auto">
                            <Button Name="{x:Static my:Calendar.PartFastPreviousButton}"
                                    Grid.Column="0"
                                    Classes="variant-text size-sm"
                                    my:DisableAssist.IsDisablable="False"
                                    Focusable="False">
                                <PathIcon Data="{StaticResource MyNet.Geometry.DoubleChevronLeft}" Classes="size-xs" />
                            </Button>
                            <Button Name="{x:Static my:Calendar.PartPreviousButton}"
                                    Grid.Column="1"
                                    Classes="variant-text size-sm"
                                    my:DisableAssist.IsDisablable="False"
                                    Focusable="False">
                                <PathIcon Data="{StaticResource MyNet.Geometry.ChevronLeft}" Classes="size-xs" />
                            </Button>

                            <Grid Grid.Column="2" ColumnDefinitions="*, *">
                                <Button Name="{x:Static my:Calendar.PartMonthButton}"
                                        Grid.Column="0"
                                        HorizontalAlignment="Stretch"
                                        Classes="variant-text size-sm"
                                        my:DisableAssist.IsDisablable="False"
                                        Content="{my:DisplayTextBlock DisplayDateContext, Format='MMM', Casing=Title, RelativeSource={RelativeSource TemplatedParent}}"
                                        Focusable="False" />
                                <Button Name="{x:Static my:Calendar.PartYearButton}"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        Classes="variant-text size-sm"
                                        my:DisableAssist.IsDisablable="False"
                                        Content="{my:DisplayTextBlock DisplayDateContext, Format='yyyy', FallbackValue='', RelativeSource={RelativeSource TemplatedParent}}"
                                        Focusable="False" />
                                <Button Name="{x:Static my:Calendar.PartHeaderButton}"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        HorizontalAlignment="Stretch"
                                        Classes="variant-text size-sm"
                                        my:DisableAssist.IsDisablable="False"
                                        Content="{my:DisplayTextBlock DisplayDateContext, RelativeSource={RelativeSource TemplatedParent}}"
                                        Focusable="False"
                                        IsVisible="False" />
                            </Grid>

                            <Button Name="{x:Static my:Calendar.PartNextButton}"
                                    Grid.Column="3"
                                    Classes="variant-text size-sm"
                                    my:DisableAssist.IsDisablable="False"
                                    Focusable="False">
                                <PathIcon Data="{StaticResource MyNet.Geometry.ChevronRight}" Classes="size-xs" />
                            </Button>
                            <Button Name="{x:Static my:Calendar.PartFastNextButton}"
                                    Grid.Column="4"
                                    Classes="variant-text size-sm"
                                    my:DisableAssist.IsDisablable="False"
                                    Focusable="False">
                                <PathIcon Data="{StaticResource MyNet.Geometry.DoubleChevronRight}" Classes="size-xs" />
                            </Button>
                        </Grid>
                        <Grid Name="{x:Static my:Calendar.PartMonthGrid}"
                              Grid.Row="1"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ColumnDefinitions="*, *, *, *, *, *, *"
                              RowDefinitions="Auto, *, *, *, *, *, *" />
                        <Grid Name="{x:Static my:Calendar.PartYearGrid}"
                              Grid.Row="1"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ColumnDefinitions="*, *, *"
                              IsVisible="False"
                              RowDefinitions="*, *, *, *" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:year, ^:decade, ^:century">
            <Style Selector="^ /template/ Grid#PART_YearGrid">
                <Setter Property="IsVisible" Value="True" />
            </Style>
            <Style Selector="^ /template/ Button#PART_HeaderButton">
                <Setter Property="IsVisible" Value="True" />
            </Style>
            <Style Selector="^ /template/ Button#PART_FastNextButton">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^ /template/ Button#PART_FastPreviousButton">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^ /template/ Button#PART_YearButton">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^ /template/ Button#PART_MonthButton">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^ /template/ Grid#PART_MonthGrid">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </Style>

        <!-- ═════════════════════════════════════════════════════════ -->
        <!-- SIZES                                                     -->
        <!-- ═════════════════════════════════════════════════════════ -->

        <Style Selector="^.size-sm">
            <Setter Property="my:ItemsAssist.Padding" Value="{StaticResource MyNet.Padding.Calendar.Item.Sm}" />
        </Style>

        <Style Selector="^.size-md">
            <Setter Property="my:ItemsAssist.Padding" Value="{StaticResource MyNet.Padding.Calendar.Item.Md}" />
        </Style>

        <Style Selector="^.size-lg">
            <Setter Property="my:ItemsAssist.Padding" Value="{StaticResource MyNet.Padding.Calendar.Item.Lg}" />
        </Style>
    </ControlTheme>

</ResourceDictionary>