<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:my="http://mynet.com/avalonia">

    <!-- Horizontal + Stat share the same body grid. -->
    <ControlTemplate x:Key="MyNet.Card.Template.Body.Horizontal" TargetType="ContentControl">
        <Grid Name="PART_BodyGrid"
              Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType=my:Card}}"
              ColumnDefinitions="Auto,*,Auto"
              RowDefinitions="Auto,Auto,*">
            <ContentControl Grid.Row="0"
                            Grid.Column="0"
                            Focusable="False"
                            Template="{StaticResource MyNet.RegionLayout.LeadingHost}" />

            <my:TitleBlock Name="PART_TitleBlock"
                           Grid.Row="0"
                           Grid.Column="1"
                           Grid.RowSpan="2"
                           VerticalAlignment="Center"
                           Title="{Binding Title, RelativeSource={RelativeSource AncestorType=my:Card}}"
                           TitleTemplate="{Binding TitleTemplate, RelativeSource={RelativeSource AncestorType=my:Card}}"
                           TitleFontSize="{Binding TitleFontSize, RelativeSource={RelativeSource AncestorType=my:Card}}"
                           TitleFontWeight="{Binding TitleFontWeight, RelativeSource={RelativeSource AncestorType=my:Card}}"
                           TitleForeground="{Binding TitleForeground, RelativeSource={RelativeSource AncestorType=my:Card}}"
                           Subtitle="{Binding Subtitle, RelativeSource={RelativeSource AncestorType=my:Card}}"
                           SubtitleTemplate="{Binding SubtitleTemplate, RelativeSource={RelativeSource AncestorType=my:Card}}"
                           SubtitleFontSize="{Binding SubtitleFontSize, RelativeSource={RelativeSource AncestorType=my:Card}}"
                           SubtitleForeground="{Binding SubtitleForeground, RelativeSource={RelativeSource AncestorType=my:Card}}" />

            <ContentPresenter Name="PART_Content"
                              Grid.Row="2"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              VerticalAlignment="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType=my:Card}}"
                              HorizontalAlignment="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType=my:Card}}"
                              Content="{Binding Content, RelativeSource={RelativeSource AncestorType=my:Card}}"
                              ContentTemplate="{Binding ContentTemplate, RelativeSource={RelativeSource AncestorType=my:Card}}"
                              IsVisible="{Binding Content, RelativeSource={RelativeSource AncestorType=my:Card}, Converter={x:Static my:NullConverter.IsPresent}}" />

            <ContentPresenter Name="PART_Trailing"
                              Grid.Row="0"
                              Grid.Column="2"
                              Grid.RowSpan="3"
                              Padding="{Binding (my:TrailingAssist.Padding), RelativeSource={RelativeSource AncestorType=my:Card}}"
                              Margin="{Binding (my:TrailingAssist.Margin), RelativeSource={RelativeSource AncestorType=my:Card}}"
                              VerticalAlignment="{Binding (my:TrailingAssist.VerticalAlignment), RelativeSource={RelativeSource AncestorType=my:Card}}"
                              HorizontalAlignment="{Binding (my:TrailingAssist.HorizontalAlignment), RelativeSource={RelativeSource AncestorType=my:Card}}"
                              Content="{Binding Trailing, RelativeSource={RelativeSource AncestorType=my:Card}}"
                              ContentTemplate="{Binding TrailingTemplate, RelativeSource={RelativeSource AncestorType=my:Card}}">
                <ContentPresenter.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="Trailing"
                                 RelativeSource="{RelativeSource AncestorType=my:Card}"
                                 Converter="{x:Static my:NullConverter.IsPresent}" />
                        <Binding Path="(my:TrailingAssist.IsVisible)"
                                 RelativeSource="{RelativeSource AncestorType=my:Card}" />
                    </MultiBinding>
                </ContentPresenter.IsVisible>
            </ContentPresenter>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="MyNet.Card.Template.Body.Vertical" TargetType="ContentControl">
        <Grid Name="PART_BodyGrid"
              Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType=my:Card}}"
              ColumnDefinitions="*,Auto"
              RowDefinitions="Auto,Auto,*"
              RowSpacing="{StaticResource MyNet.Spacing.Sm}">
            <ContentControl Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            HorizontalAlignment="Center"
                            Focusable="False"
                            Template="{StaticResource MyNet.RegionLayout.LeadingHost}" />

            <my:TitleBlock Name="PART_TitleBlock"
                           Grid.Row="1"
                           Grid.Column="0"
                           Grid.ColumnSpan="2"
                           HorizontalAlignment="Stretch"
                           HorizontalTextAlignment="Center"
                           TextAlignment="Center"
                           Title="{Binding Title, RelativeSource={RelativeSource AncestorType=my:Card}}"
                           TitleTemplate="{Binding TitleTemplate, RelativeSource={RelativeSource AncestorType=my:Card}}"
                           TitleFontSize="{Binding TitleFontSize, RelativeSource={RelativeSource AncestorType=my:Card}}"
                           TitleFontWeight="{Binding TitleFontWeight, RelativeSource={RelativeSource AncestorType=my:Card}}"
                           TitleForeground="{Binding TitleForeground, RelativeSource={RelativeSource AncestorType=my:Card}}"
                           Subtitle="{Binding Subtitle, RelativeSource={RelativeSource AncestorType=my:Card}}"
                           SubtitleTemplate="{Binding SubtitleTemplate, RelativeSource={RelativeSource AncestorType=my:Card}}"
                           SubtitleFontSize="{Binding SubtitleFontSize, RelativeSource={RelativeSource AncestorType=my:Card}}"
                           SubtitleForeground="{Binding SubtitleForeground, RelativeSource={RelativeSource AncestorType=my:Card}}" />

            <ContentPresenter Name="PART_Content"
                              Grid.Row="2"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              VerticalAlignment="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType=my:Card}}"
                              HorizontalAlignment="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType=my:Card}}"
                              Content="{Binding Content, RelativeSource={RelativeSource AncestorType=my:Card}}"
                              ContentTemplate="{Binding ContentTemplate, RelativeSource={RelativeSource AncestorType=my:Card}}"
                              IsVisible="{Binding Content, RelativeSource={RelativeSource AncestorType=my:Card}, Converter={x:Static my:NullConverter.IsPresent}}" />

            <ContentPresenter Name="PART_Trailing"
                              Grid.Row="0"
                              Grid.Column="1"
                              Padding="{Binding (my:TrailingAssist.Padding), RelativeSource={RelativeSource AncestorType=my:Card}}"
                              Margin="{Binding (my:TrailingAssist.Margin), RelativeSource={RelativeSource AncestorType=my:Card}}"
                              VerticalAlignment="{Binding (my:TrailingAssist.VerticalAlignment), RelativeSource={RelativeSource AncestorType=my:Card}}"
                              HorizontalAlignment="{Binding (my:TrailingAssist.HorizontalAlignment), RelativeSource={RelativeSource AncestorType=my:Card}}"
                              Content="{Binding Trailing, RelativeSource={RelativeSource AncestorType=my:Card}}"
                              ContentTemplate="{Binding TrailingTemplate, RelativeSource={RelativeSource AncestorType=my:Card}}">
                <ContentPresenter.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="Trailing"
                                 RelativeSource="{RelativeSource AncestorType=my:Card}"
                                 Converter="{x:Static my:NullConverter.IsPresent}" />
                        <Binding Path="(my:TrailingAssist.IsVisible)"
                                 RelativeSource="{RelativeSource AncestorType=my:Card}" />
                    </MultiBinding>
                </ContentPresenter.IsVisible>
            </ContentPresenter>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="MyNet.Card.Template.Body.MediaTop" TargetType="ContentControl">
        <Grid Name="PART_BodyGrid"
              Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType=my:Card}}"
              ColumnDefinitions="*,Auto"
              RowDefinitions="Auto,*">
            <ContentControl Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Focusable="False"
                            Template="{StaticResource MyNet.RegionLayout.LeadingHost}" />

            <Border Name="PART_TextHost"
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Padding="{StaticResource MyNet.Padding.Surface}">
                <Grid RowDefinitions="Auto,*"
                      ColumnDefinitions="*,Auto"
                      RowSpacing="{StaticResource MyNet.Spacing.Xs}">
                    <my:TitleBlock Name="PART_TitleBlock"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Title="{Binding Title, RelativeSource={RelativeSource AncestorType=my:Card}}"
                                   TitleTemplate="{Binding TitleTemplate, RelativeSource={RelativeSource AncestorType=my:Card}}"
                                   TitleFontSize="{Binding TitleFontSize, RelativeSource={RelativeSource AncestorType=my:Card}}"
                                   TitleFontWeight="{Binding TitleFontWeight, RelativeSource={RelativeSource AncestorType=my:Card}}"
                                   TitleForeground="{Binding TitleForeground, RelativeSource={RelativeSource AncestorType=my:Card}}"
                                   Subtitle="{Binding Subtitle, RelativeSource={RelativeSource AncestorType=my:Card}}"
                                   SubtitleTemplate="{Binding SubtitleTemplate, RelativeSource={RelativeSource AncestorType=my:Card}}"
                                   SubtitleFontSize="{Binding SubtitleFontSize, RelativeSource={RelativeSource AncestorType=my:Card}}"
                                   SubtitleForeground="{Binding SubtitleForeground, RelativeSource={RelativeSource AncestorType=my:Card}}" />

                    <ContentPresenter Name="PART_Content"
                                      Grid.Row="1"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="2"
                                      VerticalAlignment="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType=my:Card}}"
                                      HorizontalAlignment="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType=my:Card}}"
                                      Content="{Binding Content, RelativeSource={RelativeSource AncestorType=my:Card}}"
                                      ContentTemplate="{Binding ContentTemplate, RelativeSource={RelativeSource AncestorType=my:Card}}"
                                      IsVisible="{Binding Content, RelativeSource={RelativeSource AncestorType=my:Card}, Converter={x:Static my:NullConverter.IsPresent}}" />

                    <ContentPresenter Name="PART_Trailing"
                                      Grid.Row="0"
                                      Grid.Column="1"
                                      Padding="{Binding (my:TrailingAssist.Padding), RelativeSource={RelativeSource AncestorType=my:Card}}"
                                      Margin="{Binding (my:TrailingAssist.Margin), RelativeSource={RelativeSource AncestorType=my:Card}}"
                                      VerticalAlignment="{Binding (my:TrailingAssist.VerticalAlignment), RelativeSource={RelativeSource AncestorType=my:Card}}"
                                      HorizontalAlignment="{Binding (my:TrailingAssist.HorizontalAlignment), RelativeSource={RelativeSource AncestorType=my:Card}}"
                                      Content="{Binding Trailing, RelativeSource={RelativeSource AncestorType=my:Card}}"
                                      ContentTemplate="{Binding TrailingTemplate, RelativeSource={RelativeSource AncestorType=my:Card}}">
                        <ContentPresenter.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="Trailing"
                                         RelativeSource="{RelativeSource AncestorType=my:Card}"
                                         Converter="{x:Static my:NullConverter.IsPresent}" />
                                <Binding Path="(my:TrailingAssist.IsVisible)"
                                         RelativeSource="{RelativeSource AncestorType=my:Card}" />
                            </MultiBinding>
                        </ContentPresenter.IsVisible>
                    </ContentPresenter>
                </Grid>
            </Border>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="MyNet.Card.Template.Body.MediaLeft" TargetType="ContentControl">
        <Grid Name="PART_BodyGrid"
              Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType=my:Card}}"
              ColumnDefinitions="Auto,*"
              RowDefinitions="Auto,*"
              ColumnSpacing="0">
            <ContentControl Grid.Row="0"
                            Grid.Column="0"
                            Grid.RowSpan="2"
                            VerticalAlignment="Stretch"
                            Focusable="False"
                            Template="{StaticResource MyNet.RegionLayout.LeadingHost}" />

            <Border Name="PART_TextHost"
                    Grid.Row="0"
                    Grid.Column="1"
                    Grid.RowSpan="2"
                    Padding="{StaticResource MyNet.Padding.Surface}">
                <Grid RowDefinitions="Auto,*"
                      ColumnDefinitions="*,Auto"
                      RowSpacing="{StaticResource MyNet.Spacing.Xs}">
                    <my:TitleBlock Name="PART_TitleBlock"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Title="{Binding Title, RelativeSource={RelativeSource AncestorType=my:Card}}"
                                   TitleTemplate="{Binding TitleTemplate, RelativeSource={RelativeSource AncestorType=my:Card}}"
                                   TitleFontSize="{Binding TitleFontSize, RelativeSource={RelativeSource AncestorType=my:Card}}"
                                   TitleFontWeight="{Binding TitleFontWeight, RelativeSource={RelativeSource AncestorType=my:Card}}"
                                   TitleForeground="{Binding TitleForeground, RelativeSource={RelativeSource AncestorType=my:Card}}"
                                   Subtitle="{Binding Subtitle, RelativeSource={RelativeSource AncestorType=my:Card}}"
                                   SubtitleTemplate="{Binding SubtitleTemplate, RelativeSource={RelativeSource AncestorType=my:Card}}"
                                   SubtitleFontSize="{Binding SubtitleFontSize, RelativeSource={RelativeSource AncestorType=my:Card}}"
                                   SubtitleForeground="{Binding SubtitleForeground, RelativeSource={RelativeSource AncestorType=my:Card}}" />

                    <ContentPresenter Name="PART_Content"
                                      Grid.Row="1"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="2"
                                      VerticalAlignment="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType=my:Card}}"
                                      HorizontalAlignment="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType=my:Card}}"
                                      Content="{Binding Content, RelativeSource={RelativeSource AncestorType=my:Card}}"
                                      ContentTemplate="{Binding ContentTemplate, RelativeSource={RelativeSource AncestorType=my:Card}}"
                                      IsVisible="{Binding Content, RelativeSource={RelativeSource AncestorType=my:Card}, Converter={x:Static my:NullConverter.IsPresent}}" />

                    <ContentPresenter Name="PART_Trailing"
                                      Grid.Row="0"
                                      Grid.Column="1"
                                      Padding="{Binding (my:TrailingAssist.Padding), RelativeSource={RelativeSource AncestorType=my:Card}}"
                                      Margin="{Binding (my:TrailingAssist.Margin), RelativeSource={RelativeSource AncestorType=my:Card}}"
                                      VerticalAlignment="{Binding (my:TrailingAssist.VerticalAlignment), RelativeSource={RelativeSource AncestorType=my:Card}}"
                                      HorizontalAlignment="{Binding (my:TrailingAssist.HorizontalAlignment), RelativeSource={RelativeSource AncestorType=my:Card}}"
                                      Content="{Binding Trailing, RelativeSource={RelativeSource AncestorType=my:Card}}"
                                      ContentTemplate="{Binding TrailingTemplate, RelativeSource={RelativeSource AncestorType=my:Card}}">
                        <ContentPresenter.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="Trailing"
                                         RelativeSource="{RelativeSource AncestorType=my:Card}"
                                         Converter="{x:Static my:NullConverter.IsPresent}" />
                                <Binding Path="(my:TrailingAssist.IsVisible)"
                                         RelativeSource="{RelativeSource AncestorType=my:Card}" />
                            </MultiBinding>
                        </ContentPresenter.IsVisible>
                    </ContentPresenter>
                </Grid>
            </Border>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="MyNet.Card.Template.Body.ContentOnly" TargetType="ContentControl">
        <ContentPresenter Name="PART_Content"
                          Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType=my:Card}}"
                          VerticalAlignment="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType=my:Card}}"
                          HorizontalAlignment="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType=my:Card}}"
                          Content="{Binding Content, RelativeSource={RelativeSource AncestorType=my:Card}}"
                          ContentTemplate="{Binding ContentTemplate, RelativeSource={RelativeSource AncestorType=my:Card}}" />
    </ControlTemplate>

    <ControlTemplate x:Key="MyNet.Card.Template.Default" TargetType="my:Card">
        <Border Name="PART_Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                my:ShadowAssist.ShadowDepth="{TemplateBinding my:ShadowAssist.ShadowDepth}">
            <DockPanel>
                <ContentControl DockPanel.Dock="Top"
                                Focusable="False"
                                Template="{StaticResource MyNet.RegionLayout.HeaderBand}" />
                <ContentControl DockPanel.Dock="Bottom"
                                Focusable="False"
                                Template="{StaticResource MyNet.RegionLayout.ActionsBand}" />
                <ContentControl Name="PART_Body"
                                Focusable="False"
                                Template="{StaticResource MyNet.Card.Template.Body.Horizontal}" />
            </DockPanel>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="MyNet.Card.Template.Interactive" TargetType="my:Card">
        <Button Name="PART_ActionButton"
                HorizontalAlignment="Stretch"
                VerticalAlignment="{TemplateBinding VerticalAlignment}"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Background="{TemplateBinding Background}"
                Foreground="{TemplateBinding Foreground}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="0"
                FontFamily="{TemplateBinding FontFamily}"
                FontSize="{TemplateBinding FontSize}"
                FontStyle="{TemplateBinding FontStyle}"
                FontWeight="{TemplateBinding FontWeight}"
                my:ThemeAssist.Role="{TemplateBinding (my:ThemeAssist.Role)}"
                my:ShadowAssist.ShadowDepth="{TemplateBinding (my:ShadowAssist.ShadowDepth)}"
                Command="{TemplateBinding Command}"
                CommandParameter="{TemplateBinding CommandParameter}"
                IsEnabled="{TemplateBinding IsEnabled}"
                Focusable="{TemplateBinding Focusable}"
                Cursor="Hand"
                Classes="shadow-control is-hover"
                Theme="{StaticResource {x:Type Button}}">
            <DockPanel>
                <ContentControl DockPanel.Dock="Top"
                                Focusable="False"
                                Template="{StaticResource MyNet.RegionLayout.HeaderBand}" />
                <ContentControl DockPanel.Dock="Bottom"
                                Focusable="False"
                                Template="{StaticResource MyNet.RegionLayout.ActionsBand}" />
                <ContentControl Name="PART_Body"
                                Focusable="False"
                                Template="{StaticResource MyNet.Card.Template.Body.Horizontal}" />
            </DockPanel>
        </Button>
    </ControlTemplate>

    <ControlTheme x:Key="{x:Type my:Card}" TargetType="my:Card">

        <Setter Property="my:ThemeAssist.Category" Value="Surface" />
        <Setter Property="VerticalAlignment" Value="{StaticResource MyNet.VerticalAlignment.Control}" />
        <Setter Property="HorizontalAlignment" Value="{StaticResource MyNet.HorizontalAlignment.Control}" />
        <Setter Property="CornerRadius" Value="{StaticResource MyNet.Corners.Surface}" />
        <Setter Property="Padding" Value="{StaticResource MyNet.Padding.Surface}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="my:ShadowAssist.ShadowDepth" Value="Depth0" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="my:IconAssist.Size" Value="{StaticResource MyNet.Size.Icon.Md}" />
        <Setter Property="Trailing">
            <Template>
                <my:MaterialIcon Classes="kind-glyph is-dropdown position-right size-xl" />
            </Template>
        </Setter>
        <Setter Property="my:LeadingAssist.Padding" Value="{my:Thickness Md}" />
        <Setter Property="my:LeadingAssist.Margin" Value="{my:Thickness Sm, Right}" />
        <Setter Property="my:TrailingAssist.IsVisible" Value="False" />
        
        <Setter Property="my:HeaderAssist.Padding" Value="{StaticResource MyNet.Padding.Surface.Header.Md}" />
        <Setter Property="my:HeaderAssist.Margin" Value="0" />
        <Setter Property="my:HeaderAssist.Background" Value="Transparent" />
        <Setter Property="my:HeaderAssist.FontSize" Value="{StaticResource MyNet.Font.Size.Lg}" />
        <Setter Property="my:HeaderAssist.FontWeight" Value="{StaticResource MyNet.Font.Weight.Header}" />
        <Setter Property="my:HeaderAssist.Foreground" Value="{my:Foreground}" />

        <Setter Property="my:ActionsAssist.Padding" Value="{StaticResource MyNet.Padding.Surface.Header.Md}" />
        <Setter Property="my:ActionsAssist.Margin" Value="0" />
        <Setter Property="my:ActionsAssist.HorizontalAlignment" Value="Right" />

        <Setter Property="TitleFontSize" Value="{StaticResource MyNet.Font.Size.H5}" />
        <Setter Property="TitleFontWeight" Value="{StaticResource MyNet.Font.Weight.Header}" />
        <Setter Property="TitleForeground" Value="{my:Foreground}" />
        <Setter Property="SubtitleFontSize" Value="{StaticResource MyNet.Font.Size.Md}" />
        <Setter Property="SubtitleForeground" Value="{my:Foreground Opacity=High}" />

        <Setter Property="my:VariantAssist.DefaultBackground" Value="{my:ThemeContext Surface.Level1}" />
        <Setter Property="my:VariantAssist.DefaultBorderBrush" Value="{my:ThemeContext Surface.Border}" />
        <Setter Property="my:VariantAssist.DefaultForeground" Value="{my:ThemeContext Foreground.Primary}" />
        <Setter Property="my:VariantAssist.Background" Value="{my:ThemeRole Background}" />
        <Setter Property="my:VariantAssist.BorderBrush" Value="{my:ThemeRole BorderBrush}" />
        <Setter Property="my:VariantAssist.Foreground" Value="{my:ThemeRole Foreground, Contrast=True}" />
        <Setter Property="my:VariantAssist.BorderThickness" Value="1" />
        <Setter Property="BorderThickness" Value="{Binding $self.(my:VariantAssist.BorderThickness)}" />
        <Setter Property="Background" Value="{Binding $self.(my:VariantAssist.Background)}" />
        <Setter Property="BorderBrush" Value="{Binding $self.(my:VariantAssist.BorderBrush)}" />
        <Setter Property="Foreground" Value="{Binding $self.(my:VariantAssist.Foreground)}" />

        <Setter Property="Template" Value="{StaticResource MyNet.Card.Template.Default}" />

        <!-- Body template switching -->
        <Style Selector="^:content-only /template/ ContentControl#PART_Body">
            <Setter Property="Template" Value="{StaticResource MyNet.Card.Template.Body.ContentOnly}" />
        </Style>
        <Style Selector="^:vertical:not(:content-only) /template/ ContentControl#PART_Body">
            <Setter Property="Template" Value="{StaticResource MyNet.Card.Template.Body.Vertical}" />
        </Style>
        <Style Selector="^:layout-stat:not(:content-only) /template/ ContentControl#PART_Body">
            <Setter Property="Template" Value="{StaticResource MyNet.Card.Template.Body.Horizontal}" />
        </Style>
        <Style Selector="^:layout-media-top:not(:content-only) /template/ ContentControl#PART_Body">
            <Setter Property="Template" Value="{StaticResource MyNet.Card.Template.Body.MediaTop}" />
        </Style>
        <Style Selector="^:layout-media-left:not(:content-only) /template/ ContentControl#PART_Body">
            <Setter Property="Template" Value="{StaticResource MyNet.Card.Template.Body.MediaLeft}" />
        </Style>

        <!-- Shared body styles -->
        <Style Selector="^ /template/ ContentPresenter">
            <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="^ /template/ my|TitleBlock#PART_TitleBlock">
            <Setter Property="Spacing" Value="{StaticResource MyNet.Spacing.Xs}" />
        </Style>
        <Style Selector="^:title-empty /template/ my|TitleBlock#PART_TitleBlock">
            <Setter Property="Spacing" Value="0" />
        </Style>
        <Style Selector="^:title-empty /template/ Grid#PART_BodyGrid">
            <Setter Property="RowSpacing" Value="0" />
        </Style>
        <Style Selector="^ /template/ ContentPresenter#PART_Content">
            <Setter Property="Margin" Value="{my:Thickness Xs, Top}" />
        </Style>
        <Style Selector="^:title-empty:subtitle-empty /template/ ContentPresenter#PART_Content">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="^:title-empty:subtitle-empty /template/ my|TitleBlock#PART_TitleBlock">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- Horizontal layout -->
        <Style Selector="^:horizontal:not(:content-only)">
            <Setter Property="my:LeadingAssist.Margin" Value="{my:Thickness Md, Right}" />
        </Style>
        <Style Selector="^:horizontal:not(:content-only) /template/ Panel#PART_LeadingHost">
            <Setter Property="Grid.RowSpan" Value="2" />
        </Style>

        <!-- Vertical layout -->
        <Style Selector="^:vertical:not(:content-only) /template/ my|TitleBlock#PART_TitleBlock">
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style Selector="^:vertical:not(:content-only) /template/ Panel#PART_LeadingHost">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <!-- Stat layout -->
        <Style Selector="^:layout-stat:not(:content-only) /template/ my|TitleBlock#PART_TitleBlock">
            <Setter Property="Spacing" Value="{StaticResource MyNet.Spacing.Xxs}" />
        </Style>
        <Style Selector="^:layout-stat:not(:content-only) /template/ Panel#PART_LeadingHost">
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="^:layout-stat:not(:content-only) /template/ my|TitleBlock#PART_TitleBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Media layouts with hero leading -->
        <Style Selector="^:layout-media-top:not(:content-only)">
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="^:layout-media-top:not(:content-only) /template/ Grid#PART_BodyGrid">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="^:layout-media-top:not(:content-only) /template/ ContentPresenter#PART_Content">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="^:layout-media-top:leading-hero:not(:content-only) /template/ Panel#PART_LeadingHost">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Height" Value="160" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="^:layout-media-top:leading-hero:not(:content-only) /template/ ContentPresenter#PART_Leading">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="^:layout-media-left:not(:content-only)">
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="^:layout-media-left:not(:content-only) /template/ Grid#PART_BodyGrid">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="^:layout-media-left:not(:content-only) /template/ ContentPresenter#PART_Content">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="^:layout-media-left:leading-hero:not(:content-only) /template/ Panel#PART_LeadingHost">
            <Setter Property="Width" Value="120" />
            <Setter Property="MinHeight" Value="120" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="^:layout-media-left:leading-hero:not(:content-only) /template/ ContentPresenter#PART_Leading">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- Leading presentation -->
        <Style Selector="^:leading-badge">
            <Setter Property="my:LeadingAssist.Background" Value="{my:Foreground Opacity=Overlay}" />
            <Setter Property="my:LeadingAssist.CornerRadius" Value="{StaticResource MyNet.Corners.Md}" />
        </Style>
        <Style Selector="^:leading-plain /template/ Border#PART_LeadingBackground">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:leading-hero /template/ Border#PART_LeadingBackground">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:leading-hero">
            <Setter Property="my:LeadingAssist.Padding" Value="0" />
            <Setter Property="my:LeadingAssist.Margin" Value="0" />
        </Style>
        <Style Selector="^:leading-hero /template/ ContentPresenter#PART_Leading Image">
            <Setter Property="Stretch" Value="UniformToFill" />
        </Style>

        <Style Selector="^.is-hover:pointerover /template/ Border#PART_Root">
            <Setter Property="my:ShadowAssist.ShadowDepth" Value="{StaticResource MyNet.Shadow.Surface}" />
            <Setter Property="my:ShadowAssist.Darken" Value="True" />
        </Style>

        <Style Selector="^.size-sm">
            <Setter Property="my:LeadingAssist.Padding" Value="{my:Thickness Sm}" />
            <Setter Property="Padding" Value="{my:Thickness Sm}" />
            <Setter Property="TitleFontSize" Value="{StaticResource MyNet.Font.Size.Lg}" />
            <Setter Property="SubtitleFontSize" Value="{StaticResource MyNet.Font.Size.Sm}" />
            <Setter Property="my:HeaderAssist.FontSize" Value="{StaticResource MyNet.Font.Size.Md}" />
            <Setter Property="my:IconAssist.Size" Value="{StaticResource MyNet.Size.Icon.Sm}" />
        </Style>
        <Style Selector="^.size-md">
            <Setter Property="my:LeadingAssist.Padding" Value="{my:Thickness Md}" />
            <Setter Property="Padding" Value="{my:Thickness Md}" />
            <Setter Property="TitleFontSize" Value="{StaticResource MyNet.Font.Size.H5}" />
            <Setter Property="SubtitleFontSize" Value="{StaticResource MyNet.Font.Size.Md}" />
            <Setter Property="my:HeaderAssist.FontSize" Value="{StaticResource MyNet.Font.Size.Lg}" />
            <Setter Property="my:IconAssist.Size" Value="{StaticResource MyNet.Size.Icon.Md}" />
        </Style>
        <Style Selector="^.size-lg">
            <Setter Property="my:LeadingAssist.Padding" Value="{my:Thickness Md}" />
            <Setter Property="Padding" Value="{my:Thickness Lg}" />
            <Setter Property="TitleFontSize" Value="{StaticResource MyNet.Font.Size.H3}" />
            <Setter Property="SubtitleFontSize" Value="{StaticResource MyNet.Font.Size.Md}" />
            <Setter Property="my:HeaderAssist.FontSize" Value="{StaticResource MyNet.Font.Size.Lg}" />
            <Setter Property="my:IconAssist.Size" Value="{StaticResource MyNet.Size.Icon.Xl}" />
        </Style>

        <!-- Stat typography overrides size presets -->
        <Style Selector="^:layout-stat:not(:content-only)">
            <Setter Property="TitleFontSize" Value="{StaticResource MyNet.Font.Size.H3}" />
            <Setter Property="TitleFontWeight" Value="{StaticResource MyNet.Font.Weight.Header}" />
            <Setter Property="SubtitleFontSize" Value="{StaticResource MyNet.Font.Size.Sm}" />
            <Setter Property="SubtitleForeground" Value="{my:Foreground Opacity=High}" />
        </Style>
        <Style Selector="^.size-sm:layout-stat:not(:content-only)">
            <Setter Property="TitleFontSize" Value="{StaticResource MyNet.Font.Size.H6}" />
        </Style>
        <Style Selector="^.size-md:layout-stat:not(:content-only)">
            <Setter Property="TitleFontSize" Value="{StaticResource MyNet.Font.Size.H3}" />
        </Style>
        <Style Selector="^.size-lg:layout-stat:not(:content-only)">
            <Setter Property="TitleFontSize" Value="{StaticResource MyNet.Font.Size.H1}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="MyNet.Theme.Card.Interactive"
                  TargetType="my:Card"
                  BasedOn="{StaticResource {x:Type my:Card}}">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="my:VariantAssist.DefaultBackground" Value="{my:ThemeContext Surface.Level2}" />
        <Setter Property="my:VariantAssist.BorderThickness" Value="0" />
        <Setter Property="my:ShadowAssist.ShadowDepth" Value="{StaticResource MyNet.Shadow.Surface}" />
        <Setter Property="my:TrailingAssist.IsVisible" Value="True" />
        <Setter Property="Template" Value="{StaticResource MyNet.Card.Template.Interactive}" />
    </ControlTheme>

</ResourceDictionary>
