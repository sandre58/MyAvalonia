<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:my="http://mynet.com/avalonia"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <sys:Double x:Key="MyNet.Double.Zero">1.0</sys:Double>

    <!-- ═════════════════════════════════════════════════════════ -->
    <!-- DEFAULT TEXTFIELD THEME                                   -->
    <!-- ═════════════════════════════════════════════════════════ -->
    <ControlTheme x:Key="{x:Type my:TextField}" TargetType="my:TextField">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="PlaceholderFontSize" Value="{StaticResource MyNet.Font.Size}" />
        <Setter Property="my:VariantAssist.DefaultPrimary" Value="{my:ThemeContext Primary}" />
        <Setter Property="ActiveForeground" Value="{my:ThemeRole Primary}" />
        <Setter Property="InactiveForeground" Value="{my:ThemeContext Foreground.Primary, Opacity=Medium}" />
        <Setter Property="InnerForeground" Value="{my:ThemeContext Foreground.Primary, Opacity=High}" />
        <Setter Property="InnerFontSize" Value="{StaticResource MyNet.Font.Size}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Margin="{TemplateBinding Padding}">

                    <!-- PlaceholderText -->
                    <Border Name="PART_BorderPlaceholderText" RenderTransformOrigin="0,0">
                        <TextBlock Name="PART_PlaceholderText"
                                   FontSize="{TemplateBinding PlaceholderFontSize}"
                                   FontStyle="{TemplateBinding FontStyle}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   Foreground="{TemplateBinding InactiveForeground}"
                                   Text="{TemplateBinding PlaceholderText}" />
                    </Border>

                    <Grid ColumnDefinitions="Auto,*,Auto">

                        <!-- Prefix -->
                        <ContentPresenter Name="PART_InnerLeft"
                                          Grid.Column="0"
                                          Padding="{my:Thickness Sm, Right}"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding InnerLeftContent}"
                                          Focusable="False"
                                          Foreground="{TemplateBinding InnerForeground}"
                                          TextElement.FontSize="{TemplateBinding InnerFontSize}" />

                        <!-- Text -->
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Grid.Column="1"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />

                        <!-- Suffix -->
                        <ContentPresenter Name="PART_InnerRight"
                                          Grid.Column="2"
                                          Padding="{my:Thickness Sm, Left}"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding InnerRightContent}"
                                          Focusable="False"
                                          Foreground="{TemplateBinding InnerForeground}"
                                          TextElement.FontSize="{TemplateBinding InnerFontSize}" />
                    </Grid>
                </Grid>
            </ControlTemplate>
        </Setter>

        <!-- Default -->
        <Style Selector="^ /template/ ContentPresenter#PART_InnerRight">
            <Setter Property="IsVisible" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=InnerRightContent, Converter={x:Static my:NullConverter.IsPresent}}" />
        </Style>
        <Style Selector="^ /template/ ContentPresenter#PART_InnerLeft">
            <Setter Property="IsVisible" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=InnerLeftContent, Converter={x:Static my:NullConverter.IsPresent}}" />
        </Style>

        <!-- Use Floating PlaceholderText -->
        <Style Selector="^[UseFloatingPlaceholder=True]">
            <Style Selector="^ /template/ Border#PART_BorderPlaceholderText">
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <MultiBinding Converter="{x:Static my:TransformConverter.Group}">
                            <Binding Path="CurrentFloatingScale" RelativeSource="{RelativeSource TemplatedParent}" />
                            <Binding Path="CurrentFloatingScale" RelativeSource="{RelativeSource TemplatedParent}" />
                            <Binding Source="{StaticResource MyNet.Double.Zero}" />
                            <Binding Converter="{x:Static my:MathConverter.Multiply}"
                                     ConverterParameter="-1"
                                     Path="CurrentFloatingOffset"
                                     RelativeSource="{RelativeSource TemplatedParent}" />
                        </MultiBinding>
                    </Setter.Value>
                </Setter>
            </Style>

            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Easing="CircularEaseOut" Property="CurrentFloatingScale" Duration="{StaticResource MyNet.Animation.Slide}" />
                    <DoubleTransition Easing="CircularEaseOut" Property="CurrentFloatingOffset" Duration="{StaticResource MyNet.Animation.Slide}" />
                </Transitions>
            </Setter>

            <!-- No floating state -->
            <Style Selector="^:empty:not(:floating)">
                <Setter Property="CurrentFloatingScale" Value="1" />
                <Setter Property="CurrentFloatingOffset" Value="0" />

                <Style Selector="^ /template/ ContentPresenter#PART_InnerRight:not(:empty)">
                    <Setter Property="IsVisible" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=PlaceholderText, Converter={x:Static my:NullConverter.IsEmpty}}" />
                </Style>

                <Style Selector="^ /template/ ContentPresenter#PART_InnerLeft:not(:empty)">
                    <Setter Property="IsVisible" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=PlaceholderText, Converter={x:Static my:NullConverter.IsEmpty}}" />
                </Style>
            </Style>

            <!-- Floating state -->
            <Style Selector="^:floating:not(:empty), ^:floating, ^:not(:empty)">
                <Setter Property="CurrentFloatingScale" Value="{Binding $self.FloatingScale}" />
                <Setter Property="CurrentFloatingOffset" Value="{Binding $self.FloatingOffset}" />

                <Style Selector="^ /template/ ContentPresenter#PART_InnerRight:not(:empty)">
                    <Setter Property="IsVisible" Value="True" />
                </Style>

                <Style Selector="^ /template/ ContentPresenter#PART_InnerLeft:not(:empty)">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
            </Style>

            <!-- Focused -->
            <Style Selector="^:active">
                <Style Selector="^ /template/ TextBlock#PART_PlaceholderText">
                    <Setter Property="Foreground" Value="{Binding ActiveForeground, RelativeSource={RelativeSource TemplatedParent}}" />
                </Style>
            </Style>
        </Style>

        <!-- No Floating PlaceholderText -->
        <Style Selector="^[UseFloatingPlaceholder=False]">

            <!-- No empty -->
            <Style Selector="^:not(:empty)">

                <Style Selector="^ /template/ Border#PART_BorderPlaceholderText">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
            </Style>

            <!-- Empty -->
            <Style Selector="^:empty">
                <Style Selector="^ /template/ ContentPresenter#PART_InnerRight:not(:empty)">
                    <Setter Property="IsVisible" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=PlaceholderText, Converter={x:Static my:NullConverter.IsEmpty}}" />
                </Style>

                <Style Selector="^ /template/ ContentPresenter#PART_InnerLeft:not(:empty)">
                    <Setter Property="IsVisible" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=PlaceholderText, Converter={x:Static my:NullConverter.IsEmpty}}" />
                </Style>

                <Style Selector="^:active">

                    <Style Selector="^ /template/ Border#PART_BorderPlaceholderText">
                        <Setter Property="IsVisible">
                            <Setter.Value>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Converter="{x:Static my:NullConverter.IsEmpty}" Path="InnerRightContent" RelativeSource="{RelativeSource TemplatedParent}" />
                                    <Binding Converter="{x:Static my:NullConverter.IsEmpty}" Path="InnerLeftContent" RelativeSource="{RelativeSource TemplatedParent}" />
                                </MultiBinding>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style Selector="^ /template/ ContentPresenter#PART_InnerRight">
                        <Setter Property="IsVisible" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=InnerRightContent, Converter={x:Static my:NullConverter.IsPresent}}" />
                    </Style>
                    <Style Selector="^ /template/ ContentPresenter#PART_InnerLeft">
                        <Setter Property="IsVisible" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=InnerLeftContent, Converter={x:Static my:NullConverter.IsPresent}}" />
                    </Style>
                </Style>
            </Style>
        </Style>
    </ControlTheme>


</ResourceDictionary>
