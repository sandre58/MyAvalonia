<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:my="http://mynet.com/avalonia">

    <ControlTheme x:Key="{x:Type Border}" TargetType="Border">
        <Setter Property="Focusable" Value="False" />

        <Style Selector="^.use-transitions">
            <Setter Property="Transitions">
                <Transitions>
                    <BoxShadowsTransition Property="BoxShadow" Duration="{StaticResource MyNet.Animation.Shadow}" />
                </Transitions>
            </Setter>
        </Style>

        <!-- ═════════════════════════════════════════════════════════ -->
        <!-- KIND: CARD                                                -->
        <!-- ═════════════════════════════════════════════════════════ -->
        <Style Selector="^.kind-card">
            <Setter Property="my:ThemeAssist.Category" Value="Surface" />
            <Setter Property="my:TransitionsAssist.UseTransitions" Value="True" />
            <Setter Property="my:ShadowAssist.ShadowDepth" Value="Depth0" />
            <Setter Property="CornerRadius" Value="{StaticResource MyNet.Corners.Surface}" />
            <Setter Property="Padding" Value="{StaticResource MyNet.Padding.Surface}" />

            <!-- Default colors -->
            <Setter Property="my:VariantAssist.DefaultBackground" Value="{my:ThemeContext Surface.Level1}" />
            <Setter Property="my:VariantAssist.DefaultBorderBrush" Value="{my:ThemeContext Surface.Border}" />

            <!-- Variant -->
            <Setter Property="my:VariantAssist.Background" Value="{my:ThemeRole Background}" />
            <Setter Property="my:VariantAssist.BorderBrush" Value="{my:ThemeRole BorderBrush}" />
            <Setter Property="my:VariantAssist.BorderThickness" Value="1" />

            <!-- Theme -->
            <Setter Property="BorderThickness" Value="{Binding $self.(my:VariantAssist.BorderThickness)}" />
            <Setter Property="Background" Value="{Binding $self.(my:VariantAssist.Background)}" />
            <Setter Property="BorderBrush" Value="{Binding $self.(my:VariantAssist.BorderBrush)}" />

            <!-- Override transitions for card (instant by default) -->
            <Style Selector="^.use-transitions">
                <Setter Property="Transitions">
                    <Transitions>
                        <BoxShadowsTransition Property="BoxShadow" Duration="{StaticResource MyNet.Animation.Instant}" />
                    </Transitions>
                </Setter>
            </Style>

            <!-- Re-enable shadow transitions when explicitly requested -->
            <Style Selector="^.shadow-surface.use-transitions, ^.shadow-control.use-transitions">
                <Setter Property="Transitions">
                    <Transitions>
                        <BoxShadowsTransition Property="BoxShadow" Duration="{StaticResource MyNet.Animation.Shadow}" />
                    </Transitions>
                </Setter>
            </Style>

            <!-- Hover effect -->
            <Style Selector="^.is-hover:pointerover">
                <Setter Property="my:ShadowAssist.ShadowDepth" Value="{StaticResource MyNet.Shadow.Surface}" />
                <Setter Property="my:ShadowAssist.Darken" Value="True" />
            </Style>
        </Style>
    </ControlTheme>

    <!-- ═════════════════════════════════════════════════════════ -->
    <!-- POPUP                                                     -->
    <!-- ═════════════════════════════════════════════════════════ -->
    <ControlTheme x:Key="MyNet.Theme.Border.Popup" TargetType="Border">
        <Setter Property="VerticalAlignment" Value="{StaticResource MyNet.VerticalAlignment.Surface}" />
        <Setter Property="HorizontalAlignment" Value="{StaticResource MyNet.HorizontalAlignment.Surface}" />
        <Setter Property="Margin" Value="{StaticResource MyNet.Margin.Popup}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="my:ShadowAssist.ShadowDepth" Value="{StaticResource MyNet.Shadow.Popup}" />
        <Setter Property="CornerRadius" Value="{StaticResource MyNet.Corners.Popup}" />

        <!-- Default Theme -->
        <Setter Property="my:VariantAssist.DefaultBorderBrush" Value="{my:ThemeContext Surface.Border}" />
        <Setter Property="my:VariantAssist.DefaultBackground" Value="{my:ThemeContext Surface.Level1}" />

        <!-- Theme -->
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="{my:ThemeRole Background}" />
        <Setter Property="BorderBrush" Value="{my:ThemeRole BorderBrush}" />
        <Setter Property="TextElement.Foreground" Value="{my:ThemeBrush $self.Background, Contrast=True}" />

        <!-- Popup-specific transitions -->
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="{StaticResource MyNet.Animation.Fade}" Easing="CircularEaseOut" />
                <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource MyNet.Animation.Slide}" Easing="CircularEaseOut" />
            </Transitions>
        </Setter>
    </ControlTheme>

    <!-- ═════════════════════════════════════════════════════════ -->
    <!-- CONTROL THEME FOR STATE BORDERS                           -->
    <!-- Must be in ControlTheme to have lower priority than       -->
    <!-- template setters (so template can override Opacity)       -->
    <!-- ═════════════════════════════════════════════════════════ -->
    <ControlTheme x:Key="MyNet.Theme.Border.State" TargetType="Border">
        <Setter Property="my:TransitionsAssist.UseTransitions" Value="True" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />

        <!-- Smooth opacity transitions for state changes -->
        <Style Selector="^.use-transitions">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Easing="LinearEasing" Property="Opacity" Duration="{StaticResource MyNet.Animation.Opacity}" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

</ResourceDictionary>
