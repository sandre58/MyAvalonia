<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:my="http://mynet.com/avalonia">
    <ControlTheme x:Key="{x:Type RadioButton}" TargetType="RadioButton" BasedOn="{StaticResource MyNet.Theme.ToggleButton.CheckBox}">
        <Setter Property="my:ThemeAssist.Category" Value="Selection" />
        <Setter Property="my:ToggleButtonAssist.CheckedPath" Value="{my:MaterialGeometry RadioboxMarked}" />
        <Setter Property="my:ToggleButtonAssist.IndeterminatePath" Value="{my:MaterialGeometry RadioboxIndeterminateVariant}" />
        <Setter Property="my:ToggleButtonAssist.UncheckedPath" Value="{my:MaterialGeometry RadioboxBlank}" />
    </ControlTheme>

</ResourceDictionary>
