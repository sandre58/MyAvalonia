<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:my="http://mynet.com/avalonia">

    <!-- ═════════════════════════════════════════════════════════ -->
    <!-- DEFAULT NAVIGATION HOST THEME                             -->
    <!-- ═════════════════════════════════════════════════════════ -->
    <ControlTheme x:Key="{x:Type my:NavigationHost}" TargetType="my:NavigationHost" BasedOn="{StaticResource {x:Type TransitioningContentControl}}" />


</ResourceDictionary>
