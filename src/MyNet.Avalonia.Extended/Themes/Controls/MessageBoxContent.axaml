<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:my="http://mynet.com/avalonia"
                    xmlns:icons="clr-namespace:Material.Icons;assembly=Material.Icons">

    <ControlTheme x:Key="{x:Type my:MessageBoxContent}" TargetType="my:MessageBoxContent">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <ControlTemplate TargetType="my:MessageBoxContent">
                <my:DialogPanel Name="PART_Dialog"
                                Theme="{StaticResource MyNet.Theme.DialogPanel.MessageBox}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Header="{TemplateBinding Title}"
                                Content="{TemplateBinding Message}"
                                my:ThemeAssist.Role="Information">
                    <my:DialogPanel.LeadingTemplate>
                        <DataTemplate DataType="icons:MaterialIconKind">
                            <my:MaterialIcon Kind="{Binding}"
                                             Classes="size-lg"
                                             Foreground="{my:ThemeRole Foreground, Contrast=True}" />
                        </DataTemplate>
                    </my:DialogPanel.LeadingTemplate>
                    <my:DialogPanel.Actions>
                        <StackPanel HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="{my:Spacing Sm}">
                            <Button Name="PART_CancelButton" Content="{my:Loc Cancel}" MinWidth="90" Classes="variant-text" />
                            <Button Name="PART_NoButton" Content="{my:Loc No}" MinWidth="90" Classes="variant-outlined" />
                            <Button Name="PART_OKButton" Content="{my:Loc Ok}" MinWidth="90"
                                    my:ThemeAssist.Role="{Binding $parent[my:DialogPanel].(my:ThemeAssist.Role)}" />
                            <Button Name="PART_YesButton" Content="{my:Loc Yes}" MinWidth="90"
                                    my:ThemeAssist.Role="{Binding $parent[my:DialogPanel].(my:ThemeAssist.Role)}" />
                        </StackPanel>
                    </my:DialogPanel.Actions>
                </my:DialogPanel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^[Severity=Information] /template/ my|DialogPanel#PART_Dialog">
            <Setter Property="Leading" Value="{x:Static icons:MaterialIconKind.InformationVariantCircle}" />
            <Setter Property="my:ThemeAssist.Role" Value="Information" />
        </Style>
        <Style Selector="^[Severity=Success] /template/ my|DialogPanel#PART_Dialog">
            <Setter Property="Leading" Value="{x:Static icons:MaterialIconKind.CheckCircle}" />
            <Setter Property="my:ThemeAssist.Role" Value="Success" />
        </Style>
        <Style Selector="^[Severity=Warning] /template/ my|DialogPanel#PART_Dialog">
            <Setter Property="Leading" Value="{x:Static icons:MaterialIconKind.Alert}" />
            <Setter Property="my:ThemeAssist.Role" Value="Warning" />
        </Style>
        <Style Selector="^[Severity=Error] /template/ my|DialogPanel#PART_Dialog">
            <Setter Property="Leading" Value="{x:Static icons:MaterialIconKind.AlertCircle}" />
            <Setter Property="my:ThemeAssist.Role" Value="Error" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
