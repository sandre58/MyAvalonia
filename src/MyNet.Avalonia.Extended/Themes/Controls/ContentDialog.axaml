<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:my="http://mynet.com/avalonia">

    <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://MyNet.Avalonia.Theme.Controls/Foundation/RegionLayout.axaml" />
    </ResourceDictionary.MergedDictionaries>

    <ControlTemplate x:Key="MyNet.DialogPanel.Template" TargetType="my:DialogPanel">
        <Border Name="PART_Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
            <DockPanel>
                <ContentControl DockPanel.Dock="Top"
                                Focusable="False"
                                Template="{StaticResource MyNet.RegionLayout.HeaderBand}" />

                <ContentControl DockPanel.Dock="Bottom"
                                Focusable="False"
                                Template="{StaticResource MyNet.RegionLayout.ActionsBand}" />

                <Grid Name="PART_BodyGrid" ColumnDefinitions="Auto,*">
                    <ContentControl Name="PART_LeadingHost"
                                    Grid.Column="0"
                                    VerticalAlignment="Top"
                                    Focusable="False"
                                    Template="{StaticResource MyNet.RegionLayout.LeadingHost}" />

                    <ContentPresenter Name="PART_Content"
                                      Grid.Column="1"
                                      Padding="{TemplateBinding Padding}"
                                      VerticalAlignment="Top"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Grid>
            </DockPanel>
        </Border>
    </ControlTemplate>

    <ControlTheme x:Key="{x:Type my:DialogPanel}" TargetType="my:DialogPanel">
        <Setter Property="my:ThemeAssist.Category" Value="Surface" />
        <Setter Property="VerticalAlignment" Value="{StaticResource MyNet.VerticalAlignment.Surface}" />
        <Setter Property="Padding" Value="{StaticResource MyNet.Padding.Surface}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="my:HeaderAssist.Padding" Value="{StaticResource MyNet.Padding.Surface.Header.Md}" />
        <Setter Property="my:HeaderAssist.Background" Value="{my:ThemeContext Surface.Level0}" />
        <Setter Property="my:HeaderAssist.FontSize" Value="{StaticResource MyNet.Font.Size.H4}" />
        <Setter Property="my:HeaderAssist.FontWeight" Value="{StaticResource MyNet.Font.Weight.Header}" />
        <Setter Property="my:HeaderAssist.Foreground" Value="{my:Foreground}" />
        <Setter Property="my:ActionsAssist.Padding" Value="{StaticResource MyNet.Padding.Surface.Header.Md}" />
        <Setter Property="my:ActionsAssist.HorizontalAlignment" Value="Stretch" />
        <Setter Property="my:LeadingAssist.Margin" Value="{my:Thickness Md, Right}" />
        <Setter Property="my:LeadingAssist.VerticalAlignment" Value="Top" />
        <Setter Property="my:VariantAssist.Background" Value="{my:ThemeRole Background}" />
        <Setter Property="my:VariantAssist.BorderBrush" Value="{my:ThemeRole BorderBrush}" />
        <Setter Property="my:VariantAssist.Foreground" Value="{my:ThemeRole Foreground, Contrast=True}" />
        <Setter Property="Background" Value="{Binding $self.(my:VariantAssist.Background)}" />
        <Setter Property="BorderBrush" Value="{Binding $self.(my:VariantAssist.BorderBrush)}" />
        <Setter Property="Foreground" Value="{Binding $self.(my:VariantAssist.Foreground)}" />
        <Setter Property="Template" Value="{StaticResource MyNet.DialogPanel.Template}" />
        <Style Selector="^ /template/ ContentPresenter">
            <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="^:header-empty /template/ ContentControl#PART_LeadingHost">
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="^:header-empty /template/ ContentPresenter#PART_Content">
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </ControlTheme>

    <!-- Chromeless body inside shells; header band visible in overlay (custom Header / HeaderTemplate). -->
    <ControlTheme x:Key="{x:Type my:ContentDialog}"
                  TargetType="my:ContentDialog"
                  BasedOn="{StaticResource {x:Type my:DialogPanel}}">
        <Setter Property="Template" Value="{StaticResource MyNet.DialogPanel.Template}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{my:Thickness Md}" />
        <Setter Property="my:VariantAssist.Background" Value="Transparent" />
        <Setter Property="my:VariantAssist.BorderBrush" Value="Transparent" />
        <Setter Property="my:VariantAssist.BorderThickness" Value="0" />
        <Setter Property="my:HeaderAssist.Background" Value="{my:ThemeContext Surface.Level0}" />
        <Setter Property="my:HeaderAssist.Padding" Value="{my:Thickness Md, Right=48}" />
        <Setter Property="my:ActionsAssist.Padding" Value="{my:Thickness Md}" />
        <Setter Property="my:ActionsAssist.HorizontalAlignment" Value="Right" />
        <Setter Property="my:LeadingAssist.Background" Value="Transparent" />
        <Setter Property="my:LeadingAssist.Padding" Value="0" />

        <Style Selector="^ /template/ Border#PART_LeadingBackground">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^ /template/ ContentControl#PART_LeadingHost">
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style Selector="^.leading-badge">
            <Setter Property="my:VariantAssist.Primary" Value="{my:ThemeRole Primary}" />
            <Setter Property="my:LeadingAssist.Background" Value="{my:ThemeRole Primary, Opacity=Overlay}" />
            <Setter Property="my:LeadingAssist.CornerRadius" Value="{StaticResource MyNet.Corners.Md}" />
            <Setter Property="my:LeadingAssist.Padding" Value="{my:Thickness Sm}" />
        </Style>
        <Style Selector="^.leading-badge /template/ Border#PART_LeadingBackground">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^.leading-badge /template/ ContentPresenter#PART_Leading my|MaterialIcon">
            <Setter Property="Foreground" Value="{Binding (my:VariantAssist.Primary), RelativeSource={RelativeSource AncestorType=my:ContentDialog}}" />
        </Style>

        <Style Selector="^.actions-stretch">
            <Setter Property="my:ActionsAssist.HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style Selector="^.size-sm">
            <Setter Property="Padding" Value="{my:Thickness Sm}" />
            <Setter Property="my:ActionsAssist.Padding" Value="{my:Thickness Sm}" />
            <Setter Property="my:IconAssist.Size" Value="{StaticResource MyNet.Size.Icon.Sm}" />
        </Style>
        <Style Selector="^.size-md">
            <Setter Property="Padding" Value="{my:Thickness Md}" />
            <Setter Property="my:ActionsAssist.Padding" Value="{my:Thickness Md}" />
            <Setter Property="my:IconAssist.Size" Value="{StaticResource MyNet.Size.Icon.Md}" />
        </Style>
        <Style Selector="^.size-lg">
            <Setter Property="Padding" Value="{my:Thickness Lg}" />
            <Setter Property="my:ActionsAssist.Padding" Value="{my:Thickness Lg}" />
            <Setter Property="my:IconAssist.Size" Value="{StaticResource MyNet.Size.Icon.Lg}" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
