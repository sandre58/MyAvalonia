<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:loading="using:MyNet.UI.Loading.Models"
                    xmlns:my="http://mynet.com/avalonia">

    <!-- ════════════════════════════════════════════════════════════ -->
    <!-- Indeterminate: spinner (follows animation/size/role) + message -->
    <!-- ════════════════════════════════════════════════════════════ -->
    <DataTemplate x:Key="IndeterminateBusy" DataType="{x:Type loading:IndeterminateBusy}">
        <StackPanel MinWidth="200"
                    MaxWidth="360"
                    HorizontalAlignment="Center"
                    Spacing="{StaticResource MyNet.Spacing.Lg}">
            <my:Loader Classes="busy-spinner"
                       IsActive="True"
                       HorizontalAlignment="Center"
                       Animation="{Binding Path=Animation, RelativeSource={RelativeSource AncestorType=my:BusyIndicator}}"
                       Foreground="{Binding Path=(my:VariantAssist.Primary), RelativeSource={RelativeSource AncestorType=my:BusyIndicator}}" />

            <TextBlock Classes="text-md"
                       Text="{Binding Message}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=my:BusyIndicator}}"
                       IsVisible="{Binding Message, Converter={x:Static my:NullConverter.IsPresent}}" />

            <Button Classes="variant-text variant-outlined busy-cancel"
                    HorizontalAlignment="Center"
                    my:ThemeAssist.Role="Error"
                    Command="{Binding CancelCommand}"
                    Content="{my:Loc Cancel}"
                    my:IconAssist.Icon="{my:MaterialIcon Cancel}"
                    IsVisible="{Binding IsCancellable}" />
        </StackPanel>
    </DataTemplate>

    <!-- ════════════════════════════════════════════════════════════ -->
    <!-- Determinate: circular progress with centered value + message  -->
    <!-- ════════════════════════════════════════════════════════════ -->
    <DataTemplate x:Key="DeterminateBusy" DataType="{x:Type loading:DeterminateBusy}">
        <StackPanel MinWidth="220"
                    MaxWidth="380"
                    HorizontalAlignment="Center"
                    Spacing="{StaticResource MyNet.Spacing.Lg}">
            <ProgressBar Classes="busy-progress"
                         Theme="{StaticResource MyNet.Theme.ProgressBar.Circular}"
                         HorizontalAlignment="Center"
                         ShowProgressText="True"
                         ProgressTextFormat="{}{1:0}%"
                         Minimum="{Binding Minimum}"
                         Maximum="{Binding Maximum}"
                         Value="{Binding Value}"
                         Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=my:BusyIndicator}}"
                         my:InteractionAssist.ActiveBackground="{Binding Path=(my:VariantAssist.Primary), RelativeSource={RelativeSource AncestorType=my:BusyIndicator}}" />

            <TextBlock Classes="text-md"
                       Text="{Binding Message}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=my:BusyIndicator}}"
                       IsVisible="{Binding Message, Converter={x:Static my:NullConverter.IsPresent}}" />

            <Button Classes="variant-text variant-outlined busy-cancel"
                    HorizontalAlignment="Center"
                    my:ThemeAssist.Role="Error"
                    Command="{Binding CancelCommand}"
                    Content="{my:Loc Cancel}"
                    my:IconAssist.Icon="{my:MaterialIcon Cancel}"
                    IsVisible="{Binding IsCancellable}" />
        </StackPanel>
    </DataTemplate>

    <!-- ════════════════════════════════════════════════════════════ -->
    <!-- Progression: current step + circular progress + step history  -->
    <!-- ════════════════════════════════════════════════════════════ -->
    <DataTemplate x:Key="ProgressionBusy" DataType="{x:Type loading:ProgressionBusy}">
        <StackPanel MinWidth="320"
                    MaxWidth="460"
                    HorizontalAlignment="Center"
                    Spacing="{StaticResource MyNet.Spacing.Md}">
            <TextBlock Classes="text-h6"
                       Text="{Binding Title}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=my:BusyIndicator}}"
                       IsVisible="{Binding Title, Converter={x:Static my:NullConverter.IsPresent}}" />

            <ProgressBar Classes="busy-progress"
                         Theme="{StaticResource MyNet.Theme.ProgressBar.Circular}"
                         HorizontalAlignment="Center"
                         ShowProgressText="True"
                         ProgressTextFormat="{}{1:0}%"
                         Minimum="0"
                         Maximum="1"
                         Value="{Binding Value}"
                         Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=my:BusyIndicator}}"
                         my:InteractionAssist.ActiveBackground="{Binding Path=(my:VariantAssist.Primary), RelativeSource={RelativeSource AncestorType=my:BusyIndicator}}" />

            <Border Background="{my:ThemeContext Surface.Level3}"
                    BorderBrush="{my:ThemeContext Surface.Border}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource MyNet.Corners.Control}"
                    Padding="{my:Thickness Sm}"
                    IsVisible="{Binding Messages.Count, Converter={x:Static my:MathComparisonConverter.IsGreaterThan}, ConverterParameter=0}">
                <ScrollViewer MaxHeight="140"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True"
                                           Margin="{my:Thickness Xs, Vertical}">
                                    <my:MaterialIcon DockPanel.Dock="Left"
                                                     Kind="CheckCircleOutline"
                                                     Width="14"
                                                     Height="14"
                                                     VerticalAlignment="Center"
                                                     Margin="{my:Thickness Sm, Right}"
                                                     Foreground="{Binding Path=(my:VariantAssist.Primary), RelativeSource={RelativeSource AncestorType=my:BusyIndicator}}" />
                                    <TextBlock Classes="text-sm opacity-high"
                                               Text="{Binding}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Button Classes="variant-text variant-outlined busy-cancel"
                    HorizontalAlignment="Center"
                    my:ThemeAssist.Role="Error"
                    Command="{Binding CancelCommand}"
                    Content="{my:Loc Cancel}"
                    my:IconAssist.Icon="{my:MaterialIcon Cancel}"
                    IsVisible="{Binding IsCancellable}" />
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
