<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <NeutralLanguage>fr</NeutralLanguage>
        <Product>My .NET Avalonia</Product>
        <PackageIcon>MyAvalonia.png</PackageIcon>
        <Description>Theme-agnostic Avalonia core: globalization markup, converters, bindings, and MyNet integration.</Description>
        <PackageTags>Avalonia;UI;Converters;Localization;Markup;MyNet;Extensions;CrossPlatform;Desktop</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MyNet.Globalization" />
        <PackageReference Include="MyNet.Primitives" />
        <PackageReference Include="MyNet.Humanizer" />
        <PackageReference Include="MyNet.Observable" />
        <PackageReference Include="MyNet.Utilities" />
        <PackageReference Include="System.Reactive" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseLocalMyNetProjects)' == 'true' and Exists('..\..\..\MyNet\src\MyNet.Globalization\MyNet.Globalization.csproj')">
        <ProjectReference Include="..\..\..\MyNet\src\MyNet.Globalization\MyNet.Globalization.csproj" />
        <PackageReference Remove="MyNet.Globalization" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseLocalMyNetProjects)' == 'true' and Exists('..\..\..\MyNet\src\MyNet.Primitives\MyNet.Primitives.csproj')">
        <ProjectReference Include="..\..\..\MyNet\src\MyNet.Primitives\MyNet.Primitives.csproj" />
        <PackageReference Remove="MyNet.Primitives" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseLocalMyNetProjects)' == 'true' and Exists('..\..\..\MyNet\src\MyNet.Humanizer\MyNet.Humanizer.csproj')">
        <ProjectReference Include="..\..\..\MyNet\src\MyNet.Humanizer\MyNet.Humanizer.csproj" />
        <PackageReference Remove="MyNet.Humanizer" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseLocalMyNetProjects)' == 'true' and Exists('..\..\..\MyNet\src\MyNet.Observable\MyNet.Observable.csproj')">
        <ProjectReference Include="..\..\..\MyNet\src\MyNet.Observable\MyNet.Observable.csproj" />
        <PackageReference Remove="MyNet.Observable" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseLocalMyNetProjects)' == 'true' and Exists('..\..\..\MyNet\src\MyNet.Utilities\MyNet.Utilities.csproj')">
        <ProjectReference Include="..\..\..\MyNet\src\MyNet.Utilities\MyNet.Utilities.csproj" />
        <PackageReference Remove="MyNet.Utilities" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Update="Colors\ColorResources.resx">
        <LastGenOutput>ColorResources.Designer.cs</LastGenOutput>
        <Generator>ResXFileCodeGenerator</Generator>
      </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Colors\ColorResources.Designer.cs">
        <DependentUpon>ColorResources.resx</DependentUpon>
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
      </Compile>
    </ItemGroup>
</Project>
