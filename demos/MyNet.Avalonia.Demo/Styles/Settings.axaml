<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:my="http://mynet.com/avalonia">

        <Style Selector="HeaderedContentControl.Settings">
            <Setter Property="Foreground" Value="{my:Theme Application.Foreground}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="{my:Thickness Medium, Left}" />
            <Setter Property="Width" Value="270" />
            <Setter Property="my:IconAssist.Icon" Value="{StaticResource MyNet.Geometry.Cog}" />
            <Setter Property="my:IconAssist.IconTemplate" Value="{StaticResource MyNet.DataTemplate.PathIcon}" />
            <Setter Property="Header">
                <Template>
                    <TextBlock Text="{my:Loc Options}" />
                </Template>
            </Setter>
            <Setter Property="my:HeaderAssist.FontWeight" Value="{StaticResource MyNet.Font.Weight.Header}" />
            <Setter Property="my:HeaderAssist.FontSize" Value="{StaticResource MyNet.Font.Size.H4}" />
            <Setter Property="my:ShadowAssist.ShadowDepth" Value="{StaticResource MyNet.Shadow.Surface}" />
            <Setter Property="my:HeaderAssist.Background" Value="{my:ThemeRole}" />
            <Setter Property="my:HeaderAssist.Foreground" Value="{my:ThemeRole Contrast=True}" />
            <Setter Property="my:ThemeAssist.Role" Value="Dark" />
            <Setter Property="ClipToBounds" Value="False" />

            <Style Selector="^ > ScrollViewer">
                <Style Selector="^ > StackPanel">
                    <Setter Property="Spacing" Value="{StaticResource MyNet.Spacing.Large}" />
                </Style>
            </Style>

            <Style Selector="^ :is(TemplatedControl)">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="my:TextFieldAssist.UseFloatingWatermark" Value="True" />
            </Style>

            <Style Selector="^ HeaderedContentControl">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />

                <Style Selector="^.Labelled">
                    <Setter Property="HorizontalContentAlignment" Value="Right" />
                </Style>

                <Style Selector="^.SubCaption">
                    <Setter Property="Margin" Value="{my:Thickness Large, Top}" />
                    <Setter Property="Padding" Value="{my:Thickness Medium, Top}" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="Foreground" Value="{Binding $parent[TemplatedControl].Foreground}" />
                    <Setter Property="my:HeaderAssist.Opacity" Value="{DynamicResource MyNet.Opacity.High}" />
                    <Setter Property="my:HeaderAssist.Padding" Value="{my:Thickness Small, Bottom}" />
                    <Setter Property="my:HeaderAssist.CornerRadius" Value="{StaticResource MyNet.Corners.Surface}" />
                    <Setter Property="my:HeaderAssist.FontSize" Value="{StaticResource MyNet.Font.Size.Caption}" />
                    <Setter Property="my:HeaderAssist.Background" Value="{my:ThemeRole}" />
                    <Setter Property="my:HeaderAssist.Foreground" Value="{my:ThemeRole Contrast=True}" />
                    <Setter Property="my:HeaderAssist.VerticalAlignment" Value="Center" />
                    <Setter Property="my:HeaderAssist.HorizontalAlignment" Value="Center" />
                    <Setter Property="my:ThemeAssist.Role" Value="Dark" />
                </Style>
            </Style>

            <Style Selector="^ TextBox">
                <Setter Property="UseFloatingWatermark" Value="True" />
                <Setter Property="my:TextFieldAssist.ShowClearButton" Value="True" />
            </Style>

            <Style Selector="^ ListBox">
                <Setter Property="Theme" Value="{StaticResource MyNet.Theme.ListBox.Toggle}" />
                <Setter Property="ItemsPanel">
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </Setter>
            </Style>

            <Style Selector="^ ToggleSwitch">
                <Setter Property="OnContent" Value="{my:Loc Yes}" />
                <Setter Property="OffContent" Value="{my:Loc No}" />
            </Style>
        </Style>
</Styles>
