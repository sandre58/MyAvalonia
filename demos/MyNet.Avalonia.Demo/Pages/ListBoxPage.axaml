<pages:Page x:Class="MyNet.Avalonia.Demo.Pages.ListBoxPage"
            xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:c="using:MyNet.Avalonia.Demo.Converters"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:geo="using:MyNet.Utilities.Geography"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:my="http://mynet.com/avalonia"
            xmlns:pages="clr-namespace:MyNet.Avalonia.Demo.Pages"
            xmlns:vm="clr-namespace:MyNet.Avalonia.Demo.ViewModels"
            xmlns:vmBase="clr-namespace:MyNet.Avalonia.Demo.ViewModels.ControlCatalog"
            xmlns:v="clr-namespace:MyNet.Avalonia.Demo.Views.ControlCatalog"
            xmlns:m="clr-namespace:MyNet.Avalonia.Demo.MarkupExtensions"
            x:DataType="vm:ListBoxPageViewModel"
            x:Name="Root"
            ClipToBounds="False"
            mc:Ignorable="d">
    <pages:Page.Resources>
        <DataTemplate x:Key="MyNet.DataTemplate.Country" DataType="{x:Type geo:Country}">
            <DockPanel>
                <Image Width="16"
                       Height="16"
                       Margin="{my:Thickness Md, Right}"
                       VerticalAlignment="Center"
                       Source="{Binding Converter={x:Static c:CountryToBitmapConverter.To16}}"
                       DockPanel.Dock="Left" />
                <TextBlock Text="{my:Translate}" Foreground="{Binding $parent[Control].(TextElement.Foreground)}" />
            </DockPanel>
        </DataTemplate>
        <DataTemplate x:Key="MyNet.DataTemplate.Country.Xl" DataType="{x:Type geo:Country}">
            <Grid Width="90" Height="90" RowDefinitions="Auto,*">
                <Image Width="64" Source="{Binding Converter={x:Static c:CountryToBitmapConverter.To64}}" />
                <TextBlock Grid.Row="1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Text="{my:Translate}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="{Binding $parent[Control].(TextElement.Foreground)}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="MyNet.DataTemplate.Icon" DataType="{x:Type geo:Country}">
            <ContentControl Content="{m:RandomIcon}" />
        </DataTemplate>
    </pages:Page.Resources>

    <v:ControlCatalogView ShowContent="False">

        <v:ControlCatalogView.PlaygroundControlTemplate>
            <DataTemplate x:DataType="vmBase:ControlPlaygroundViewModel">
                <Panel>
                    <Panel.Styles>
                        <Style Selector="ListBox">
                            <Style Selector="^.icon-left ListBoxItem, ^.icon-right ListBoxItem, ^.icon-top ListBoxItem, ^.icon-bottom ListBoxItem">
                                <Setter Property="my:IconAssist.Icon">
                                    <Template>
                                        <ContentControl Content="{m:RandomIcon}" />
                                    </Template>
                                </Setter>
                            </Style>

                            <Style Selector="^[(my|ThemeAssist.Kind)=default]">
                                <Setter Property="Width" Value="300" />
                                <Setter Property="ItemsSource" Value="{m:RandomCountries Min=10, Max=200}" />
                                <Setter Property="ItemTemplate" Value="{StaticResource MyNet.DataTemplate.Country}" />

                                <Style Selector="^.layout-horizontal, ^.layout-uniform:not(.layout-vertical)">
                                    <Setter Property="Width" Value="NaN" />
                                    <Setter Property="ItemsSource" Value="{m:RandomCountries Min=8, Max=15}" />
                                </Style>

                                <Style Selector="^.layout-wrap">
                                    <Setter Property="Width" Value="NaN" />
                                    <Setter Property="ItemsSource" Value="{m:RandomCountries All=True}" />

                                    <Style Selector="^ ListBoxItem">
                                        <Setter Property="Width" Value="200" />
                                    </Style>
                                </Style>

                                <Style Selector="^.kind-cards">
                                    <Setter Property="Width" Value="NaN" />
                                    <Setter Property="ItemsSource" Value="{m:RandomCountries All=True}" />
                                    <Setter Property="ItemTemplate" Value="{StaticResource MyNet.DataTemplate.Country.Xl}" />
                                </Style>
                            </Style>

                            <Style Selector="^.kind-toggle, ^.kind-tabs, ^.kind-icon">
                                <Setter Property="Width" Value="NaN" />
                                <Setter Property="ItemsSource" Value="{m:RandomCountries Min=3, Max=5}" />
                                <Setter Property="ItemTemplate" Value="{StaticResource MyNet.DataTemplate.Country}" />

                                <Style Selector="^.layout-wrap">
                                    <Style Selector="^ ListBoxItem">
                                        <Setter Property="Width" Value="120" />
                                    </Style>
                                </Style>
                            </Style>

                            <Style Selector="^.kind-icon">
                                <Setter Property="ItemTemplate" Value="{StaticResource MyNet.DataTemplate.Icon}" />
                            </Style>
                        </Style>
                    </Panel.Styles>
                    <ListBox Theme="{Binding Appearance.ActiveTheme}"
                             my:ThemeAssist.Role="{Binding Appearance.ActiveRole}"
                             my:ItemsAssist.Role="{Binding Appearance.ActiveItemsRole}"
                             my:ClassesAssist.Classes="{Binding ComputedClasses}"
                             MaxHeight="300"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             SelectionMode="{Binding #SelectionMode.SelectedValue}"
                             SelectedIndex="0" />
                </Panel>
            </DataTemplate>
        </v:ControlCatalogView.PlaygroundControlTemplate>

        <v:ControlCatalogView.ThemeControlTemplate>
            <DataTemplate x:DataType="c:ControlDefinition">
                <Panel>
                    <Panel.Styles>
                        <Style Selector="ListBox">

                            <Style Selector="^[(my|ThemeAssist.Kind)=default]">
                                <Setter Property="ItemTemplate" Value="{StaticResource MyNet.DataTemplate.Country}" />

                                <Style Selector="^.kind-cards">
                                    <Setter Property="ItemTemplate" Value="{StaticResource MyNet.DataTemplate.Country.Xl}" />
                                </Style>
                            </Style>

                            <Style Selector="^.kind-toggle, ^[(my|ThemeAssist.Kind)=tabs], ^[(my|ThemeAssist.Kind)=icon]">
                                <Setter Property="ItemTemplate" Value="{StaticResource MyNet.DataTemplate.Country}" />
                            </Style>

                            <Style Selector="^.kind-icon">
                                <Setter Property="ItemTemplate" Value="{StaticResource MyNet.DataTemplate.Icon}" />
                            </Style>
                        </Style>
                    </Panel.Styles>
                    <ListBox Theme="{Binding Theme}"
                             my:ThemeAssist.Role="{Binding Role}"
                             my:ItemsAssist.Role="{Binding ItemsRole}"
                             my:ClassesAssist.Classes="{Binding Classes}"
                             ItemsSource="{m:RandomCountries Min=5, Max=5}"
                             SelectedIndex="{m:RandomInt Min=0, Max=4}">
                        <ListBox.Styles>
                        </ListBox.Styles>
                    </ListBox>
                </Panel>
            </DataTemplate>
        </v:ControlCatalogView.ThemeControlTemplate>

        <v:ControlCatalogView.Settings>
            <my:Form>
                <ComboBox x:Name="SelectionMode"
                          my:FormItem.Label="{my:LocObject SelectionMode}"
                          my:ItemsBehavior.EnumSourceType="{x:Type SelectionMode}"
                          SelectedValue="{x:Static SelectionMode.Single}" />
            </my:Form>
        </v:ControlCatalogView.Settings>

    </v:ControlCatalogView>
</pages:Page>