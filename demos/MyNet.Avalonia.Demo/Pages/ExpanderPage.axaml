<pages:Page x:Class="MyNet.Avalonia.Demo.Pages.ExpanderPage"
            xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:my="http://mynet.com/avalonia"
            xmlns:pages="clr-namespace:MyNet.Avalonia.Demo.Pages"
            xmlns:ctrl="clr-namespace:MyNet.Avalonia.Demo.Controls"
            xmlns:vm="clr-namespace:MyNet.Avalonia.Demo.ViewModels"
            xmlns:c="clr-namespace:MyNet.Avalonia.Demo.Converters"
            xmlns:b="clr-namespace:MyNet.Avalonia.Demo.Behaviors"
            xmlns:m="clr-namespace:MyNet.Avalonia.Demo.MarkupExtensions"
            x:DataType="vm:ExpanderPageViewModel"
            mc:Ignorable="d">

    <DockPanel>

        <!-- Settings -->
        <HeaderedContentControl Classes="Settings" DockPanel.Dock="Right">
            <ScrollViewer HorizontalScrollBarVisibility="Hidden">
                <StackPanel>
                    <UniformGrid Rows="1">
                        <Button Name="Expand"
                                HorizontalAlignment="Stretch"
                                my:IconAssist.Icon="{my:Icon ArrowExpand}"
                                Click="Expand_Click"
                                BorderThickness="0"
                                Content="{my:LocTextBlock Expand}"
                                CornerRadius="3 0 0 3" />
                        <Button Name="Collapse"
                                HorizontalAlignment="Stretch"
                                my:IconAssist.Icon="{my:Icon ArrowCollapse}"
                                Click="Collapse_Click"
                                BorderThickness="0"
                                Content="{my:LocTextBlock Collapse}"
                                CornerRadius="0" />
                    </UniformGrid>
                    <HeaderedContentControl Classes="Watermark" Header="{my:LocTextBlock Direction}">
                        <ListBox Name="Direction" SelectedIndex="0">
                            <ListBoxItem Content="{my:Icon ChevronDown}" ToolTip.Tip="{my:LocTextBlock Bottom}" />
                            <ListBoxItem Content="{my:Icon ChevronUp}" ToolTip.Tip="{my:LocTextBlock Top}" />
                            <ListBoxItem Content="{my:Icon ChevronLeft}" ToolTip.Tip="{my:LocTextBlock Left}" />
                            <ListBoxItem Content="{my:Icon ChevronRight}" ToolTip.Tip="{my:LocTextBlock Right}" />
                        </ListBox>
                    </HeaderedContentControl>
                    <HeaderedContentControl Classes="Watermark" Header="{my:LocTextBlock IconLayout}">
                        <ListBox Name="IconLayout" SelectedIndex="0">
                            <ListBoxItem Content="{my:Icon CircleOffOutline}" ToolTip.Tip="{my:LocTextBlock None}" />
                            <ListBoxItem Content="{my:Icon GamepadCircleLeft}" ToolTip.Tip="{my:LocTextBlock Left}" />
                            <ListBoxItem Content="{my:Icon GamepadCircleRight}" ToolTip.Tip="{my:LocTextBlock Right}" />
                            <ListBoxItem Content="{my:Icon GamepadCircleUp}" ToolTip.Tip="{my:LocTextBlock Top}" />
                            <ListBoxItem Content="{my:Icon GamepadCircleDown}" ToolTip.Tip="{my:LocTextBlock Bottom}" />
                        </ListBox>
                    </HeaderedContentControl>
                    <HeaderedContentControl Classes="Watermark" Header="{my:LocTextBlock HeaderLayout}">
                        <ListBox Name="HeaderAlignment" SelectedIndex="0">
                            <ListBoxItem Content="{my:Icon GamepadCircleLeft}" ToolTip.Tip="{my:LocTextBlock Left}" />
                            <ListBoxItem Content="{my:Icon GamepadCircleRight}" ToolTip.Tip="{my:LocTextBlock Right}" />
                            <ListBoxItem Content="{my:Icon GamepadCircleUp}" ToolTip.Tip="{my:LocTextBlock Top}" />
                            <ListBoxItem Content="{my:Icon GamepadCircleDown}" ToolTip.Tip="{my:LocTextBlock Bottom}" />
                            <ListBoxItem Content="{my:Icon CircleSmall}" ToolTip.Tip="{my:LocTextBlock Center}" />
                        </ListBox>
                    </HeaderedContentControl>
                </StackPanel>
            </ScrollViewer>
        </HeaderedContentControl>

        <!-- ControlThemeViewer -->
        <ctrl:ControlThemeViewer ItemsSource="{Binding ControlThemes}"
                                 MinItemWidth="320"
                                 MinItemHeight="320"
                                 IsActive="{Binding IsActive}">

            <!-- Template for standard controls -->
            <ctrl:ControlThemeViewer.ControlTemplate>
                <DataTemplate x:DataType="ctrl:ControlDescription">
                    <Expander Theme="{Binding Theme}"
                              my:ThemeAssist.Role="{Binding Role}"
                              b:SettingsBehavior.ExpandDirection="{Binding #Direction.SelectedIndex}"
                              b:SettingsBehavior.IconLayout="{Binding #IconLayout.SelectedIndex}"
                              b:SettingsBehavior.HeaderAlignmentClass="{Binding #HeaderAlignment.SelectedIndex}"
                              my:ClassesAssist.Classes="{Binding Classes}"
                              Width="300"
                              MaxWidth="300"
                              IsExpanded="{m:RandomBool}"
                              ToolTip.Tip="{Binding Content}">
                        <Expander.Header>
                            <MultiBinding Converter="{x:Static c:ContentConverter.Default}">
                                <Binding Path="ContentType" />
                                <Binding Path="Content" />
                            </MultiBinding>
                        </Expander.Header>
                        <TextBlock Text="{m:RandomText MinWords=10, MaxWords=30, MinSentences=3, MaxSentences=4}" TextWrapping="Wrap" TextAlignment="Justify" />
                    </Expander>
                </DataTemplate>
            </ctrl:ControlThemeViewer.ControlTemplate>

        </ctrl:ControlThemeViewer>

    </DockPanel>
</pages:Page>