<pages:Page x:Class="MyNet.Avalonia.Demo.Pages.ClockPage"
            xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:pages="clr-namespace:MyNet.Avalonia.Demo.Pages"
            xmlns:my="http://mynet.com/avalonia"
            xmlns:vm="clr-namespace:MyNet.Avalonia.Demo.ViewModels"
            xmlns:vmBase="clr-namespace:MyNet.Avalonia.Demo.ViewModels.ControlCatalog"
            xmlns:v="clr-namespace:MyNet.Avalonia.Demo.Views.ControlCatalog"
            xmlns:c="clr-namespace:MyNet.Avalonia.Demo.Converters"
            x:DataType="vm:ClockPageViewModel"
            x:Name="Root"
            ClipToBounds="False"
            mc:Ignorable="d">

    <v:ControlCatalogView ShowContent="False" ShowIcon="False">

        <v:ControlCatalogView.PlaygroundControlTemplate>
            <DataTemplate x:DataType="vmBase:ControlPlaygroundViewModel">
                <my:Clock Theme="{Binding Appearance.ActiveTheme}"
                          my:ThemeAssist.Role="{Binding Appearance.ActiveRole}"
                          my:ItemsAssist.Role="{Binding Appearance.ActiveItemsRole}"
                          my:ClassesAssist.Classes="{Binding ComputedClasses}"
                          Height="150"
                          Width="150"
                          IsSmooth="{Binding #IsSmooth.IsChecked}"
                          ShowHourHand="{Binding #ShowHourHand.IsSelected}"
                          ShowHourTicks="{Binding #ShowHourTicks.IsSelected}"
                          ShowMinuteHand="{Binding #ShowMinuteHand.IsSelected}"
                          ShowMinuteTicks="{Binding #ShowMinuteTicks.IsSelected}"
                          ShowSecondHand="{Binding #ShowSecondHand.IsSelected}"
                          LiveUpdate="{Binding #LiveUpdate.IsChecked}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
            </DataTemplate>
        </v:ControlCatalogView.PlaygroundControlTemplate>

        <v:ControlCatalogView.ThemeControlTemplate>
            <DataTemplate x:DataType="c:ControlDefinition">
                <my:Clock Theme="{Binding Theme}"
                          my:ThemeAssist.Role="{Binding Role}"
                          my:ItemsAssist.Role="{Binding ItemsRole}"
                          my:ClassesAssist.Classes="{Binding Classes}"
                          Height="150"
                          Width="150" />
            </DataTemplate>
        </v:ControlCatalogView.ThemeControlTemplate>

        <v:ControlCatalogView.Settings>
            <my:Form>
                <ListBox my:FormItem.Label="{my:LocObject Hands}" SelectionMode="Multiple,Toggle">
                    <ListBoxItem Name="ShowHourHand" Content="{my:Loc Hours}" IsSelected="True" />
                    <ListBoxItem Name="ShowMinuteHand" Content="{my:Loc Minutes}" IsSelected="True" />
                    <ListBoxItem Name="ShowSecondHand" Content="{my:Loc Seconds}" IsSelected="True" />
                </ListBox>
                <ListBox my:FormItem.Label="{my:LocObject Ticks}" SelectionMode="Multiple,Toggle">
                    <ListBoxItem Name="ShowHourTicks" Content="{my:Loc Hours}" IsSelected="True" />
                    <ListBoxItem Name="ShowMinuteTicks" Content="{my:Loc Minutes}" IsSelected="True" />
                </ListBox>
                <ToggleSwitch Name="IsSmooth" my:FormItem.Label="{my:LocObject IsSmooth}" IsChecked="False" />
                <ToggleSwitch Name="LiveUpdate" my:FormItem.Label="{my:LocObject LiveUpdate}" IsChecked="True" />
            </my:Form>
        </v:ControlCatalogView.Settings>

    </v:ControlCatalogView>
</pages:Page>