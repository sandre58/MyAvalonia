<pages:Page x:Class="MyNet.Avalonia.Demo.Pages.FormsPage"
            xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:my="http://mynet.com/avalonia"
            xmlns:pages="clr-namespace:MyNet.Avalonia.Demo.Pages"
            xmlns:samples="clr-namespace:MyNet.Avalonia.Demo.Views.Samples"
            xmlns:vm="clr-namespace:MyNet.Avalonia.Demo.ViewModels"
            xmlns:u="clr-namespace:MyNet.Utilities;assembly=MyNet.Utilities"
            my:ViewModelAssist.AutoWire="True"
            x:DataType="vm:FormsViewModel"
            ClipToBounds="False"
            mc:Ignorable="d">
    <ScrollViewer IsEnabled="{Binding $parent[pages:FormsPage].IsActive}">
        <Border Width="550"
                Padding="{my:Thickness ExtraLarge}"
                HorizontalAlignment="Left"
                Classes="Solid"
                Theme="{StaticResource MyNet.Theme.Border.Card}">
            <samples:FormContent DataContext="{Binding}" />
        </Border>
    </ScrollViewer>
</pages:Page>