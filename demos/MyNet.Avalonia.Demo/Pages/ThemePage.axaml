<pages:Page x:Class="MyNet.Avalonia.Demo.Pages.ThemePage"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:my="http://mynet.com/avalonia"
        xmlns:pages="clr-namespace:MyNet.Avalonia.Demo.Pages"
        xmlns:vm="clr-namespace:MyNet.Avalonia.Demo.ViewModels"
        xmlns:t="using:MyNet.UI.Theming"
        x:DataType="vm:ThemePageViewModel"
        mc:Ignorable="d">

<DockPanel>
    <!-- Settings -->
    <HeaderedContentControl Classes="Settings" DockPanel.Dock="Right">
        <ScrollViewer HorizontalScrollBarVisibility="Hidden">
            <StackPanel Spacing="{StaticResource MyNet.Spacing.Md}">
                <!-- Theme Selection -->
                <HeaderedContentControl Classes="kind-label variant-watermark" Header="Theme Variant">
                    <ListBox ItemsSource="{Binding AvailableThemeVariants}" 
                             SelectedItem="{Binding Base}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="t:IThemeBase">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <!--<PathIcon Data="{my:Icon {Binding Icon}}" Width="20" Height="20" />-->
                                    <TextBlock Text="{Binding Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </HeaderedContentControl>
                    
                <!-- Primary Color Picker -->
                <my:ColorPickerEx my:TextFieldAssist.ShowClipboardButton="True" 
                                  PlaceholderText="Primary Color" 
                                  SelectedValue="{Binding PrimaryColor}" />
                    
                <!-- Accent Color Picker -->
                <my:ColorPickerEx my:TextFieldAssist.ShowClipboardButton="True" 
                                  PlaceholderText="Accent Color" 
                                  SelectedValue="{Binding AccentColor}" />
            </StackPanel>
        </ScrollViewer>
    </HeaderedContentControl>


        <!-- Content -->
        <ScrollViewer>
            <StackPanel Classes="size-lg" Spacing="{StaticResource MyNet.Spacing.Xl}">

                <!-- Overview Section -->
                <HeaderedContentControl Classes="Text H2" Header="Theme Overview">
                    <StackPanel Spacing="{StaticResource MyNet.Spacing.Lg}">
                        <TextBlock Classes="Secondary Caption" 
                                   Text="The theme system provides a consistent color palette across the application. Customize the theme variant (Light/Dark/DarkBlue/HighContrast) and primary/accent colors to match your brand."
                                   TextWrapping="Wrap" />
                        
                        <UniformGrid Columns="2" Rows="1">
                            <!-- Current Theme Info -->
                            <Border Margin="{my:Thickness Sm, Right}"
                                    Background="{my:Theme Surface.Level4}"
                                    BorderBrush="{my:Theme Control.Border}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="20">
                                <StackPanel Spacing="{StaticResource MyNet.Spacing.Md}">
                                    <TextBlock Classes="Caption Bold" Text="Current Theme" />
                                    <StackPanel Spacing="{StaticResource MyNet.Spacing.Sm}">
                                        <DockPanel>
                                            <TextBlock Classes="Caption" Text="Variant: " />
                                            <TextBlock Classes="Caption Bold" Text="{Binding Base.Name}" />
                                        </DockPanel>
                                        <DockPanel>
                                            <TextBlock Classes="Caption" Text="Primary: " />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Width="20" Height="20" 
                                                        Background="{my:Theme Primary}" 
                                                        CornerRadius="4" />
                                                <TextBlock Classes="Caption" Text="{Binding PrimaryColor}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <DockPanel>
                                            <TextBlock Classes="Caption" Text="Accent: " />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Width="20" Height="20" 
                                                        Background="{my:Theme Accent}" 
                                                        CornerRadius="4" />
                                                <TextBlock Classes="Caption" Text="{Binding AccentColor}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Quick Preview -->
                            <Border Margin="{my:Thickness Sm, Left}"
                                    Background="{my:Theme Surface.Level4}"
                                    BorderBrush="{my:Theme Control.Border}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="20">
                                <StackPanel Spacing="{StaticResource MyNet.Spacing.Md}">
                                    <TextBlock Classes="Caption Bold" Text="Quick Preview" />
                                    <StackPanel Spacing="{StaticResource MyNet.Spacing.Sm}">
                                        <UniformGrid Columns="3" Rows="1">
                                            <Button Content="Primary" Classes="Solid Primary" Margin="2" />
                                            <Button Content="Accent" Classes="Solid Accent" Margin="2" />
                                            <Button Content="Default" Classes="Solid" Margin="2" />
                                        </UniformGrid>
                                        <UniformGrid Columns="3" Rows="1">
                                            <Button Content="Success" Classes="Solid Success" Margin="2" />
                                            <Button Content="Warning" Classes="Solid Warning" Margin="2" />
                                            <Button Content="Danger" Classes="Solid Danger" Margin="2" />
                                        </UniformGrid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </HeaderedContentControl>

                <!-- All Brushes by Groups -->
<!--                <ItemsControl ItemsSource="{Binding BrushGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:BrushGroup">
                            <HeaderedContentControl Classes="Text H2" Header="{Binding Name}">
                                <StackPanel Spacing="{StaticResource MyNet.Spacing.Md}">
                                    <TextBlock Classes="Secondary Caption" 
                                               Text="{Binding Description}"
                                               TextWrapping="Wrap" />
                                    
                                    <ItemsControl ItemsSource="{Binding BrushKeys}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="x:String">
                                                <Border Width="200" Height="100"
                                                        Margin="5"
                                                        Background="{my:Theme {Binding}}"
                                                        BorderBrush="{my:Theme Control.Border}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="10">
                                                    <StackPanel VerticalAlignment="Center" Spacing="4">
                                                        <TextBlock Classes="Caption Bold" 
                                                                   Text="{Binding}" 
                                                                   TextWrapping="Wrap"
                                                                   HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </HeaderedContentControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>-->

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</pages:Page>