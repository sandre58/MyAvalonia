<pages:Page x:Class="MyNet.Avalonia.Demo.Pages.SplitViewPage"
            xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:pages="clr-namespace:MyNet.Avalonia.Demo.Pages"
            mc:Ignorable="d"
            xmlns:my="http://mynet.com/avalonia"
            xmlns:ctrl="clr-namespace:MyNet.Avalonia.Demo.Controls"
            xmlns:vm="clr-namespace:MyNet.Avalonia.Demo.ViewModels"
            xmlns:samples="clr-namespace:MyNet.Avalonia.Demo.Views.Samples"
            x:DataType="vm:SplitViewPageViewModel"
            ClipToBounds="False">

    <DockPanel>
        <!-- Settings -->
        <HeaderedContentControl Classes="Settings" DockPanel.Dock="Right">
            <ScrollViewer HorizontalScrollBarVisibility="Hidden">
                <StackPanel>
                    <HeaderedContentControl Classes="Labelled" Header="{my:LocTextBlock IsPaneOpen}">
                        <ToggleSwitch Name="IsPaneOpen" IsChecked="False" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Classes="Labelled" Header="{my:LocTextBlock UseOverlay}">
                        <ToggleSwitch Name="UseOverlay" IsChecked="False" />
                    </HeaderedContentControl>
                    <ComboBox Name="DisplayMode"
                              DisplayMemberBinding="{ReflectionBinding Display}"
                              ItemsSource="{my:EnumSource {x:Type SplitViewDisplayMode}}"
                              PlaceholderText="{my:Loc DisplayMode}"
                              SelectedIndex="0"
                              SelectedValueBinding="{ReflectionBinding Value}" />
                    <HeaderedContentControl Classes="Watermark" Header="{my:LocTextBlock Placement}">
                        <ListBox Name="Placement"
                                 DisplayMemberBinding="{ReflectionBinding Display}"
                                 ItemTemplate="{x:Null}"
                                 ItemsSource="{my:EnumSource {x:Type SplitViewPanePlacement}}"
                                 SelectedIndex="0"
                                 SelectedValueBinding="{ReflectionBinding Value}" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Classes="Watermark" ClipToBounds="False" Header="{my:LocTextBlock CompactPaneLength}">
                        <Slider Name="CompactPaneLength"
                                IsSnapToTickEnabled="True"
                                Maximum="100"
                                Minimum="0"
                                Value="50" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Classes="Watermark" ClipToBounds="False" Header="{my:LocTextBlock OpenPaneLength}">
                        <Slider Name="OpenPaneLength"
                                IsSnapToTickEnabled="True"
                                Maximum="500"
                                Minimum="100"
                                Value="250" />
                    </HeaderedContentControl>
                </StackPanel>
            </ScrollViewer>
        </HeaderedContentControl>

        <ctrl:ControlThemeViewer ItemsSource="{Binding ControlThemes}"
                                 MinItemWidth="650"
                                 MinItemHeight="550"
                                 IsActive="{Binding IsActive}">

            <ctrl:ControlThemeViewer.ControlTemplate>
                <DataTemplate x:DataType="ctrl:ControlDescription">
                    <SplitView Theme="{Binding Theme}"
                               my:ThemeAssist.Role="{Binding Role}"
                               my:ClassesAssist.Classes="{Binding Classes}"
                               CompactPaneLength="{Binding #CompactPaneLength.Value}"
                               DisplayMode="{Binding #DisplayMode.SelectedValue}"
                               IsPaneOpen="{Binding #IsPaneOpen.IsChecked}"
                               OpenPaneLength="{Binding #OpenPaneLength.Value}"
                               PanePlacement="{Binding #Placement.SelectedValue}"
                               UseLightDismissOverlayMode="{Binding #UseOverlay.IsChecked}"
                               Height="500"
                               Width="600"
                               ToolTip.Tip="{Binding Content}">
                        <SplitView.Pane>
                            <samples:LargeContent1 Width="NaN" />
                        </SplitView.Pane>
                        <SplitView.Content>
                            <samples:ExtraLargeContent1 />
                        </SplitView.Content>
                    </SplitView>
                </DataTemplate>
            </ctrl:ControlThemeViewer.ControlTemplate>

        </ctrl:ControlThemeViewer>

    </DockPanel>
</pages:Page>