<pages:Page x:Class="MyNet.Avalonia.Demo.Pages.FormPage"
            xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:my="http://mynet.com/avalonia"
            xmlns:pages="clr-namespace:MyNet.Avalonia.Demo.Pages"
            xmlns:samples="clr-namespace:MyNet.Avalonia.Demo.Views.Samples"
            xmlns:vm="clr-namespace:MyNet.Avalonia.Demo.ViewModels"
            x:DataType="vm:FormPageViewModel"
            ClipToBounds="False"
            mc:Ignorable="d">
    <ScrollViewer>
        <Border Width="550"
                Padding="{my:Thickness Xl}"
                HorizontalAlignment="Left"
                Classes="Solid"
                Theme="{StaticResource MyNet.Theme.Border.Card}">
            <samples:FormContent DataContext="{Binding}" />
        </Border>
    </ScrollViewer>
</pages:Page>