<pages:Page x:Class="MyNet.Avalonia.Demo.Pages.CalendarPage"
            xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:my="http://mynet.com/avalonia"
            xmlns:pages="clr-namespace:MyNet.Avalonia.Demo.Pages"
            xmlns:v="clr-namespace:MyNet.Avalonia.Demo.Views.ControlCatalog"
            xmlns:vm="clr-namespace:MyNet.Avalonia.Demo.ViewModels"
            xmlns:vmBase="clr-namespace:MyNet.Avalonia.Demo.ViewModels.ControlCatalog"
            xmlns:c="clr-namespace:MyNet.Avalonia.Demo.Converters"
            x:DataType="vm:CalendarPageViewModel"
            x:Name="Root"
            mc:Ignorable="d">

    <v:ControlCatalogView ShowContent="False" ShowIcon="False">

        <v:ControlCatalogView.PlaygroundControlTemplate>
            <DataTemplate x:DataType="vmBase:ControlPlaygroundViewModel">
                <StackPanel Classes="gap-lg"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Calendar my:ThemeAssist.Role="{Binding Appearance.ActiveRole}"
                              my:ItemsAssist.Role="{Binding Appearance.ActiveItemsRole}"
                              my:ClassesAssist.Classes="{Binding ComputedClasses}"
                              SelectionMode="{Binding #SelectionMode.SelectedValue}"
                              AllowTapRangeSelection="{Binding #AllowTapRangeSelection.IsChecked}" />
                    <my:Calendar my:ThemeAssist.Role="{Binding Appearance.ActiveRole}"
                                 my:ItemsAssist.Role="{Binding Appearance.ActiveItemsRole}"
                                 my:ClassesAssist.Classes="{Binding ComputedClasses}"
                                 SelectionMode="{Binding #SelectionMode.SelectedValue}"
                                 AllowTapRangeSelection="{Binding #AllowTapRangeSelection.IsChecked}" />
                </StackPanel>
            </DataTemplate>
        </v:ControlCatalogView.PlaygroundControlTemplate>

        <v:ControlCatalogView.ThemeControlTemplate>
            <DataTemplate x:DataType="c:ControlDefinition">
                <StackPanel Classes="gap-md" Orientation="Horizontal">
                    <Calendar my:ThemeAssist.Role="{Binding Role}" my:ItemsAssist.Role="{Binding ItemsRole}" my:ClassesAssist.Classes="{Binding Classes}" />
                    <my:Calendar my:ThemeAssist.Role="{Binding Role}" my:ItemsAssist.Role="{Binding ItemsRole}" my:ClassesAssist.Classes="{Binding Classes}" />
                </StackPanel>
            </DataTemplate>
        </v:ControlCatalogView.ThemeControlTemplate>

        <v:ControlCatalogView.Settings>
            <my:Form>
                <ComboBox x:Name="SelectionMode"
                          my:FormItem.Label="{my:LocObject SelectionMode}"
                          my:ItemsBehavior.EnumSourceType="{x:Type CalendarSelectionMode}"
                          SelectedIndex="0" />
                <ToggleSwitch x:Name="AllowTapRangeSelection"
                              my:FormItem.Label="{my:LocObject AllowTapRangeSelection}"
                              IsChecked="False" />
            </my:Form>
        </v:ControlCatalogView.Settings>

    </v:ControlCatalogView>
</pages:Page>