<pages:Page x:Class="MyNet.Avalonia.Demo.Pages.ClockSelectorPage"
            xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:pages="clr-namespace:MyNet.Avalonia.Demo.Pages"
            xmlns:my="http://mynet.com/avalonia"
            xmlns:vm="clr-namespace:MyNet.Avalonia.Demo.ViewModels"
            xmlns:vmBase="clr-namespace:MyNet.Avalonia.Demo.ViewModels.ControlCatalog"
            xmlns:v="clr-namespace:MyNet.Avalonia.Demo.Views.ControlCatalog"
            xmlns:u="clr-namespace:MyNet.Utilities.DateTimes;assembly=MyNet.Utilities"
            xmlns:c="clr-namespace:MyNet.Avalonia.Demo.Converters"
            x:DataType="vm:ClockSelectorPageViewModel"
            x:Name="Root"
            ClipToBounds="False"
            mc:Ignorable="d">

    <v:ControlCatalogView ShowContent="False" ShowIcon="False">

        <v:ControlCatalogView.PlaygroundControlTemplate>
            <DataTemplate x:DataType="vmBase:ControlPlaygroundViewModel">
                <StackPanel Classes="gap-md"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <my:ClockSelector x:Name="Clock"
                                      Width="180"
                                      Height="180"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"
                                      ShowSeconds="{Binding #ShowSeconds.IsChecked}"
                                      TimeFormat="{Binding #TimeFormat.SelectedValue}"
                                      my:ThemeAssist.Role="{Binding Appearance.ActiveRole}"
                                      my:ItemsAssist.Role="{Binding Appearance.ActiveItemsRole}"
                                      my:ClassesAssist.Classes="{Binding ComputedClasses}" />
                    <ListBox HorizontalAlignment="Center"
                             Classes="kind-toggle"
                             SelectedValue="{Binding #Clock.IsAm, Mode=TwoWay}"
                             SelectedValueBinding="{Binding DataContext, x:DataType=ListBoxItem}">
                        <ListBoxItem DataContext="{x:True}" Content="{my:Loc Am, Casing=AllCaps}" />
                        <ListBoxItem DataContext="{x:False}" Content="{my:Loc Pm, Casing=AllCaps}" />
                    </ListBox>
                    <TextBlock Text="{Binding #Clock.SelectedValue}" HorizontalAlignment="Center" />
                </StackPanel>
            </DataTemplate>
        </v:ControlCatalogView.PlaygroundControlTemplate>

        <v:ControlCatalogView.ThemeControlTemplate>
            <DataTemplate x:DataType="c:ControlDefinition">
                <my:ClockSelector Width="180"
                                  Height="180"
                                  my:ThemeAssist.Role="{Binding Role}"
                                  my:ItemsAssist.Role="{Binding ItemsRole}"
                                  my:ClassesAssist.Classes="{Binding Classes}" />
            </DataTemplate>
        </v:ControlCatalogView.ThemeControlTemplate>

        <v:ControlCatalogView.Settings>
            <my:Form x:DataType="vm:ClockSelectorPageViewModel" DataContext="{Binding #Root.DataContext}">
                <ToggleSwitch x:Name="ShowSeconds" my:FormItem.Label="{my:LocObject UseSeconds}" IsChecked="True" />
                    <ListBox my:FormItem.Label="{my:LocObject Format}"
                             x:Name="TimeFormat"
                             my:ItemsBehavior.EnumSourceType="{x:Type u:TimeFormat}"
                             SelectedValue="{x:Static u:TimeFormat.TwentyFourHour}" />
                <Button Content="{my:Loc Restore}"
                        my:IconAssist.Icon="{my:Icon Refresh}"
                        Click="Restore_Click"
                        my:FormItem.NoLabel="True" />
            </my:Form>
        </v:ControlCatalogView.Settings>

    </v:ControlCatalogView>
</pages:Page>