<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyNet.Avalonia.PerfTest.ViewModels"
             x:Class="MyNet.Avalonia.PerfTest.Views.ComplexLayoutView"
             x:DataType="vm:ComplexLayoutViewModel">

    <DockPanel>
        <TextBlock DockPanel.Dock="Top" 
                  Text="Complex Layout - 20 Sections × 15 Items" 
                  FontSize="24" 
                  FontWeight="Bold"
                  Margin="0,0,0,20"/>

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                Margin="0,0,0,15"
                                Padding="15"
                                CornerRadius="8"
                                UseLayoutRounding="True">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Binding Title}" 
                                          FontSize="18" 
                                          FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Description}" 
                                          FontSize="12" 
                                          Opacity="0.7"/>
                                
                                <!-- OPTIMIZATION: Use simpler layout and add UseLayoutRounding -->
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                                    Margin="5"
                                                    Padding="10"
                                                    CornerRadius="4"
                                                    Width="180"
                                                    Height="100"
                                                    UseLayoutRounding="True">
                                                <StackPanel Spacing="5">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <TextBlock Text="{Binding Icon}" FontSize="20"/>
                                                        <TextBlock Text="{Binding Title}" 
                                                                  FontWeight="SemiBold"
                                                                  VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Content}" 
                                                              TextWrapping="Wrap"
                                                              FontSize="11"
                                                              Opacity="0.8"/>
                                                    <Border Height="3" 
                                                            Background="{Binding Color}"
                                                            CornerRadius="2"
                                                            HorizontalAlignment="Stretch"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>

</UserControl>
