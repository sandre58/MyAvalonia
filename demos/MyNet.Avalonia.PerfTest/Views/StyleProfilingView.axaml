<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:MyNet.Avalonia.PerfTest.ViewModels" x:Class="MyNet.Avalonia.PerfTest.Views.StyleProfilingView" x:DataType="vm:StyleProfilingViewModel"><DockPanel><StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,20"><TextBlock Text="Style Profiling" FontSize="24" FontWeight="Bold"/><StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Analyser les styles" Command="{Binding ProfileStylesCommand}"/><TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontStyle="Italic"/></StackPanel></StackPanel><Grid ColumnDefinitions="*,*" ColumnSpacing="10"><Border Grid.Column="0" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" Padding="10" CornerRadius="8"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Style Counts" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/><ScrollViewer><ItemsControl ItemsSource="{Binding Results}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Padding="8" Margin="0,0,0,5" CornerRadius="4"><StackPanel Spacing="3"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock FontSize="12"><Run Text="Styles/Selectors: "/><Run Text="{Binding StyleCount}" FontWeight="Bold"/></TextBlock><TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.7"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></DockPanel></Border><Border Grid.Column="1" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" Padding="10" CornerRadius="8"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Rapport" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/><ScrollViewer><TextBlock Text="{Binding Report}" FontFamily="Consolas,Courier New,monospace" FontSize="11" TextWrapping="Wrap"/></ScrollViewer></DockPanel></Border></Grid></DockPanel></UserControl>
