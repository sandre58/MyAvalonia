<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyNet.Avalonia.PerfTest.ViewModels"
             x:Class="MyNet.Avalonia.PerfTest.Views.DataGridView"
             x:DataType="vm:DataGridViewModel">

    <DockPanel>
        <TextBlock DockPanel.Dock="Top" 
                  Text="DataGrid Performance Test - 500 Items" 
                  FontSize="24" 
                  FontWeight="Bold"
                  Margin="0,0,0,20"/>

        <DataGrid ItemsSource="{Binding Items}"
                  IsReadOnly="True"
                  GridLinesVisibility="All"
                  BorderThickness="1"
                  BorderBrush="Gray">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="300"/>
                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="100"/>
                <DataGridTextColumn Header="Percentage" Binding="{Binding PercentageFormatted}" Width="100"/>
                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='{}{0:dd/MM/yyyy}'}" Width="120"/>
                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="80"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="Tags" Binding="{Binding Tags}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>

</UserControl>
