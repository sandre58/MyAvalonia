<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:my="http://mynet.com/avalonia"
             xmlns:vm="using:MyNet.Avalonia.PerfTest.ViewModels"
             x:Class="MyNet.Avalonia.PerfTest.Views.ThemeListView"
             x:DataType="vm:ThemeListViewModel">

    <DockPanel>
        <TextBlock DockPanel.Dock="Top"
                   Classes="has-role"
                   Text="Theme List Performance Test - 1000 Items (variant + has-role)"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20" />

        <ListBox ItemsSource="{Binding Items}"
                 UseLayoutRounding="True">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Classes="variant-outlined"
                            Padding="10"
                            Margin="0,2"
                            UseLayoutRounding="True">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0"
                                    Width="48"
                                    Height="48"
                                    Classes="variant-solid"
                                    Margin="0,0,10,0">
                                <TextBlock Classes="has-role"
                                           Text="{Binding Id}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold" />
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock Classes="has-role"
                                           Text="{Binding Title}"
                                           FontWeight="SemiBold"
                                           FontSize="14" />
                                <TextBlock Classes="has-role"
                                           Text="{Binding Subtitle}"
                                           FontSize="12"
                                           Opacity="0.85" />
                                <TextBlock Classes="has-role"
                                           Text="{Binding Description}"
                                           FontSize="11"
                                           Opacity="0.75"
                                           TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <TextBlock Classes="has-role" Text="★★★★★" FontSize="12" />
                                    <TextBlock Classes="has-role"
                                               Text="{Binding Rating, StringFormat='({0})'}"
                                               FontSize="11"
                                               Opacity="0.7"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Spacing="5"
                                        HorizontalAlignment="Right">
                                <TextBlock Classes="has-role"
                                           Text="{Binding Price, StringFormat='{}{0:C}'}"
                                           FontWeight="Bold"
                                           FontSize="16" />
                                <TextBlock Classes="has-role variant-solid"
                                           Text="In Stock"
                                           FontSize="12"
                                           IsVisible="{Binding InStock}" />
                                <TextBlock Classes="has-role"
                                           Text="Out of Stock"
                                           FontSize="12"
                                           IsVisible="{Binding !InStock}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
