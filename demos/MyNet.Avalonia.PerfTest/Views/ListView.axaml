<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyNet.Avalonia.PerfTest.ViewModels"
             x:Class="MyNet.Avalonia.PerfTest.Views.ListView"
             x:DataType="vm:ListViewModel">

    <DockPanel>
        <TextBlock DockPanel.Dock="Top" 
                  Text="List Performance Test - 1000 Items" 
                  FontSize="24" 
                  FontWeight="Bold"
                  Margin="0,0,0,20"/>

        <ListBox ItemsSource="{Binding Items}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                            Padding="10"
                            Margin="0,2"
                            CornerRadius="4">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <!-- Placeholder for image -->
                            <Border Grid.Column="0"
                                    Width="48"
                                    Height="48"
                                    Background="{DynamicResource SystemAccentColor}"
                                    CornerRadius="4"
                                    Margin="0,0,10,0">
                                <TextBlock Text="{Binding Id}" 
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="White"
                                          FontWeight="Bold"/>
                            </Border>

                            <!-- Content -->
                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock Text="{Binding Title}" 
                                          FontWeight="SemiBold"
                                          FontSize="14"/>
                                <TextBlock Text="{Binding Subtitle}" 
                                          FontSize="12"
                                          Opacity="0.7"/>
                                <TextBlock Text="{Binding Description}" 
                                          FontSize="11"
                                          Opacity="0.6"
                                          TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <TextBlock Text="★" FontSize="14" Foreground="#FFB300"/>
                                    <TextBlock Text="★" FontSize="14" Foreground="#FFB300"/>
                                    <TextBlock Text="★" FontSize="14" Foreground="#FFB300"/>
                                    <TextBlock Text="★" FontSize="14" Foreground="#FFB300"/>
                                    <TextBlock Text="★" FontSize="14" Foreground="#FFB300"/>
                                    <TextBlock Text="{Binding Rating, StringFormat='({0})'}" 
                                              FontSize="11" 
                                              Opacity="0.7"
                                              Margin="5,0,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Right info -->
                            <StackPanel Grid.Column="2" 
                                       Spacing="5"
                                       HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Price, StringFormat='{}{0:C}'}" 
                                          FontWeight="Bold"
                                          FontSize="16"/>
                                <TextBlock Text="In Stock" 
                                          Foreground="Green"
                                          FontSize="12"
                                          IsVisible="{Binding InStock}"/>
                                <TextBlock Text="Out of Stock" 
                                          Foreground="Red"
                                          FontSize="12"
                                          IsVisible="{Binding !InStock}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>

</UserControl>
