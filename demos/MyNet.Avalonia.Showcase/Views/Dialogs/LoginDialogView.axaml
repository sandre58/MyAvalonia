<my:ContentDialog x:Class="MyNet.Avalonia.Showcase.Views.Dialogs.LoginDialogView"
                  xmlns="https://github.com/avaloniaui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:my="http://mynet.com/avalonia"
                  xmlns:vm="clr-namespace:MyNet.Avalonia.Showcase.ViewModels.Dialogs"
                  xmlns:samples="clr-namespace:MyNet.Avalonia.Showcase.Views.Samples"
                  d:DesignHeight="600"
                  d:DesignWidth="900"
                  x:DataType="vm:LoginDialogViewModel"
                  CanResize="{Binding CanResize}"
                  Header="User Registration"
                  mc:Ignorable="d">
    <DockPanel>
        
        <!-- ============================================ -->
        <!-- SUBMIT BUTTON SECTION -->
        <!-- ============================================ -->
        <StackPanel HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    DockPanel.Dock="Bottom"
                    Margin="{my:Thickness Md, Top}"
                    Spacing="10">
            <Button Content="{my:Loc Reset}"
                    Command="{Binding Form.ResetCommand}"
                    my:IconAssist.Icon="{my:MaterialIcon Restore}"
                    Classes="variant-outlined" />
            <Button Content="{my:Loc Validate}"
                    Command="{Binding ValidateCommand}"
                    my:IconAssist.Icon="{my:MaterialIcon Check}"
                    my:ThemeAssist.Role="Primary"
                    IsDefault="True" />
        </StackPanel>
        
        
        <ScrollViewer MaxHeight="500">
            <samples:FormContent DataContext="{Binding Form}" />
        </ScrollViewer>
    </DockPanel>
</my:ContentDialog>
