<Window
    Background="Transparent"
    CanResize="False"
    CornerRadius="10"
    ExtendClientAreaToDecorationsHint="True"
    Height="340"
    Title="My .NET Avalonia"
    Width="520"
    WindowDecorations="None"
    WindowStartupLocation="CenterScreen"
    x:Class="MyNet.Avalonia.Showcase.Views.SplashWindow"
    x:DataType="vm:SplashScreenViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:vm="using:MyNet.Avalonia.Showcase.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Card  -->
    <Border
        BoxShadow="0 12 40 0 #80000000"
        ClipToBounds="True"
        CornerRadius="10">
        <Panel>
            <Panel.Background>
                <LinearGradientBrush EndPoint="100%,100%" StartPoint="0%,0%">
                    <GradientStop Color="#1A0A2E" Offset="0" />
                    <GradientStop Color="#2D1B69" Offset="0.35" />
                    <GradientStop Color="#4A2C8A" Offset="0.65" />
                    <GradientStop Color="#1E1245" Offset="1" />
                </LinearGradientBrush>
            </Panel.Background>

            <!--  Decorative glows  -->
            <Ellipse
                Height="300"
                HorizontalAlignment="Right"
                Margin="0,-80,-60,0"
                Opacity="0.10"
                VerticalAlignment="Top"
                Width="300">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#FF6B35" Offset="0" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse
                Height="220"
                HorizontalAlignment="Left"
                Margin="-50,0,0,-40"
                Opacity="0.10"
                VerticalAlignment="Bottom"
                Width="220">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#7B4FE0" Offset="0" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!--  Content  -->
            <Grid Margin="48,40" RowDefinitions="*,Auto">

                <!--  Center  -->
                <StackPanel
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    Spacing="24"
                    VerticalAlignment="Center">

                    <!--  App icon  -->
                    <Border
                        Background="#15FFFFFF"
                        BoxShadow="0 4 16 0 #40000000"
                        ClipToBounds="True"
                        CornerRadius="18"
                        Height="76"
                        Width="76">
                        <Image
                            Height="54"
                            HorizontalAlignment="Center"
                            RenderOptions.BitmapInterpolationMode="HighQuality"
                            Source="/Assets/Demo.ico"
                            VerticalAlignment="Center"
                            Width="54" />
                    </Border>

                    <!--  Product name + version  -->
                    <StackPanel HorizontalAlignment="Center" Spacing="6">
                        <TextBlock
                            FontSize="24"
                            FontWeight="SemiBold"
                            Foreground="White"
                            HorizontalAlignment="Center"
                            LetterSpacing="0.6"
                            Text="{Binding ProductName, FallbackValue='My .NET Avalonia'}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="#80FFFFFF"
                            HorizontalAlignment="Center"
                            Text="{Binding Version, FallbackValue=''}" />
                    </StackPanel>
                </StackPanel>

                <!--  Footer  -->
                <TextBlock
                    FontSize="10"
                    Foreground="#50FFFFFF"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    Text="{Binding Copyright, FallbackValue=''}" />
            </Grid>
        </Panel>
    </Border>
</Window>