<Window x:Class="MyNet.Avalonia.Showcase.Views.MainWindow"        xmlns="https://github.com/avaloniaui"        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"        xmlns:my="http://mynet.com/avalonia"        xmlns:ext="using:MyNet.Avalonia.Extended.Controls"        xmlns:views="clr-namespace:MyNet.Avalonia.Showcase.Views"        xmlns:chrome="clr-namespace:MyNet.Avalonia.Showcase.Views.Chrome"        xmlns:vm="using:MyNet.Avalonia.Showcase.ViewModels"        Title="{Binding ProductName}"        d:DesignHeight="450"        d:DesignWidth="800"        x:DataType="vm:MainViewModel"        Icon="/Assets/Demo.ico"        my:WindowAssist.ShowFullScreenButton="{OnPlatform True, macOS=False}"        my:WindowAssist.IsTitleVisible="False"        my:WindowAssist.TitleBarBackground="Transparent"        my:WindowAssist.ExtendContentIntoTitleBar="True"        mc:Ignorable="d">    <Window.Styles>        <Style Selector="WindowDrawnDecorations">            <Setter Property="my:ThemeAssist.Context" Value="Contrast" />            <Setter Property="TextElement.Foreground" Value="{my:Theme Primary.Foreground}" />        </Style>    </Window.Styles>    <my:WindowAssist.RightTitleBarContent>        <chrome:ShellTitleBarChrome CultureManager="{Binding Culture}" ThemeManager="{Binding Theme}" />    </my:WindowAssist.RightTitleBarContent>    <Grid>        <views:MainView />        <my:OverlayDialogHost HostId="{x:Static my:OverlayDialogHostManager.MainHostId}"                              IsTopLevel="True"                              IsModalStatusReporter="True"                              HorizontalAlignment="Stretch"                              VerticalAlignment="Stretch" />        <ext:BusyServiceIndicator BusyService="{Binding ApplicationBusy}" />    </Grid></Window>