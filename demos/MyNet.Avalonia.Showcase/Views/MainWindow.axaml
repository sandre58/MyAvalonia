<Window x:Class="MyNet.Avalonia.Showcase.Views.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:my="http://mynet.com/avalonia"
        xmlns:views="clr-namespace:MyNet.Avalonia.Showcase.Views"
        xmlns:chrome="clr-namespace:MyNet.Avalonia.Showcase.Views.Chrome"
        xmlns:vm="using:MyNet.Avalonia.Showcase.ViewModels"
        xmlns:composition="clr-namespace:MyNet.Avalonia.Showcase.Composition"
        Title="{Binding ProductName}"
        d:DataContext="{x:Static composition:MainViewDesignData.MainViewModel}"
        d:DesignHeight="450"
        d:DesignWidth="800"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/Demo.ico"
        my:WindowAssist.ShowFullScreenButton="{OnPlatform True, macOS=False}"
        my:WindowAssist.TitleBarBackground="Transparent"
        my:WindowAssist.TitleBarHeight="40"
        my:WindowAssist.IsTitleVisible="False"
        my:WindowAssist.ExtendContentIntoTitleBar="True"
        my:WindowAssist.ReserveTitleBarSafeArea="True"
        mc:Ignorable="d">


    <my:WindowAssist.LeftTitleBarContent>
        <chrome:ShellPrimaryChrome GoBackCommand="{Binding GoBackCommand}"
                                   GoForwardCommand="{Binding GoForwardCommand}"
                                   ProductName="{Binding ProductName}" />
    </my:WindowAssist.LeftTitleBarContent>

    <my:WindowAssist.RightTitleBarContent>
        <chrome:ShellTitleBarChrome CultureManager="{Binding Culture}" ThemeManager="{Binding Theme}" />
    </my:WindowAssist.RightTitleBarContent>

    <views:MainView />
</Window>
