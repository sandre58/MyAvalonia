<UserControl x:Class="MyNet.Avalonia.Showcase.Views.Samples.NavigationContent"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:my="http://mynet.com/avalonia"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Name="Root"
             mc:Ignorable="d">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{my:Spacing Lg}">
        <TextBlock Text="{Binding #Root.Header}" Classes="text-h4" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding #Root.Body}" Classes="opacity-high" HorizontalAlignment="Center" TextAlignment="Center" />
    </StackPanel>
</UserControl>