<ContentPage x:Class="MyNet.Avalonia.Showcase.Pages.HomePage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:my="http://mynet.com/avalonia"
             xmlns:vm="clr-namespace:MyNet.Avalonia.Showcase.ViewModels.Pages"
             xmlns:common="clr-namespace:MyNet.Avalonia.Showcase.Views.Common"
             x:DataType="vm:HomePageViewModel"
             ClipToBounds="False"
             x:Name="Root"
             Theme="{StaticResource {x:Type ContentPage}}"
             Header="{my:Loc Home}"
             my:IconAssist.Icon="{Binding Icon}"
             mc:Ignorable="d">
    <ContentPage.Resources>
        <my:BindingProxy x:Key="PageProxy" Data="{Binding}" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *" RowSpacing="{my:Spacing Xl}">

        <!-- Header -->
        <common:PageHeader Grid.Row="0"
                           Header="{my:Loc WelcomeTitle}"
                           Icon="{Binding Icon}">
            <StackPanel Margin="{my:Thickness Md, Bottom}" Spacing="{my:Spacing Md}">
                <TextBlock Text="{my:Loc WelcomeSubtitle}" TextWrapping="Wrap" />
                <WrapPanel Orientation="Horizontal"
                           ItemSpacing="{my:Spacing Lg}"
                           LineSpacing="{my:Spacing Md}">
                    <HyperlinkButton NavigateUri="https://github.com/sandre58/MyAvalonia"
                                     Content="{my:Loc ResourceRepository}"
                                     my:IconAssist.Icon="{my:MaterialIcon Kind=Github}" />
                    <HyperlinkButton
                        NavigateUri="https://github.com/sandre58/MyAvalonia/tree/main/demos/MyNet.Avalonia.Showcase"
                        Content="{my:Loc ResourceReadme}"
                        my:IconAssist.Icon="{my:MaterialIcon Kind=BookOpen}" />
                </WrapPanel>
            </StackPanel>
        </common:PageHeader>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="{my:Spacing Xxl}" Margin="{my:Thickness Sm, Bottom}">

                <!-- Stats -->
                <ItemsControl ItemsSource="{Binding Stats}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" RowSpacing="{my:Spacing Md}" ColumnSpacing="{my:Spacing Md}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HomeStatViewModel">
                            <my:Card Padding="{my:Thickness Lg}"
                                     Classes="size-lg"
                                     Layout="Stat"
                                     Title="{Binding Value}"
                                     Subtitle="{my:Display Label}"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch">
                                <my:Card.Leading>
                                    <my:MaterialIcon Kind="{Binding Icon}" />
                                </my:Card.Leading>
                            </my:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Quick start -->
                <HeaderedContentControl Header="{my:Loc FeaturedSection}"
                                        HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="{my:Spacing Md}">
                        <TextBlock Classes="font-sm opacity-high" Text="{my:Loc FeaturedSectionDescription}"
                                   TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding FeaturedLinks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HomeLinkViewModel">
                                    <my:Card Margin="{my:Thickness Sm}"
                                             Padding="{my:Thickness Lg}"
                                             Classes="header-h6"
                                             Layout="Horizontal"
                                             Theme="{StaticResource MyNet.Theme.Card.Interactive}"
                                             Title="{my:Display Title}"
                                             Subtitle="{my:Display Description}"
                                             Command="{Binding ((vm:HomePageViewModel)Data).OpenLinkCommand, Source={StaticResource PageProxy}, FallbackValue={x:Null}}"
                                             CommandParameter="{Binding}"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch">
                                        <my:Card.Leading>
                                            <my:MaterialIcon Kind="{Binding Icon}" Classes="size-md" />
                                        </my:Card.Leading>
                                    </my:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </HeaderedContentControl>

                <!-- Capabilities -->
                <HeaderedContentControl Header="{my:Loc CapabilitiesSection}" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="{my:Spacing Md}">
                        <TextBlock Classes="font-sm opacity-high"
                                   Text="{my:Loc CapabilitiesSectionDescription}"
                                   TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Capabilities}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HomeCapabilityViewModel">
                                    <my:Card Margin="{my:Thickness Sm}"
                                             Padding="{my:Thickness Lg}"
                                             Classes="header-h6"
                                             Layout="Horizontal"
                                             Title="{my:Display Title}"
                                             Subtitle="{my:Display Description}"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch">
                                        <my:Card.Leading>
                                            <my:MaterialIcon Kind="{Binding Icon}" Classes="size-md" />
                                        </my:Card.Leading>
                                    </my:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </HeaderedContentControl>

                <!-- Categories -->
                <HeaderedContentControl Header="{my:Loc CategoriesSection}" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="{my:Spacing Md}">
                        <TextBlock Classes="font-sm opacity-high"
                                   Text="{my:Loc CategoriesSectionDescription}"
                                   TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding CategoryLinks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HomeLinkViewModel">
                                    <my:Card Margin="{my:Thickness Sm}"
                                             Classes="size-sm"
                                             Layout="Horizontal"
                                             LeadingPresentation="Plain"
                                             Theme="{StaticResource MyNet.Theme.Card.Interactive}"
                                             Title="{my:Display Title}"
                                             Subtitle="{my:Display Description}"
                                             Command="{Binding ((vm:HomePageViewModel)Data).OpenLinkCommand, Source={StaticResource PageProxy}, FallbackValue={x:Null}}"
                                             CommandParameter="{Binding}"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch">
                                        <my:Card.Leading>
                                            <my:MaterialIcon Kind="{Binding Icon}" />
                                        </my:Card.Leading>
                                        <my:Card.Trailing>
                                            <Label Grid.Column="2" VerticalAlignment="Center"
                                                   my:ThemeAssist.Role="Inverse"
                                                   Content="{Binding DemoPageCount}"
                                                   my:VariantAssist.Background="{my:Theme Surface.Level2}"
                                                   Classes="shadow-control variant-solid font-sm size-sm kind-badge shape-circle" />
                                        </my:Card.Trailing>
                                    </my:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </HeaderedContentControl>

                <!-- Getting started + Explore -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="{my:Spacing Xl}">
                    <HeaderedContentControl Header="{my:Loc GettingStartedSection}" Classes="kind-card">
                        <StackPanel Spacing="{my:Spacing Md}">
                            <TextBlock Classes="font-sm opacity-high"
                                       Text="{my:Loc GettingStartedSectionDescription}"
                                       TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding GettingStartedSteps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:HomeStepViewModel">
                                        <Grid Margin="{my:Thickness Sm, Vertical}"
                                              ColumnDefinitions="Auto, *"
                                              ColumnSpacing="{my:Spacing Md}">
                                            <Border Grid.Column="0"
                                                    Width="28"
                                                    Height="28"
                                                    CornerRadius="{StaticResource MyNet.Corners.Full}"
                                                    Background="{my:Theme Primary}">
                                                <TextBlock Classes="font-sm"
                                                           Foreground="{my:Theme Primary.Foreground}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding Step}" />
                                            </Border>
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Spacing="{my:Spacing Xs}">
                                                <StackPanel Orientation="Horizontal" Spacing="{my:Spacing Xs}">
                                                    <my:MaterialIcon Kind="{Binding Icon}"
                                                                     Classes="size-sm opacity-high" />
                                                    <TextBlock Classes="font-sm"
                                                               Text="{my:Display Text}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Grid.Column="1" Header="{my:Loc ExploreSection}" Classes="kind-card">
                        <StackPanel Spacing="{my:Spacing Md}">
                            <TextBlock Classes="font-sm opacity-high"
                                       Text="{my:Loc ExploreSectionDescription}"
                                       TextWrapping="Wrap" />
                            <StackPanel Spacing="{my:Spacing Sm}">
                                <StackPanel Orientation="Horizontal" Spacing="{my:Spacing Sm}">
                                    <my:MaterialIcon Kind="Magnify" Classes="size-sm" />
                                    <TextBlock Classes="font-sm" Text="{my:Loc ExploreTipSearch}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="{my:Spacing Sm}">
                                    <my:MaterialIcon Kind="PaletteSwatchVariant" Classes="size-sm" />
                                    <TextBlock Classes="font-sm" Text="{my:Loc ExploreTipTheme}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="{my:Spacing Sm}">
                                    <my:MaterialIcon Kind="TuneVariant" Classes="size-sm" />
                                    <TextBlock Classes="font-sm" Text="{my:Loc ExploreTipPlayground}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="{my:Spacing Sm}">
                                    <my:MaterialIcon Kind="Menu" Classes="size-sm" />
                                    <TextBlock Classes="font-sm" Text="{my:Loc ExploreTipMenu}" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </HeaderedContentControl>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentPage>