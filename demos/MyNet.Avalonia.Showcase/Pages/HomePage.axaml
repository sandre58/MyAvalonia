<ContentPage x:Class="MyNet.Avalonia.Showcase.Pages.HomePage"
            xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:my="http://mynet.com/avalonia"
            xmlns:vm="clr-namespace:MyNet.Avalonia.Showcase.ViewModels.Pages"
            xmlns:common="clr-namespace:MyNet.Avalonia.Showcase.Views.Common"
            x:DataType="vm:HomePageViewModel"
            ClipToBounds="False"
            x:Name="Root" Theme="{StaticResource {x:Type ContentPage}}" Header="{my:Translate Title}" my:IconAssist.Icon="{Binding Icon}"
            mc:Ignorable="d">
    <common:PageHeader Header="{my:Loc Home}"
                       Icon="{Binding Icon}">
    </common:PageHeader>
</ContentPage>