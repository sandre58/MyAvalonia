<ContentPage x:Class="MyNet.Avalonia.Showcase.Pages.HeaderedContentControlPage"
            xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            mc:Ignorable="d"             xmlns:behavior="clr-namespace:MyNet.Avalonia.Showcase.Behaviors"
            xmlns:my="http://mynet.com/avalonia"
            xmlns:v="clr-namespace:MyNet.Avalonia.Showcase.Views.Playground"
            xmlns:vm="clr-namespace:MyNet.Avalonia.Showcase.ViewModels.Pages"
            xmlns:vmBase="clr-namespace:MyNet.Avalonia.Showcase.ViewModels.Playground"
            xmlns:rendering="clr-namespace:MyNet.Avalonia.Showcase.ThemeBuilder.Rendering"
            xmlns:m="clr-namespace:MyNet.Avalonia.Showcase.MarkupExtensions"
            x:DataType="vm:HeaderedContentControlPageViewModel"
            x:Name="Root" 
            Theme="{StaticResource {x:Type ContentPage}}" 
            Header="{my:Display Title}" 
            my:IconAssist.Icon="{Binding Icon}"
            ClipToBounds="False">

    <v:ShowcaseView>

        <v:ShowcaseView.PlaygroundControlTemplate>
            <DataTemplate x:DataType="vmBase:PlaygroundViewModel">
                <HeaderedContentControl behavior:PlaygroundBehavior.AttachStyleProvider="{Binding}"
                                        MaxWidth="300"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                    <TextBlock Text="{m:RandomText}" TextWrapping="Wrap" TextAlignment="Justify" />
                </HeaderedContentControl>
            </DataTemplate>
        </v:ShowcaseView.PlaygroundControlTemplate>

        <v:ShowcaseView.ThemeControlTemplate>
            <DataTemplate x:DataType="rendering:ControlStyle">
                <HeaderedContentControl behavior:PlaygroundBehavior.AttachStyle="{Binding}" MaxWidth="300">
                    <TextBlock Text="{m:RandomText}" TextWrapping="Wrap" TextAlignment="Justify" />
                </HeaderedContentControl>
            </DataTemplate>
        </v:ShowcaseView.ThemeControlTemplate>

    </v:ShowcaseView>
</ContentPage>