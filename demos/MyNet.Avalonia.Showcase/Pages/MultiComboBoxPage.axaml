<ContentPage x:Class="MyNet.Avalonia.Showcase.Pages.MultiComboBoxPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:my="http://mynet.com/avalonia"
             xmlns:v="clr-namespace:MyNet.Avalonia.Showcase.Views.Playground"
             xmlns:vm="clr-namespace:MyNet.Avalonia.Showcase.ViewModels.Pages"
             xmlns:vmBase="clr-namespace:MyNet.Avalonia.Showcase.ViewModels.Playground"
             xmlns:m="clr-namespace:MyNet.Avalonia.Showcase.MarkupExtensions"
             xmlns:rendering="clr-namespace:MyNet.Avalonia.Showcase.ThemeBuilder.Rendering"
             xmlns:behavior="clr-namespace:MyNet.Avalonia.Showcase.Behaviors"
             x:DataType="vm:MultiComboBoxPageViewModel"
             x:Name="Root"
             Theme="{StaticResource {x:Type ContentPage}}"
             Header="{my:Display Title}"
             my:IconAssist.Icon="{Binding Icon}"
             ClipToBounds="False"
             mc:Ignorable="d">

    <ContentPage.Resources>
        <my:BindingProxy x:Key="PageProxy" Data="{Binding}" />
    </ContentPage.Resources>

    <v:ShowcaseView ShowContent="False" ShowIcon="False">

        <v:ShowcaseView.PlaygroundControlTemplate>
            <DataTemplate x:DataType="vmBase:PlaygroundViewModel">
                <Panel>
                    <Panel.Styles>
                        <Style Selector="my|MultiComboBox.kind-underline">
                            <Setter Property="Theme" Value="{StaticResource MyNet.Theme.MultiComboBox.Underline}" />
                        </Style>
                    </Panel.Styles>
                    <my:MultiComboBox behavior:PlaygroundBehavior.AttachStyleProvider="{Binding}"
                                      MaxWidth="360"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      ItemsSource="{m:RandomCountries All=True}"
                                      ItemTemplate="{StaticResource MyNet.DataTemplate.Country.Xs}"
                                      SelectedItemTemplate="{StaticResource MyNet.DataTemplate.Country.Xs}"
                                      PlaceholderText="{my:Loc ChooseCountry}" />
                </Panel>
            </DataTemplate>
        </v:ShowcaseView.PlaygroundControlTemplate>

        <v:ShowcaseView.ThemeControlTemplate>
            <DataTemplate x:DataType="rendering:ControlStyle">
                <Panel>
                    <Panel.Styles>
                        <Style Selector="my|MultiComboBox.kind-underline">
                            <Setter Property="Theme" Value="{StaticResource MyNet.Theme.MultiComboBox.Underline}" />
                        </Style>
                    </Panel.Styles>
                    <my:MultiComboBox behavior:PlaygroundBehavior.AttachStyle="{Binding}"
                                      MaxWidth="360"
                                      ItemsSource="{m:RandomCountries Min=10, Max=20}"
                                      ItemTemplate="{StaticResource MyNet.DataTemplate.Country.Xs}"
                                      SelectedItemTemplate="{StaticResource MyNet.DataTemplate.Country.Xs}" />
                </Panel>
            </DataTemplate>
        </v:ShowcaseView.ThemeControlTemplate>

    </v:ShowcaseView>
</ContentPage>
