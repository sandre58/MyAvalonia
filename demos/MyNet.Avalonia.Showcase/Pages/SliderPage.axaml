<ContentPage x:Class="MyNet.Avalonia.Showcase.Pages.SliderPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:behavior="clr-namespace:MyNet.Avalonia.Showcase.Behaviors"
             xmlns:my="http://mynet.com/avalonia"
             xmlns:v="clr-namespace:MyNet.Avalonia.Showcase.Views.Playground"
             xmlns:vm="clr-namespace:MyNet.Avalonia.Showcase.ViewModels.Pages"
             xmlns:vmBase="clr-namespace:MyNet.Avalonia.Showcase.ViewModels.Playground"
             xmlns:rendering="clr-namespace:MyNet.Avalonia.Showcase.ThemeBuilder.Rendering"
             x:DataType="vm:SliderPageViewModel"
             x:Name="Root"
             Theme="{StaticResource {x:Type ContentPage}}"
             Header="{my:Display Title}"
             my:IconAssist.Icon="{Binding Icon}"
             ClipToBounds="False">

    <v:ShowcaseView ShowContent="False" ShowIcon="False">

        <v:ShowcaseView.PlaygroundControlTemplate>
            <DataTemplate x:DataType="vmBase:PlaygroundViewModel">
                <Slider behavior:PlaygroundBehavior.AttachStyleProvider="{Binding}"
                        Value="30"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Slider.Styles>
                        <Style Selector="Slider:horizontal">
                            <Setter Property="Width" Value="250" />
                            <Setter Property="Height" Value="80" />
                        </Style>
                        <Style Selector="Slider:vertical">
                            <Setter Property="Width" Value="80" />
                            <Setter Property="Height" Value="250" />
                        </Style>
                    </Slider.Styles>
                    </Slider>
            </DataTemplate>
        </v:ShowcaseView.PlaygroundControlTemplate>

        <v:ShowcaseView.ThemeControlTemplate>
            <DataTemplate x:DataType="rendering:ControlStyle">
                <Slider behavior:PlaygroundBehavior.AttachStyle="{Binding}"
                        Orientation="Horizontal"
                        Minimum="0"
                        Maximum="100"
                        Value="50"
                        Width="250" />
            </DataTemplate>
        </v:ShowcaseView.ThemeControlTemplate>

        <v:ShowcaseView.CustomContent>
            <StackPanel>
                <ColorSlider Width="300"
                             Orientation="Horizontal"
                             ColorModel="Hsva"
                             ColorComponent="Component1" />
                <ColorSlider Width="300"
                             Orientation="Horizontal"
                             ColorModel="Hsva"
                             ColorComponent="Component2" />
                <ColorSlider Width="300"
                             Orientation="Horizontal"
                             ColorModel="Hsva"
                             ColorComponent="Component3" />
                <ColorSlider Width="300"
                             Orientation="Horizontal"
                             ColorModel="Rgba"
                             ColorComponent="Component1" />
                <ColorSlider Width="300"
                             Orientation="Horizontal"
                             ColorModel="Rgba"
                             ColorComponent="Component2" />
                <ColorSlider Width="300"
                             Orientation="Horizontal"
                             ColorModel="Rgba"
                             ColorComponent="Component3" />
                <ColorSlider Width="300"
                             Orientation="Horizontal"
                             ColorModel="Rgba"
                             ColorComponent="Alpha" />
            </StackPanel>
        </v:ShowcaseView.CustomContent>

    </v:ShowcaseView>
</ContentPage>