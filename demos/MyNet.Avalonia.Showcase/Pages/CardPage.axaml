<?xml version="1.0" encoding="utf-8"?>

<ContentPage x:Class="MyNet.Avalonia.Showcase.Pages.CardPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:my="http://mynet.com/avalonia"
             xmlns:v="clr-namespace:MyNet.Avalonia.Showcase.Views.Playground"
             xmlns:vm="clr-namespace:MyNet.Avalonia.Showcase.ViewModels.Pages"
             xmlns:vmBase="clr-namespace:MyNet.Avalonia.Showcase.ViewModels.Playground"
             xmlns:m="clr-namespace:MyNet.Avalonia.Showcase.MarkupExtensions"
             xmlns:rendering="clr-namespace:MyNet.Avalonia.Showcase.ThemeBuilder.Rendering"
             xmlns:behavior="clr-namespace:MyNet.Avalonia.Showcase.Behaviors"
             x:DataType="vm:CardPageViewModel"
             x:Name="Root"
             Theme="{StaticResource {x:Type ContentPage}}"
             Header="{my:Display Title}"
             my:IconAssist.Icon="{Binding Icon}"
             ClipToBounds="False"
             mc:Ignorable="d">

    <v:ShowcaseView>

        <v:ShowcaseView.PlaygroundControlTemplate>
            <DataTemplate x:DataType="vmBase:PlaygroundViewModel">
                <my:Card behavior:PlaygroundBehavior.AttachStyleProvider="{Binding}"
                         MaxWidth="420"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </DataTemplate>
        </v:ShowcaseView.PlaygroundControlTemplate>

        <v:ShowcaseView.ThemeControlTemplate>
            <DataTemplate x:DataType="rendering:ControlStyle">
                <my:Card behavior:PlaygroundBehavior.AttachStyle="{Binding}"
                         MaxWidth="360"
                         Padding="{my:Thickness Lg}"
                         Title="{m:RandomText}"
                         Subtitle="{m:RandomText}"
                         Leading="{m:RandomIcon}" />
            </DataTemplate>
        </v:ShowcaseView.ThemeControlTemplate>

        <v:ShowcaseView.CustomContent>
            <StackPanel Spacing="{my:Spacing Xl}">

                <!-- Layout gallery -->
                <HeaderedContentControl Header="{my:Loc LayoutGallerySection}"
                                        HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="{my:Spacing Md}">
                        <TextBlock Classes="font-sm opacity-high"
                                   Text="{my:Loc LayoutGalleryDescription}"
                                   TextWrapping="Wrap" />

                        <UniformGrid Columns="2" ColumnSpacing="{my:Spacing Md}" RowSpacing="{my:Spacing Md}">
                            <my:Card Padding="{my:Thickness Lg}"
                                     Layout="Horizontal"
                                     LeadingPresentation="Badge"
                                     Title="Settings row"
                                     Subtitle="Icon on the left with a tonal badge — navigation and settings."
                                     Leading="{my:MaterialIcon Kind=CogOutline}" />
                            <my:Card Padding="{my:Thickness Lg}"
                                     Layout="Vertical"
                                     LeadingPresentation="Plain"
                                     Title="Shortcut tile"
                                     Subtitle="Centered icon above the title — dashboard shortcuts."
                                     Leading="{my:MaterialIcon Kind=ViewDashboardOutline}" />
                        </UniformGrid>

                        <UniformGrid Columns="3" ColumnSpacing="{my:Spacing Md}" RowSpacing="{my:Spacing Md}">
                            <my:Card Padding="{my:Thickness Lg}"
                                     Layout="Stat"
                                     LeadingPresentation="Plain"
                                     Title="128"
                                     Subtitle="Active users"
                                     Leading="{my:MaterialIcon Kind=AccountGroupOutline}" />
                            <my:Card MaxWidth="280"
                                     Layout="MediaTop"
                                     LeadingPresentation="Hero"
                                     Title="Mountain trail"
                                     Subtitle="A weekend hike in the Alps."
                                     HorizontalAlignment="Stretch">
                                <my:Card.Leading>
                                    <Image Source="avares://MyNet.Avalonia.Showcase/Assets/Images/avatar_1.png"
                                           Height="160" />
                                </my:Card.Leading>
                            </my:Card>
                            <my:Card MaxWidth="360"
                                     Layout="MediaLeft"
                                     LeadingPresentation="Hero"
                                     Title="Alex Martin"
                                     Subtitle="Product designer · Paris"
                                     Content="Available for freelance projects this quarter."
                                     HorizontalAlignment="Stretch">
                                <my:Card.Leading>
                                    <Image Source="avares://MyNet.Avalonia.Showcase/Assets/Images/avatar_2.png" />
                                </my:Card.Leading>
                            </my:Card>
                        </UniformGrid>
                    </StackPanel>
                </HeaderedContentControl>

                <!-- Leading presentation -->
                <HeaderedContentControl Header="{my:Loc LeadingPresentationSection}"
                                        HorizontalContentAlignment="Stretch">
                    <UniformGrid Columns="4" ColumnSpacing="{my:Spacing Md}" RowSpacing="{my:Spacing Md}">
                        <my:Card Padding="{my:Thickness Md}"
                                 Layout="Horizontal"
                                 LeadingPresentation="Badge"
                                 Title="Badge"
                                 Subtitle="Tonal rounded background."
                                 Leading="{my:MaterialIcon Kind=ShieldCheckOutline}" />
                        <my:Card Padding="{my:Thickness Md}"
                                 Layout="Horizontal"
                                 LeadingPresentation="Plain"
                                 Title="Plain"
                                 Subtitle="Icon without badge."
                                 Leading="{my:MaterialIcon Kind=PaletteOutline}" />
                        <my:Card Padding="{my:Thickness Md}"
                                 Layout="Horizontal"
                                 LeadingPresentation="None"
                                 Title="None"
                                 Subtitle="Leading slot hidden."
                                 Leading="{my:MaterialIcon Kind=EyeOffOutline}" />
                        <my:Card Padding="{my:Thickness Md}"
                                 Layout="Horizontal"
                                 LeadingPresentation="Hero"
                                 Title="Hero"
                                 Subtitle="Media fills the slot."
                                 Leading="{my:MaterialIcon Kind=ImageOutline}"
                                 Classes="size-sm" />
                    </UniformGrid>
                </HeaderedContentControl>

                <!-- Use cases -->
                <HeaderedContentControl Header="{my:Loc UseCasesSection}"
                                        HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="{my:Spacing Md}">

                        <my:Card Padding="{my:Thickness Lg}"
                                 Layout="Horizontal"
                                 Theme="{StaticResource MyNet.Theme.Card.Interactive}"
                                 Title="Theme playground"
                                 Subtitle="Open the theme page and tweak control classes live."
                                 Command="{Binding SampleCommand}"
                                 Leading="{my:MaterialIcon Kind=Palette}" />

                        <my:Card Padding="{my:Thickness Lg}"
                                 Layout="Horizontal"
                                 Header="Status"
                                 Title="Deployment"
                                 Subtitle="Production environment is healthy."
                                 Leading="{my:MaterialIcon Kind=CheckCircleOutline}" />

                        <my:Card Padding="{my:Thickness Lg}"
                                 Layout="Horizontal"
                                 Title="Confirm changes"
                                 Subtitle="Review the summary before saving.">
                            <my:Card.Actions>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            Spacing="{my:Spacing Sm}" Margin="{my:Thickness Sm}">
                                    <Button Content="Cancel" Classes="kind-flat" />
                                    <Button Content="Confirm" Classes="variant-solid" />
                                </StackPanel>
                            </my:Card.Actions>
                        </my:Card>

                        <my:Card Layout="Horizontal"
                                 LeadingPresentation="None"
                                 Padding="{my:Thickness Md}">
                            <Border Height="120"
                                    CornerRadius="{StaticResource MyNet.Corners.Md}"
                                    Background="{my:ThemeContext Surface.Level3}">
                                <TextBlock Text="{my:Loc ContentOnlyExample}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Classes="opacity-high" />
                            </Border>
                        </my:Card>
                    </StackPanel>
                </HeaderedContentControl>

            </StackPanel>
        </v:ShowcaseView.CustomContent>
    </v:ShowcaseView>
</ContentPage>
