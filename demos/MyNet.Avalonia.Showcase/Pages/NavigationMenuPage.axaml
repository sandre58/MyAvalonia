<ContentPage x:Class="MyNet.Avalonia.Showcase.Pages.NavigationMenuPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:my="http://mynet.com/avalonia"
             xmlns:v="clr-namespace:MyNet.Avalonia.Showcase.Views.Playground"
             xmlns:vm="clr-namespace:MyNet.Avalonia.Showcase.ViewModels.Pages"
             xmlns:vmBase="clr-namespace:MyNet.Avalonia.Showcase.ViewModels.Playground"
             xmlns:rendering="clr-namespace:MyNet.Avalonia.Showcase.ThemeBuilder.Rendering"
             x:DataType="vm:NavigationMenuPageViewModel"
             x:Name="Root"
             Theme="{StaticResource {x:Type ContentPage}}"
             Header="{my:Display Title}"
             my:IconAssist.Icon="{Binding Icon}"
             mc:Ignorable="d"
             xmlns:behavior="clr-namespace:MyNet.Avalonia.Showcase.Behaviors">

    <v:ShowcaseView ShowContent="False" ShowIcon="False">

        <v:ShowcaseView.PlaygroundControlTemplate>
            <DataTemplate x:DataType="vmBase:PlaygroundViewModel">
                <my:NavigationMenu x:Name="menu" behavior:PlaygroundBehavior.AttachStyleProvider="{Binding}" HorizontalAlignment="Left">
                    <my:NavigationMenu.Header>
                        <ToggleButton Margin="0 0 0 10" IsChecked="{Binding #menu.IsHorizontalCollapsed}" Content="{my:MaterialIcon Menu}" />
                    </my:NavigationMenu.Header>
                    <my:NavigationMenuItem Header="{my:Loc Home}" Icon="{my:MaterialIcon Home}" />
                    <my:NavigationMenuItem Header="{my:Loc Dashboard}" Icon="{my:MaterialIcon ViewDashboard}">
                        <my:NavigationMenuItem Header="{my:Loc Statistics}" Icon="{my:MaterialIcon ChartLine}" />
                        <my:NavigationMenuItem Header="{my:Loc Reports}" Icon="{my:MaterialIcon FileDocument}" />
                    </my:NavigationMenuItem>
                    <my:NavigationMenuItem Header="{my:Loc Settings}" Icon="{my:MaterialIcon Cog}">
                        <my:NavigationMenuItem Header="{my:Loc General}" Icon="{my:MaterialIcon Tune}" />
                        <my:NavigationMenuItem Header="{my:Loc Advanced}" Icon="{my:MaterialIcon TuneVariant}" />
                    </my:NavigationMenuItem>
                    <my:NavigationMenuItem Header="{my:Loc Help}" Icon="{my:MaterialIcon Help}" />
                </my:NavigationMenu>
            </DataTemplate>
        </v:ShowcaseView.PlaygroundControlTemplate>

        <v:ShowcaseView.ThemeControlTemplate>
            <DataTemplate x:DataType="rendering:ControlStyle">
                <my:NavigationMenu x:Name="menu" behavior:PlaygroundBehavior.AttachStyle="{Binding}">
                    <my:NavigationMenu.Header>
                        <ToggleButton Margin="0 0 0 10" Content="{my:MaterialIcon Menu}" />
                    </my:NavigationMenu.Header>
                    <my:NavigationMenuItem Header="{my:Loc Home}"
                                           Icon="{my:MaterialIcon Home}" />
                    <my:NavigationMenuItem Header="{my:Loc Dashboard}" Icon="{my:MaterialIcon ViewDashboard}">
                        <my:NavigationMenuItem Header="{my:Loc Statistics}" Icon="{my:MaterialIcon ChartLine}" />
                        <my:NavigationMenuItem Header="{my:Loc Reports}" Icon="{my:MaterialIcon FileDocument}" />
                    </my:NavigationMenuItem>
                    <my:NavigationMenuItem Header="{my:Loc Settings}" Icon="{my:MaterialIcon Cog}">
                        <my:NavigationMenuItem Header="{my:Loc General}" Icon="{my:MaterialIcon Tune}" />
                        <my:NavigationMenuItem Header="{my:Loc Advanced}" Icon="{my:MaterialIcon TuneVariant}" />
                    </my:NavigationMenuItem>
                    <my:NavigationMenuItem Header="{my:Loc Help}" Icon="{my:MaterialIcon Help}" />
                </my:NavigationMenu>
            </DataTemplate>
        </v:ShowcaseView.ThemeControlTemplate>

    </v:ShowcaseView>

</ContentPage>