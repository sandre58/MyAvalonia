<ContentPage x:Class="MyNet.Avalonia.Showcase.Pages.ExpanderPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:my="http://mynet.com/avalonia"
             xmlns:v="clr-namespace:MyNet.Avalonia.Showcase.Views.Playground"
             xmlns:vm="clr-namespace:MyNet.Avalonia.Showcase.ViewModels.Pages"
             xmlns:vmBase="clr-namespace:MyNet.Avalonia.Showcase.ViewModels.Playground"
             xmlns:rendering="clr-namespace:MyNet.Avalonia.Showcase.ThemeBuilder.Rendering"
             xmlns:m="clr-namespace:MyNet.Avalonia.Showcase.MarkupExtensions"
             x:DataType="vm:ExpanderPageViewModel"
             x:Name="Root"
             Theme="{StaticResource {x:Type ContentPage}}"
             Header="{my:Display Title}"
             my:IconAssist.Icon="{Binding Icon}"
             mc:Ignorable="d"
             xmlns:behavior="clr-namespace:MyNet.Avalonia.Showcase.Behaviors">

    <v:ShowcaseView>

        <v:ShowcaseView.PlaygroundControlTemplate>
            <DataTemplate x:DataType="vmBase:PlaygroundViewModel">
                <Expander behavior:PlaygroundBehavior.AttachStyleProvider="{Binding}"
                          MaxWidth="300"
                          IsExpanded="True">
                    <TextBlock Text="{m:RandomText MinWords=10, MaxWords=30, MinSentences=3, MaxSentences=4}" TextWrapping="Wrap" TextAlignment="Justify" />
                </Expander>
            </DataTemplate>
        </v:ShowcaseView.PlaygroundControlTemplate>

        <v:ShowcaseView.ThemeControlTemplate>
            <DataTemplate x:DataType="rendering:ControlStyle">
                <Expander behavior:PlaygroundBehavior.AttachStyle="{Binding}"
                          Width="300"
                          MaxWidth="300"
                          IsExpanded="True">
                    <TextBlock Text="{m:RandomText MinWords=10, MaxWords=30, MinSentences=3, MaxSentences=4}" TextWrapping="Wrap" TextAlignment="Justify" />
                </Expander>
            </DataTemplate>
        </v:ShowcaseView.ThemeControlTemplate>

    </v:ShowcaseView>
</ContentPage>