<ContentPage x:Class="MyNet.Avalonia.Showcase.Pages.TabbedPagePage"
            xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:behavior="clr-namespace:MyNet.Avalonia.Showcase.Behaviors"
            xmlns:my="http://mynet.com/avalonia"
            xmlns:vm="clr-namespace:MyNet.Avalonia.Showcase.ViewModels.Pages"
            xmlns:vmBase="clr-namespace:MyNet.Avalonia.Showcase.ViewModels.Playground"
            xmlns:v="clr-namespace:MyNet.Avalonia.Showcase.Views.Playground"
            xmlns:m="clr-namespace:MyNet.Avalonia.Showcase.MarkupExtensions"
            xmlns:samples="clr-namespace:MyNet.Avalonia.Showcase.Views.Samples"
            x:DataType="vm:TabbedPagePageViewModel"
            ClipToBounds="False"
            x:Name="Root"
            Theme="{StaticResource {x:Type ContentPage}}"
            Header="{my:Display Title}"
            my:IconAssist.Icon="{Binding Icon}"
            mc:Ignorable="d">

    <ContentPage.Resources>
        <DataTemplate x:Key="LargeTabContentTemplate" x:DataType="IBrush">
            <ScrollViewer HorizontalScrollBarVisibility="Auto">
                <samples:LargeContent1 BorderBrush="{Binding}" />
            </ScrollViewer>
        </DataTemplate>
    </ContentPage.Resources>

    <v:ShowcaseView ShowContent="False" ShowIcon="False" ShowAppearance="False" ShowPreviewCode="False" ShowThemes="False">

        <v:ShowcaseView.PlaygroundControlTemplate>
            <DataTemplate x:DataType="vmBase:PlaygroundViewModel">
                <TabbedPage behavior:PlaygroundBehavior.AttachStyleProvider="{Binding}"
                            MaxWidth="600"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <ContentPage Header="Tab 1" Content="{m:RandomBrush}" ContentTemplate="{StaticResource LargeTabContentTemplate}" />
                    <ContentPage Header="Tab 2" Content="{m:RandomBrush}" ContentTemplate="{StaticResource LargeTabContentTemplate}" />
                    <ContentPage Header="Tab 3" Content="{m:RandomBrush}" ContentTemplate="{StaticResource LargeTabContentTemplate}" />
                    <ContentPage Header="Tab 4" Content="{m:RandomBrush}" ContentTemplate="{StaticResource LargeTabContentTemplate}" />
                </TabbedPage>
            </DataTemplate>
        </v:ShowcaseView.PlaygroundControlTemplate>


    </v:ShowcaseView>

</ContentPage>

