<ContentPage x:Class="MyNet.Avalonia.Showcase.Pages.ListBoxPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:geo="using:MyNet.Utilities.Geography"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:my="http://mynet.com/avalonia"
             xmlns:vm="clr-namespace:MyNet.Avalonia.Showcase.ViewModels.Pages"
             xmlns:vmBase="clr-namespace:MyNet.Avalonia.Showcase.ViewModels.Playground"
             xmlns:v="clr-namespace:MyNet.Avalonia.Showcase.Views.Playground"
             xmlns:m="clr-namespace:MyNet.Avalonia.Showcase.MarkupExtensions"
             xmlns:rendering="clr-namespace:MyNet.Avalonia.Showcase.ThemeBuilder.Rendering"
             x:DataType="vm:ListBoxPageViewModel"
             x:Name="Root"
             Theme="{StaticResource {x:Type ContentPage}}"
             Header="{my:Display Title}"
             my:IconAssist.Icon="{Binding Icon}"
             ClipToBounds="False"
             mc:Ignorable="d"
             xmlns:behavior="clr-namespace:MyNet.Avalonia.Showcase.Behaviors">
    <ContentPage.Resources>
        <DataTemplate x:Key="MyNet.DataTemplate.Icon" DataType="{x:Type geo:Country}">
            <ContentControl Content="{m:RandomIcon}" />
        </DataTemplate>
    </ContentPage.Resources>

    <v:ShowcaseView ShowContent="False">

        <v:ShowcaseView.PlaygroundControlTemplate>
            <DataTemplate x:DataType="vmBase:PlaygroundViewModel">
                <Panel>
                    <Panel.Styles>
                        <Style Selector="ListBox">
                            <Style Selector="^.icon-left ListBoxItem, ^.icon-right ListBoxItem, ^.icon-top ListBoxItem, ^.icon-bottom ListBoxItem">
                                <Setter Property="my:IconAssist.Icon">
                                    <Template>
                                        <ContentControl Content="{m:RandomIcon}" />
                                    </Template>
                                </Setter>
                            </Style>

                            <Style Selector="^.theme-default">
                                <Setter Property="Width" Value="300" />
                                <Setter Property="ItemsSource" Value="{m:RandomCountries Min=10, Max=200}" />
                                <Setter Property="ItemTemplate" Value="{StaticResource MyNet.DataTemplate.Country.Xs}" />

                                <Style Selector="^.flex-horizontal, ^.flex-uniform:not(.flex-vertical)">
                                    <Setter Property="Width" Value="NaN" />
                                    <Setter Property="ItemsSource" Value="{m:RandomCountries Min=8, Max=15}" />
                                </Style>

                                <Style Selector="^.flex-wrap">
                                    <Setter Property="Width" Value="NaN" />
                                    <Setter Property="ItemsSource" Value="{m:RandomCountries All=True}" />

                                    <Style Selector="^ ListBoxItem">
                                        <Setter Property="Width" Value="200" />
                                    </Style>
                                </Style>

                                <Style Selector="^.kind-cards">
                                    <Setter Property="Width" Value="NaN" />
                                    <Setter Property="ItemsSource" Value="{m:RandomCountries All=True}" />
                                    <Setter Property="ItemTemplate" Value="{StaticResource MyNet.DataTemplate.Country.Xl}" />
                                </Style>
                            </Style>

                            <Style Selector="^.theme-toggle, ^.theme-tabs, ^.theme-icon, ^.theme-indicator">
                                <Setter Property="Width" Value="NaN" />
                                <Setter Property="ItemsSource" Value="{m:RandomCountries Min=3, Max=5}" />
                                <Setter Property="ItemTemplate" Value="{StaticResource MyNet.DataTemplate.Country.Xs}" />

                                <Style Selector="^.flex-wrap">
                                    <Style Selector="^ ListBoxItem">
                                        <Setter Property="Width" Value="120" />
                                    </Style>
                                </Style>
                            </Style>

                            <Style Selector="^.theme-icon">
                                <Setter Property="ItemTemplate" Value="{StaticResource MyNet.DataTemplate.Icon}" />
                            </Style>
                        </Style>
                    </Panel.Styles>
                    <ListBox behavior:PlaygroundBehavior.AttachStyleProvider="{Binding}"
                             MaxHeight="300"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             SelectedIndex="0" />
                </Panel>
            </DataTemplate>
        </v:ShowcaseView.PlaygroundControlTemplate>

        <v:ShowcaseView.ThemeControlTemplate>
            <DataTemplate x:DataType="rendering:ControlStyle">
                <Panel>
                    <Panel.Styles>
                        <Style Selector="ListBox">

                            <Style Selector="^.theme-default">
                                <Setter Property="ItemTemplate" Value="{StaticResource MyNet.DataTemplate.Country.Xs}" />

                                <Style Selector="^.kind-cards">
                                    <Setter Property="ItemTemplate" Value="{StaticResource MyNet.DataTemplate.Country.Xl}" />
                                </Style>
                            </Style>

                            <Style Selector="^.theme-toggle, ^.theme-tabs, ^.theme-icon">
                                <Setter Property="ItemTemplate" Value="{StaticResource MyNet.DataTemplate.Country.Xs}" />
                            </Style>

                            <Style Selector="^.theme-icon">
                                <Setter Property="ItemTemplate" Value="{StaticResource MyNet.DataTemplate.Icon}" />
                            </Style>
                        </Style>
                    </Panel.Styles>
                    <ListBox behavior:PlaygroundBehavior.AttachStyle="{Binding}"
                             ItemsSource="{m:RandomCountries Min=5, Max=5}"
                             SelectedIndex="{m:RandomInt Min=0, Max=4}" />
                </Panel>
            </DataTemplate>
        </v:ShowcaseView.ThemeControlTemplate>

    </v:ShowcaseView>
</ContentPage>