<ContentPage x:Class="MyNet.Avalonia.Showcase.Pages.AvatarPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:my="http://mynet.com/avalonia"
             xmlns:vm="clr-namespace:MyNet.Avalonia.Showcase.ViewModels.Pages"
             xmlns:vmBase="clr-namespace:MyNet.Avalonia.Showcase.ViewModels.Playground"
             xmlns:v="clr-namespace:MyNet.Avalonia.Showcase.Views.Playground"
             xmlns:rendering="clr-namespace:MyNet.Avalonia.Showcase.ThemeBuilder.Rendering"
             xmlns:m="clr-namespace:MyNet.Avalonia.Showcase.MarkupExtensions"
             x:DataType="vm:AvatarPageViewModel"
             x:Name="Root" Theme="{StaticResource {x:Type ContentPage}}"
             Header="{my:Display Title}"
             my:IconAssist.Icon="{Binding Icon}"
             ClipToBounds="False"
             mc:Ignorable="d"
             xmlns:behavior="clr-namespace:MyNet.Avalonia.Showcase.Behaviors">

    <v:ShowcaseView ShowIcon="False">

        <v:ShowcaseView.PlaygroundControlTemplate>
            <DataTemplate x:DataType="vmBase:PlaygroundViewModel">
                <my:Avatar behavior:PlaygroundBehavior.AttachStyleProvider="{Binding}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <my:Avatar.Styles>
                        <Style Selector="my|Avatar.show-image">
                            <Setter Property="Source" Value="{m:RandomImage AllowNull=False}" />
                        </Style>
                    </my:Avatar.Styles>
                </my:Avatar>
            </DataTemplate>
        </v:ShowcaseView.PlaygroundControlTemplate>

        <v:ShowcaseView.ThemeControlTemplate>
            <DataTemplate x:DataType="rendering:ControlStyle">
                <my:Avatar behavior:PlaygroundBehavior.AttachStyle="{Binding }" Source="{m:RandomImage}" />
            </DataTemplate>
        </v:ShowcaseView.ThemeControlTemplate>

    </v:ShowcaseView>
</ContentPage>