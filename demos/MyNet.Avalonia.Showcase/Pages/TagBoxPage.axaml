<ContentPage x:Class="MyNet.Avalonia.Showcase.Pages.TagBoxPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:my="http://mynet.com/avalonia"
             xmlns:v="clr-namespace:MyNet.Avalonia.Showcase.Views.Playground"
             xmlns:vm="clr-namespace:MyNet.Avalonia.Showcase.ViewModels.Pages"
             xmlns:vmBase="clr-namespace:MyNet.Avalonia.Showcase.ViewModels.Playground"
             xmlns:rendering="clr-namespace:MyNet.Avalonia.Showcase.ThemeBuilder.Rendering"
             xmlns:behavior="clr-namespace:MyNet.Avalonia.Showcase.Behaviors"
             x:DataType="vm:TagBoxPageViewModel"
             x:Name="Root"
             Theme="{StaticResource {x:Type ContentPage}}"
             Header="{my:Display Title}"
             my:IconAssist.Icon="{Binding Icon}"
             ClipToBounds="False"
             mc:Ignorable="d">

    <v:ShowcaseView ShowContent="False" ShowIcon="False">

        <v:ShowcaseView.PlaygroundControlTemplate>
            <DataTemplate x:DataType="vmBase:PlaygroundViewModel">
                <Panel>
                    <Panel.Styles>
                        <Style Selector="my|TagBox.kind-underline">
                            <Setter Property="Theme" Value="{StaticResource MyNet.Theme.TagBox.Underline}" />
                        </Style>
                    </Panel.Styles>
                    <my:TagBox behavior:PlaygroundBehavior.AttachStyleProvider="{Binding}"
                               MaxWidth="360"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               PlaceholderText="Add tag and press Enter" />
                </Panel>
            </DataTemplate>
        </v:ShowcaseView.PlaygroundControlTemplate>

        <v:ShowcaseView.ThemeControlTemplate>
            <DataTemplate x:DataType="rendering:ControlStyle">
                <Panel>
                    <Panel.Styles>
                        <Style Selector="my|TagBox.kind-underline">
                            <Setter Property="Theme" Value="{StaticResource MyNet.Theme.TagBox.Underline}" />
                        </Style>
                    </Panel.Styles>
                    <my:TagBox behavior:PlaygroundBehavior.AttachStyle="{Binding}"
                               MaxWidth="360"
                               Tags="alpha, beta, gamma"
                               PlaceholderText="Add tag and press Enter" />
                </Panel>
            </DataTemplate>
        </v:ShowcaseView.ThemeControlTemplate>

    </v:ShowcaseView>
</ContentPage>
